rules_version = '2';

// =============================================================================
// 🔒 PRODUCTION-GRADE FIRESTORE SECURITY RULES
// =============================================================================
//
// 🎯 ΣΤΡΑΤΗΓΙΚΗ: Deny-all by default, explicit allow per collection
// 🛡️ ΑΡΧΗ: Zero Trust - καμία πρόσβαση χωρίς authentication & authorization
// ⚠️ ΚΡΙΣΙΜΟ: Αυτές οι rules προστατεύουν την εφαρμογή από unauthorized access
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🚫 DEFAULT DENY-ALL RULE
    // =========================================================================
    // Οποιαδήποτε συλλογή που ΔΕΝ έχει explicit rule → ΑΡΝΗΣΗ
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 📁 PROJECTS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 🔒 SECURITY: Tenant-scoped access via companyId field
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 🏢 ENTERPRISE: Follows /files pattern (lines 121-226)
    //
    // Security Model:
    //   - READ: Only users from the project's company (tenant-scoped)
    //   - CREATE: companyId must match user's company claim
    //   - UPDATE: Creator or company admin, companyId immutable
    //   - DELETE: Creator or company admin
    // =========================================================================
    match /projects/{projectId} {

      // 📖 READ: Tenant-scoped - only users from the project's company
      // 🔒 SECURITY: Prevents cross-tenant data leak
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all projects
                       isSuperAdminOnly()
                       // OR user belongs to the project's company
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK (TRANSITIONAL - STRICT):
                       // Projects without companyId - creator-only get access
                       // ⚠️ NOTE: Requires data migration
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: Authenticated users with companyId from claims
      // 🔐 SECURITY: companyId MUST match user's company claim (no cross-tenant creation)
      // 🏢 EXCEPTION: Super Admin can create projects for any company
      allow create: if isAuthenticated()
                    && isValidProjectData(request.resource.data)
                    && resource == null
                    && (
                         // Super Admin can create for any company
                         isSuperAdminOnly()
                         // OR user creates for their own company
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: Creator or company admin with tenant check
      // 🔐 SECURITY: companyId is immutable (no re-tenanting)
      allow update: if isAuthenticated()
                    && isValidProjectData(request.resource.data)
                    && resource != null
                    && (
                         // Creator can always update
                         resource.data.createdBy == request.auth.uid
                         // OR company admin of project's company
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super admin
                         || isSuperAdminOnly()
                       )
                    && !isAttemptingToModifySystemFields(request.resource.data, resource.data)
                    // Prevent changing companyId (no re-tenanting)
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📐 SURVEY_RECORDS COLLECTION — ADR-759 Φ2 «Στοιχεία Τοπογραφικού»
    // =========================================================================
    // 📅 Added: 2026-08-05 (ADR-759 Q1 — separate collection, not a Project subfield)
    // 🔒 Pattern: tenant-scoped via companyId, project-scoped via projectId
    //
    // WHY ITS OWN COLLECTION: a survey record is an IMMUTABLE DATED STATEMENT
    // ("surveyor X declared this on date Y"), not the project's working state. The
    // freeze below is the rule that a subfield of `projects` could not express —
    // inside the project document, "this map is frozen but the rest is editable"
    // requires a field-by-field comparison that grows with every new field and
    // breaks silently when someone forgets to extend it.
    // =========================================================================
    match /survey_records/{surveyRecordId} {

      // 📖 READ: tenant-scoped.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(resource.data.companyId)
                     );

      // ✍️ CREATE: scope keys mandatory; no cross-tenant creation.
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(
                         ['companyId', 'projectId', 'createdBy', 'createdAt']
                       )
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: two regimes, decided by `confirmedBy`.
      //   • DRAFT (confirmedBy == null) — freely editable inside the company.
      //   • CONFIRMED — the transcription is FROZEN. Only the reconciliation ledger
      //     and the confirmation flags themselves may move. To fix a typo you must
      //     explicitly un-confirm first: that leaves a visible, auditable step
      //     instead of a silent edit to a record other data was adopted from.
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       )
                    // No re-tenanting and no re-parenting to another project.
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.projectId == resource.data.projectId
                    && !isAttemptingToModifySystemFields(request.resource.data, resource.data)
                    && (
                         resource.data.confirmedBy == null
                         || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['reconciliations', 'updatedAt',
                                        'confirmedBy', 'confirmedAt'])
                       );

      // 🗑️ DELETE: company admin or super admin only. A survey record is evidence;
      // the person who typed it is not automatically the person who may destroy it.
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // 👥 CONTACT_RELATIONSHIPS COLLECTION - TENANT ISOLATION (ADR-252 FR-H3)
    // =========================================================================
    // 📅 Updated: 2026-03-20 (ADR-252 FR-H3 — tenant isolation on READ)
    // 🔒 Pattern: Tenant-scoped via companyId + createdBy ownership fallback
    // =========================================================================
    match /contact_relationships/{relationshipId} {

      // 📖 READ: Tenant-scoped
      // 🔒 SECURITY (ADR-252 FR-H3): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: Authenticated with required fields
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['sourceContactId', 'targetContactId', 'relationshipType', 'status'])
                    && request.resource.data.sourceContactId is string
                    && request.resource.data.targetContactId is string
                    && request.resource.data.relationshipType is string
                    && request.resource.data.status is string;

      // 📝 UPDATE: Creator or super admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isSuperAdminOnly()
                         || resource.data.createdBy == 'system'
                       );

      // 🗑️ DELETE: Creator or super admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isSuperAdminOnly()
                         || resource.data.createdBy == 'system'
                       );
    }

    // =========================================================================
    // 🔗 CONTACT_LINKS COLLECTION - TENANT ISOLATION (ADR-252 FR-H3)
    // =========================================================================
    // Links contacts to entities (projects, companies, units) via AssociationService
    // Used by: IKA Workers tab, contact association features
    // Fields: companyId, sourceContactId, targetEntityType, targetEntityId, status, createdBy
    // 📅 Updated: 2026-08-01 (ADR-745 G6+G7 — real tenant isolation)
    //
    // 🔒 SECURITY (ADR-745, measured 2026-08-01): this block used to ask for
    // `resource.data.companyId` — a field NOTHING wrote. The tenant lived under
    // `sourceWorkspaceId` server-side and under hardcoded literals client-side, so
    // the companyId leg was structurally unreachable and every real document fell
    // through to a `createdBy == uid` fallback. Two consequences:
    //   (a) CREATE had NO tenant gate at all — any authenticated user of any tenant
    //       could plant a link, with a forged `createdBy`, against any project. That
    //       matters more here than elsewhere because `contact_links` feeds RBAC
    //       (contact-linker.ts: project roles + linkedPropertyIds).
    //   (b) the `createdBy` fallback made a link invisible to a COLLEAGUE in the same
    //       company, and since rules are not filters, one foreign document rejects the
    //       whole list query.
    // Fixed by making `companyId` a real written field (types + converter + all three
    // writers) and gating on it here. The `createdBy` read fallback is DELETED, not
    // relaxed: the collection held 0 documents, so there was no legacy data to carry.
    // Shape mirrors `attendance_events` below, which closed the identical gap in
    // ADR-298 §8 Phase B.2.
    // =========================================================================
    match /contact_links/{linkId} {

      // 📖 READ: Tenant-scoped, no ownership fallback.
      //
      // 🔴 `resource == null` is LOad-BEARING (ADR-745 Φάση Β, 2026-08-01).
      // Without it NO contact link could ever be created — measured, not theorised:
      //   `evaluation error at L172:22 for 'get' … Null value error.`
      // `linkContactToEntity` opens with a point read of the link it is ABOUT to
      // write (deterministic id → duplicate/reactivate detection). That document
      // does not exist yet, so `resource` is null and `resource.data.companyId`
      // raises — which Firestore surfaces as permission-denied, which the
      // service's catch-all reports as `{ success: false }`. This is why the
      // collection held 0 documents: the flow was structurally impossible, and
      // 75 green rules tests never saw it because they seed documents directly
      // and then read documents that exist.
      //
      // Trade-off, stated: a point read of a NON-existent id now succeeds
      // (returning "not found"), so an authenticated caller can probe whether a
      // given id exists. Ids are `cl_{contactId}_{type}_{entityId}_{role}` over
      // nanoid-based enterprise ids, so probing requires already knowing two ids
      // from the target tenant. A denial here protects nothing — a missing
      // document carries no data — while costing the entire write path.
      //
      // Order matters twice over:
      //   - `isSuperAdminOnly()` stays the FIRST leg (ADR-195 Phase 10 shape,
      //     enforced by CHECK 3.16's rule-shape validator).
      //   - the null leg changes NOTHING for `list`: a query only evaluates this
      //     rule against documents it actually returns, so `resource` is never
      //     null there. Tenant isolation on list is untouched — pinned by the
      //     regression tests in contact-links-flow.integration.test.ts.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || resource == null
                       || belongsToCompany(resource.data.companyId)
                     );

      // ✍️ CREATE: Tenant-bound + no impersonation.
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'companyId', 'sourceContactId', 'status', 'createdBy'
                       ])
                    && request.resource.data.companyId is string
                    && request.resource.data.sourceContactId is string
                    && request.resource.data.status is string
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: Creator or super admin (e.g., status → 'inactive'), tenant-bound,
      // and `companyId` is immutable — an update must not move a link between tenants.
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              belongsToCompany(resource.data.companyId)
                              && resource.data.createdBy == request.auth.uid
                              && request.resource.data.companyId == resource.data.companyId
                            )
                       );

      // 🗑️ DELETE: Same gate as update.
      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              belongsToCompany(resource.data.companyId)
                              && resource.data.createdBy == request.auth.uid
                            )
                       );
    }

    // =========================================================================
    // 🏷️ TITLE_BLOCK_BINDINGS — per-cell provenance (ADR-745 Φ3β)
    //
    // "This cell of this drawing, approved by this human at this moment, points
    // at this entity." The title block is never a source of truth — it is a
    // source of PROPOSALS (ADR-745 §5.1), so every document here carries the
    // person who approved it. Nothing is ever written without an explicit click.
    //
    // Shape mirrors `contact_links` above, deliberately — including the two
    // legs that were paid for in blood there. One rule differs, on purpose;
    // see UPDATE.
    // =========================================================================
    match /title_block_bindings/{bindingId} {

      // 📖 READ: Tenant-scoped.
      //
      // 🔴 `resource == null` is LOAD-BEARING, for the same measured reason as
      // contact_links (ADR-745 §9.4): the write path opens with a point read of
      // the deterministic id it is ABOUT to write (idempotency + supersede
      // detection). That document does not exist yet, so `resource` is null and
      // `resource.data.companyId` raises `Null value error`, which Firestore
      // surfaces as permission-denied — and the collection would sit at 0
      // documents forever while every test stayed green, because rules suites
      // seed documents first and then read documents that exist.
      //
      // `isSuperAdminOnly()` stays the FIRST leg (ADR-195 Phase 10 shape,
      // enforced by CHECK 3.16's rule-shape validator). The null leg changes
      // nothing for `list`: a query only evaluates this rule against documents
      // it actually returns, so `resource` is never null there.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || resource == null
                       || belongsToCompany(resource.data.companyId)
                     );

      // ✍️ CREATE: Tenant-bound + no impersonation.
      //
      // `confirmedBy == request.auth.uid` is the whole point of the collection:
      // a binding that cannot name its approver is worse than no binding, since
      // it looks like evidence.
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'companyId', 'projectId', 'fileRecordId', 'levelId',
                         'fieldKey', 'slot', 'status', 'confirmedBy'
                       ])
                    && request.resource.data.companyId is string
                    && request.resource.data.projectId is string
                    && request.resource.data.fileRecordId is string
                    && request.resource.data.levelId is string
                    && request.resource.data.status is string
                    && request.resource.data.confirmedBy == request.auth.uid
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: tenant-bound, with `companyId` AND `confirmedBy` immutable.
      //
      // 🔴 DELIBERATE DIVERGENCE from contact_links, which also demands
      // `createdBy == request.auth.uid` here. A binding is COMPANY knowledge,
      // not a personal object: the only update this collection performs is
      // `status → 'superseded'`, i.e. a colleague correcting a mis-click. Under
      // the contact_links rule that correction would be denied, and the false
      // binding would stay active forever — which is the exact multi-user
      // failure ADR-745 §9.1 removed from the READ leg for the same reason.
      // That restriction is a DOCUMENTED WEAKNESS there, not a pattern to copy.
      //
      // What replaces it is stronger where it matters: `confirmedBy` is
      // immutable, so nobody can rewrite history to claim someone else approved
      // a binding — the attack the creator-check was actually guarding against.
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              belongsToCompany(resource.data.companyId)
                              && request.resource.data.companyId == resource.data.companyId
                              && request.resource.data.confirmedBy == resource.data.confirmedBy
                            )
                       );

      // 🗑️ DELETE: super admin only.
      //
      // Provenance is not housekeeping. A wrong approval is superseded, never
      // erased — otherwise the database can no longer explain why it once said
      // something else (same principle as `withdrawn` in ADR-745 Φ3α).
      allow delete: if isAuthenticated() && isSuperAdminOnly();
    }

    // =========================================================================
    // 📋 ATTENDANCE_EVENTS COLLECTION - IMMUTABLE AUDIT TRAIL (ADR-090 Phase 2)
    // =========================================================================
    // Append-only attendance events: check_in, check_out, break_start, break_end,
    // left_site, returned, exit_permission.
    // IMMUTABLE: Once created, events CANNOT be updated or deleted.
    // Legal compliance: Proof of worker presence for ΣΕΠΕ inspections & accidents.
    // =========================================================================
    match /attendance_events/{eventId} {

      // 📖 READ: Tenant-scoped via projectId
      // 🔒 SECURITY (ADR-252 FR-H3): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );

      // ✍️ CREATE: Authenticated + tenant-bound + cross-doc project ownership
      // 🔒 SECURITY (ADR-298 §8 Phase B.2, 2026-04-11): Was shape/enum validation
      // only — no tenant check. Latent gap: cross_tenant_admin could plant events
      // under any company. Fix = defense-in-depth: (a) require `companyId` in
      // payload, (b) payload companyId must match user's claim (super_admin
      // short-circuit via `isSuperAdminOnly()`), (c) cross-doc verify that the
      // referenced project actually belongs to the caller's tenant via
      // `belongsToProjectCompany()` — mirrors the read gate's second OR leg.
      // Production path (src/services/attendance/attendance-server-service.ts:317)
      // uses Admin SDK, which bypasses rules — this tightening affects only the
      // client surface (never exercised in production today, tightened defensively).
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'companyId', 'projectId', 'contactId', 'eventType', 'method',
                         'timestamp', 'recordedBy', 'createdAt'
                       ])
                    && request.resource.data.companyId is string
                    && request.resource.data.projectId is string
                    && request.resource.data.contactId is string
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       )
                    && belongsToProjectCompany(request.resource.data.projectId)
                    && request.resource.data.eventType in [
                         'check_in', 'check_out', 'break_start', 'break_end',
                         'left_site', 'returned', 'exit_permission'
                       ]
                    && request.resource.data.method in ['manual', 'qr', 'geofence', 'nfc']
                    && request.resource.data.recordedBy is string;

      // 🚫 UPDATE: FORBIDDEN — immutable events
      allow update: if false;

      // 🚫 DELETE: FORBIDDEN — immutable events
      allow delete: if false;
    }

    // =========================================================================
    // 🔑 ATTENDANCE_QR_TOKENS COLLECTION — Daily QR tokens (ADR-170)
    // =========================================================================
    // QR tokens for worker attendance check-in.
    // Generated by admin, consumed by workers scanning QR at site entrance.
    // Server-managed lifecycle: active → expired/revoked.
    // =========================================================================
    match /attendance_qr_tokens/{tokenId} {

      // 📖 READ: Tenant-scoped via projectId or companyId
      // 🔒 SECURITY (ADR-252 FR-H3): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );

      // 🚫 CREATE/UPDATE/DELETE: Server-only via Admin SDK
      // Tokens are managed exclusively by the server (API routes)
      // to ensure HMAC integrity and prevent client-side manipulation.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 💰 EMPLOYMENT_RECORDS COLLECTION — Monthly employment records (Phase 3)
    // =========================================================================
    // Monthly employment records per worker per project.
    // Contains stamps count, insurance class, and contribution calculations.
    // Used by: StampsCalculationTabContent, ApdPaymentsTabContent
    // =========================================================================
    match /employment_records/{recordId} {

      // 📖 READ: Tenant-scoped via projectId
      // 🔒 SECURITY (ADR-252 FR-H3): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );

      // ✍️ CREATE: Authenticated user with required fields
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'projectId', 'contactId', 'month', 'year',
                         'totalDaysWorked', 'insuranceClassNumber', 'stampsCount',
                         'employerContribution', 'employeeContribution', 'totalContribution',
                         'apdStatus', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.projectId is string
                    && request.resource.data.contactId is string
                    && request.resource.data.month is number
                    && request.resource.data.year is number
                    && request.resource.data.apdStatus in [
                         'pending', 'submitted', 'accepted', 'rejected', 'corrected'
                       ];

      // ✏️ UPDATE: Authenticated user (for APD status changes, corrections)
      allow update: if isAuthenticated()
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.contactId == resource.data.contactId;

      // 🚫 DELETE: FORBIDDEN — employment records are legal documents
      allow delete: if false;
    }

    // =========================================================================
    // 🎨 CAD_FILES COLLECTION - ENTERPRISE TENANT ISOLATION (ADR-252 FR-C1)
    // =========================================================================
    // Internal storage for DXF scene metadata (actual scene data in Firebase Storage)
    // Used by: DxfFirestoreService, BuildingFloorplanService, FloorFloorplanService
    // 📅 Updated: 2026-03-20 (ADR-252 Security Fixes — tenant isolation)
    // =========================================================================
    match /cad_files/{fileId} {

      // 📖 READ: Tenant-scoped via companyId or creator fallback
      // 🔒 SECURITY (ADR-252 FR-C1): Was `auth != null` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: cad_files without companyId — creator only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE/UPDATE: Authenticated users with basic validation + companyId
      allow create, update: if isAuthenticated()
                            && request.resource.data.keys().hasAll(['fileName'])
                            && request.resource.data.fileName is string
                            && request.resource.data.fileName.size() > 0;

      // 🗑️ DELETE: Tenant-scoped (creator or super admin)
      // 🔒 SECURITY (ADR-252 FR-C1): Was `auth != null` → now restricted
      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                         || (!resource.data.keys().hasAny(['companyId'])
                             && resource.data.keys().hasAny(['createdBy'])
                             && resource.data.createdBy == request.auth.uid)
                       );
    }

    // =========================================================================
    // 📁 FILES COLLECTION - ENTERPRISE CANONICAL FILE STORAGE (ADR-031)
    // =========================================================================
    // This collection stores FileRecord metadata (Source of Truth for file uploads)
    // Binary files are stored in Firebase Storage, metadata in Firestore
    //
    // Flow:
    // 1. CREATE: Client creates pending record (status: pending)
    // 2. Storage Upload: Binary uploaded to canonical path (Storage rules verify FileRecord)
    // 3. UPDATE: Client finalizes record (status: ready)
    // =========================================================================
    match /files/{fileId} {

      // =======================================================================
      // 🔒 ADR-862 Φ0 (Β4) — Η ΚΑΤΑΣΤΑΣΗ CDE ΔΕΝ ΓΡΑΦΕΤΑΙ ΑΠΟ ΠΕΛΑΤΗ
      // =======================================================================
      // Το `cdeState` και τα ίχνη των τεσσάρων πράξεων που το γεννούν είναι
      // **έξοδος του διακομιστή** (AIP-216 output-only): αλλάζουν ΜΟΝΟ μέσα από
      // τις ονομασμένες πράξεις (`services/iso19650/container-transitions.ts`,
      // Admin SDK — Β6), ποτέ από client SDK. Πριν τη Φ0 το πεδίο ήταν ελεύθερο
      // dropdown· δηλαδή ο φρουρός άνοιγε με ΕΝΑ κλικ.
      //
      // 🔴 ΔΙΟΡΘΩΣΗ 2026-09-17 (Β10): εδώ έγραφε «ο μόνος εναπομείνας γραφέας είναι ο
      //    `supersedeFileRecord` (Admin SDK) — το πάγωμα δεν σπάει τίποτα». ΔΙΠΛΟ ΛΑΘΟΣ,
      //    ΜΕΤΡΗΜΕΝΟ ΣΤΟΝ EMULATOR: ήταν **client SDK**, άρα το πάγωμα **έσπασε** κάθε
      //    αντικατάσταση αρχείου (ολόκληρη η εγγραφή απορριπτόταν, και οι 3 καλούντες
      //    κατάπιναν την άρνηση). Θεραπεία ADR-862 Φ0 Β10: η αντικατάσταση είναι πλέον η
      //    5η πράξη (`supersede`) του ΕΝΟΣ γραφέα — και η **απόδειξη διαδοχής**
      //    (`cdeSupersession` · `supersededByFileId` · `supersededAt`) μπήκε στη λίστα,
      //    γιατί ένας πελάτης που τη γράφει θα ισχυριζόταν διαδοχή που κανείς δεν έκρινε.
      //
      // 🔑 ΓΙΑΤΙ `diff().affectedKeys()` ΚΑΙ ΟΧΙ ΣΥΓΚΡΙΣΗ ΤΙΜΩΝ: η ερώτηση είναι
      //    «άγγιξε κανείς αυτά τα κλειδιά;», και το `affectedKeys()` την απαντά
      //    ομοιόμορφα για τις ΤΡΕΙΣ γραφές — προσθήκη σε απόν πεδίο, αλλαγή τιμής,
      //    ΚΑΙ αφαίρεση. Μια σύγκριση `get(k,null) == get(k,null)` πιάνει την
      //    αφαίρεση μόνο κατά σύμπτωση, και χρειάζεται έξι γραμμές ανά leg (×4).
      //    Ίδιο ιδίωμα με το `isAllowedPropertyFieldUpdate()` (ίδιο αρχείο).
      //
      // ⛔ ΜΗΝ προσθέσεις δεύτερο `match /files/{fileId}` για να «σφίξεις»: στο
      //    Firestore το `allow` είναι η ΕΝΩΣΗ των μπλοκ που ταιριάζουν, άρα ο
      //    ΧΑΛΑΡΟΤΕΡΟΣ νικά και η αυστηροποίηση δεν ισχύει ΠΟΤΕ (CHECK 3.16
      //    Validation F, μετρητής 0 — ADR-841 §7 Α21.14.8).
      //
      // 🔒 ADR-862 Φ0 Β11: και ο ΦΡΑΧΤΗΣ ΑΝΑΓΝΩΣΗΣ (`cdeReadReach`) είναι έξοδος του
      //    διακομιστή — πελάτης που τον γράφει θα άνοιγε ο ίδιος το WIP του σε όλο το
      //    γραφείο (ή θα έκρυβε εγκεκριμένο σχέδιο από τις λίστες).
      //
      // 🔑 ADR-866 §5.2: η φρουρά `cdeCustodyUnchanged()` ζει πλέον στις ΚΑΘΟΛΙΚΕΣ συναρτήσεις
      //    (κάτω από το `isOwner`), γιατί την καλεί ΚΑΙ το `match /files_personal` — μία λίστα
      //    πεδίων, όχι αντίγραφο που θα απέκλινε.
      //
      // @see ADR-862 Φ0 · ADR-787 Κ-4 · ADR-373

      // =======================================================================
      // 📖 READ — ADR-862 Φ0 Β11: Η ΑΝΑΓΝΩΣΗ ΑΚΟΛΟΥΘΕΙ ΤΗΝ ΚΑΤΑΣΤΑΣΗ
      // =======================================================================
      // 🔑 ΓΙΑΤΙ `get` ΚΑΙ `list` ΧΩΡΙΣΤΑ (μετρημένο 2026-09-17): το Firestore κρίνει
      //    το `list` από τα ΦΙΛΤΡΑ του ερωτήματος, όχι από τα δεδομένα («rules are not
      //    filters — queries are all or nothing»). Ένας ενιαίος `read` που διαβάζει
      //    κατάσταση θα έριχνε ΚΑΘΕ λίστα αρχείων. Το `get` κρίνεται στο πραγματικό
      //    έγγραφο ⇒ μπορεί να δεχτεί και τον δημιουργό του WIP.
      //
      // 🔑 ΓΙΑΤΙ `cdeReadReach` ΚΑΙ ΟΧΙ `cdeState`: το ερώτημα πρέπει να μπορεί να
      //    δηλώσει την τιμή σε ΚΑΘΕ έγγραφο, και `in`/`not-in` αποκλείουν έγγραφα χωρίς
      //    το πεδίο (35 ζωντανά, 2 με `cdeState`). Η εμβέλεια είναι προβολή της φάσης
      //    (`lib/auth/container-read-reach.ts`), τη γράφουν ΜΟΝΟ η γέννηση και ο γραφέας,
      //    και ο θεματοφύλακας την ξαναπαράγει και συγκρίνει.
      //
      // ⚠️ Ο κανόνας είναι ΕΞΩΤΕΡΙΚΟΣ ΦΡΑΧΤΗΣ, όχι η απόφαση: την ΟΜΑΔΑ του WIP δεν
      //    μπορεί να την ξέρει (δεν μπαίνει σε claim — `container-subject.ts`) ⇒ τα WIP
      //    ομάδας τα σερβίρει η διαδρομή διακομιστή, όπου κρίνει ο `decideContainerAccess`.
      //
      // ℹ️ Διορθώθηκε 2026-09-17: εδώ έγραφε ότι το read «επιτρέπει στους Storage Rules
      //    να επικυρώνουν uploads μέσω firestore.get()». Το `storage.rules` δεν κάνει πια
      //    κανένα `firestore.get()` (αφαιρέθηκαν 2026-07-26).
      allow get: if isAuthenticated()
                 && (
                      isSuperAdminOnly()
                      || (
                           resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId)
                           // Απών φράχτης = πριν τη μετανάστευση του Β11 ⇒ «όπως σήμερα».
                           && (
                                resource.data.get('cdeReadReach', 'tenant') == 'tenant'
                                || resource.data.get('createdBy', null) == request.auth.uid
                              )
                         )
                    );

      // Η λίστα ΠΡΕΠΕΙ να δηλώνει ΕΝΑ από τα δύο — τα παράγει ΕΝΑΣ παραγωγός
      // (`lib/files/file-visibility-scope.ts`) και το CHECK του Β12 μπλοκάρει client
      // λίστα `files` που τον παρακάμπτει:
      //   • `where('cdeReadReach', '==', 'tenant')`  — ό,τι βλέπει όλο το γραφείο
      //   • `where('createdBy', '==', <uid>)`        — τα ΔΙΚΑ μου, μαζί με το WIP μου
      //     (αλλιώς το auto-save του DXF δεν θα έβρισκε το WIP του ⇒ διπλό αρχείο)
      allow list: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (
                            resource.data.keys().hasAny(['companyId'])
                            && belongsToCompany(resource.data.companyId)
                            && (
                                 resource.data.cdeReadReach == 'tenant'
                                 || resource.data.createdBy == request.auth.uid
                               )
                          )
                     );

      // ✍️ CREATE: Users can create pending FileRecord for their company
      // 🔐 SECURITY: createdBy must match request.auth.uid
      // 🔐 SECURITY: companyId must match user's company claim (OR super_admin)
      // 🔐 SECURITY: status must be 'pending' (no direct 'ready' creation)
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                         request.resource.data.companyId == getUserCompanyId()
                         // super_admin can create files for any company (cross-tenant admin)
                         || isSuperAdminOnly()
                       )
                    && request.resource.data.status == 'pending'
                    // 🔒 ADR-862 Φ0 — η γέννηση είναι ΠΑΝΤΑ WIP (ή αδήλωτη).
                    // Η προεπιλογή του `get()` κάνει το «απόν» αληθές ΧΩΡΙΣ `||`:
                    // απουσία σημαίνει `pre-cde` («όπως σήμερα»), και ΔΕΝ
                    // επιτρέπεται να γίνει σημαία δημοσίευσης.
                    // ⚠️ Σκέτο `== 'WIP'` θα γύριζε σε deny τα ΔΥΟ `create/allow`
                    //    κελιά της μήτρας — το `createData` δεν στέλνει `cdeState`.
                    && request.resource.data.get('cdeState', 'WIP') == 'WIP'
                    // Καμία από τις τέσσερις πράξεις στη γέννηση: σφραγίδα «από
                    // κούνια» θα παρέκαμπτε και τα δύο σκαλοπάτια του PUBLISHED.
                    // ℹ️ Το `cdeTeamId` ΕΠΙΤΡΕΠΕΤΑΙ εδώ: είναι υπόδειξη του πελάτη,
                    //    και η αυθεντία είναι η αναζήτηση μέλους στον διακομιστή
                    //    (ADR-862 Β7). Από τη γέννηση και μετά παγώνει κι αυτό.
                    && !request.resource.data.keys().hasAny(
                         ['cdeShare', 'cdeSeal', 'cdeRelease', 'cdeWithdrawal'])
                    // 🔒 ADR-862 Φ0 Β11 — ο φράχτης της γέννησης ΣΥΜΦΩΝΕΙ με τη φάση
                    // (`READ_REACH_BY_PHASE`): `pre-cde` ⇒ `tenant` (`BIRTH_READ_REACH`,
                    // ό,τι γράφει ο builder)· δηλωμένο `WIP` ⇒ `author`. Απών ⇒ ο builder
                    // δεν έτρεξε ⇒ αρχείο αόρατο σε κάθε λίστα. Ασυμφωνία ⇒ ο θεματοφύλακας
                    // θα το έκανε `unreadable` ⇒ αρνούμαστε ΕΔΩ, όχι αργότερα.
                    && request.resource.data.get('cdeReadReach', null)
                         == (request.resource.data.keys().hasAny(['cdeState']) ? 'author' : 'tenant')
                    // 🔒 ADR-864 §21 — καμία δέσμευση «από κούνια» (ο builder δεν γράφει καμία).
                    && holdBornAbsent()
                    && resource == null; // Ensure document doesn't exist

      // 📝 UPDATE: Only creator or company admin can finalize
      // 🔐 SECURITY: Limited to specific fields for finalization
      // 🔐 SECURITY: Can only transition pending → ready (or → failed)
      allow update: if isAuthenticated()
                    && (
                         resource.data.companyId == getUserCompanyId()
                         // super_admin can finalize files for any company
                         || isSuperAdminOnly()
                       )
                    && (
                         // Creator can finalize
                         resource.data.createdBy == request.auth.uid
                         // OR company admin can finalize
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super_admin can finalize
                         || isSuperAdminOnly()
                       )
                    // Status transitions: pending → ready OR pending → failed
                    && (
                         (resource.data.status == 'pending' && request.resource.data.status == 'ready')
                         || (resource.data.status == 'pending' && request.resource.data.status == 'failed')
                       )
                    // Prevent modification of immutable fields
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.storagePath == resource.data.storagePath
                    // 🔒 ADR-862 Φ0 — η οριστικοποίηση (pending → ready) δεν αγγίζει CDE.
                    && cdeCustodyUnchanged()
                    // 🔒 ADR-864 §21 — ούτε δέσμευση.
                    && holdCustodyUnchanged();

      // 🗑️ MOVE TO TRASH: Creator or company admin can trash ready files
      // 🏢 ENTERPRISE: Ownership Principle (SAP/Salesforce/Google Drive pattern)
      //    - Creator can ALWAYS manage their own files (no claims required)
      //    - Admins need proper company claims for cross-user operations
      // 🔐 SECURITY: Only allows setting isDeleted flag, preserves all other immutable fields
      allow update: if isAuthenticated()
                    && (
                         // OWNERSHIP PRINCIPLE: Creator can ALWAYS trash their own files
                         resource.data.createdBy == request.auth.uid
                         // OR company admin can trash any file in their company (requires claims)
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super_admin can trash anything
                         || isSuperAdminOnly()
                       )
                    // Only for ready files (soft delete)
                    && resource.data.status == 'ready'
                    // Must be setting isDeleted to true
                    && request.resource.data.isDeleted == true
                    // Preserve immutable fields
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.storagePath == resource.data.storagePath
                    && request.resource.data.status == resource.data.status
                    // 🔒 ADR-862 Φ0 — ούτε η μετακίνηση στον κάδο. Η ΑΠΟΣΥΡΣΗ είναι
                    // άλλη πράξη (⇒ SUPERSEDED, ποτέ εξαφάνιση) και περνά από τον
                    // ΕΝΑ γραφέα του Β10 — ποτέ από εδώ.
                    && cdeCustodyUnchanged()
                    // 🔒 ADR-864 §21 Δ21.1 — ΣΙΩΠΗΛΗ ΔΕΣΜΕΥΣΗ: ο κάδος ΕΠΙΤΡΕΠΕΤΑΙ σε δεσμευμένο
                    //    αρχείο (Google Vault · Box · Purview)· αυτό που δεν επιτρέπεται είναι να
                    //    ΑΓΓΙΞΕΙ τη δέσμευση. ⛔ ΜΗΝ προσθέσεις «hold == 'none'» εδώ — απορρίφθηκε.
                    && holdCustodyUnchanged();

      // ♻️ RESTORE FROM TRASH: Creator or company admin can restore trashed files
      // 🏢 ENTERPRISE: Ownership Principle (SAP/Salesforce/Google Drive pattern)
      //    - Creator can ALWAYS restore their own files (no claims required)
      //    - Admins need proper company claims for cross-user operations
      // 📅 Added: 2026-01-20 (ADR-032 - Enterprise Trash System)
      allow update: if isAuthenticated()
                    && (
                         // OWNERSHIP PRINCIPLE: Creator can ALWAYS restore their own files
                         resource.data.createdBy == request.auth.uid
                         // OR company admin can restore any file in their company (requires claims)
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super_admin can restore anything
                         || isSuperAdminOnly()
                       )
                    // Only for trashed files (isDeleted == true)
                    && resource.data.isDeleted == true
                    // Must be setting isDeleted to false (restoring)
                    && request.resource.data.isDeleted == false
                    // Preserve immutable fields
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.storagePath == resource.data.storagePath
                    && request.resource.data.status == resource.data.status
                    // 🔒 ADR-862 Φ0 — ούτε η επαναφορά από τον κάδο: ένα αρχείο δεν
                    // «ξαναγεννιέται» σε άλλη κατάσταση από αυτή που είχε.
                    && cdeCustodyUnchanged()
                    // 🔒 ADR-864 §21 — η επαναφορά δεν «καθαρίζει» τη δέσμευση.
                    && holdCustodyUnchanged();

      // 🔗 LINK/UNLINK: Company members can update linkedTo on ready files
      // 🏢 ENTERPRISE: Entity linking — one file in storage, multiple display points
      // Only allows modifying linkedTo field (and updatedAt), preserves all immutable fields
      allow update: if isAuthenticated()
                    && (
                         resource.data.companyId == getUserCompanyId()
                         || isSuperAdminOnly()
                       )
                    // Only for ready, non-deleted files
                    && resource.data.status == 'ready'
                    && resource.data.isDeleted != true
                    // Preserve immutable fields
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.storagePath == resource.data.storagePath
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.isDeleted == resource.data.isDeleted
                    // 🔒 ADR-862 Φ0 — ούτε η σύνδεση/αποσύνδεση οντοτήτων.
                    // 🔴 ΕΔΩ ΑΚΡΙΒΩΣ ζούσε το ελεύθερο dropdown μέχρι το Β3: το
                    //    `updateIso19650Metadata` (`services/file-record-links.ts`)
                    //    έγραφε `cdeState` μέσα από ΑΥΤΟ το leg. Ο μεταγλωττιστής
                    //    έκλεισε την πόρτα στον πελάτη· αυτή η γραμμή την κλειδώνει.
                    && cdeCustodyUnchanged()
                    // 🔒 ADR-864 §21 — ούτε η δέσμευση (ήταν το σκέλος με το χαλαρότερο πρόσωπο:
                    //    κάθε μέλος της εταιρείας, όχι μόνο δημιουργός/διαχειριστής).
                    && holdCustodyUnchanged();

      // 🗑️ HARD DELETE: Only creator or company admin
      // 🔒 ADR-864 §21 Δ21.1 — ΠΟΤΕ σε δεσμευμένο ή υπό διατήρηση αρχείο. Ο κάδος (update)
      //    μένει ανοιχτός· η ΟΡΙΣΤΙΚΗ διαγραφή είναι αυτό που η δέσμευση απαγορεύει.
      allow delete: if isAuthenticated()
                    && resource.data.companyId == getUserCompanyId()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       )
                    && holdAllowsHardDelete();
    }

    // =========================================================================
    // 🗂️ FILES_PERSONAL — ΤΑ ΑΡΧΕΙΑ ΠΟΥ ΑΝΗΚΟΥΝ ΣΕ ΑΝΘΡΩΠΟ (ADR-866 §5.2)
    // =========================================================================
    // 📅 Added: 2026-09-17 (ADR-866 Φ0 βήμα 2β)
    // 🏢 ΤΟ ΙΔΙΟ σύστημα αρχείων (ίδιο `FileRecord`, ίδιος builder, ίδιες υπηρεσίες) σε ΞΕΧΩΡΙΣΤΟ
    //    διαμέρισμα, με κάτοχο `userId` αντί `companyId` (`lib/workspace/custody-scope.ts`).
    // 🔑 ΓΙΑΤΙ ΔΙΑΜΕΡΙΣΜΑ ΚΑΙ ΟΧΙ ΚΛΑΔΟΣ ΣΤΟ `match /files`: οι κανόνες ΔΕΝ φιλτράρουν — ένα
    //    «όχι τα προσωπικά» θα απέρριπτε ΟΛΟΚΛΗΡΟ το αφιλτράριστο ερώτημα του super admin, και το
    //    `allow` είναι ένωση, άρα κλάδος εκεί θα χαλάρωνε τον εταιρικό κανόνα. Εκείνος μένει ΑΝΕΓΓΙΧΤΟΣ.
    // 🔒 READ: ΜΟΝΟ ο κάτοχος. ΟΥΤΕ admin εταιρείας ΟΥΤΕ super admin — Google Drive «Ο Δίσκος
    //    μου» · Figma Drafts (ADR-866 §2.6.6). Ίδιο δόγμα με το `entity_audit_trail_personal`.
    //    ΕΝΑΣ δρόμος λίστας: `where('userId','==',uid)`, τον βάζει το `tenant-config`
    //    (`FILES_PERSONAL: mode 'userId'`) — κανένας φράχτης `cdeReadReach` (έννοια γραφείου).
    // 🔒 CDE: τα προσωπικά αρχεία έχουν ΕΚΔΟΣΕΙΣ αλλά ΟΧΙ φάσεις ISO 19650 (Ε-Φ0-1). Γεννιούνται
    //    ΧΩΡΙΣ κανένα πεδίο θεματοφυλακής, και ο πελάτης δεν τα αγγίζει ποτέ (`cdeCustodyUnchanged`)·
    //    η διαδοχή εκδόσεων γράφεται ΜΟΝΟ από τον ΕΝΑ γραφέα (Admin SDK).
    match /files_personal/{fileId} {
      allow get, list: if isAuthenticated()
                       && resource.data.userId == request.auth.uid;

      // ✍️ CREATE — εκκρεμής εγγραφή του ΙΔΙΟΥ του κατόχου, χωρίς ίχνος εταιρείας ή CDE.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && !request.resource.data.keys().hasAny(['companyId'])
                    && !request.resource.data.keys().hasAny(cdeCustodyKeys())
                    // 🔒 ADR-864 §21 — ίδια λίστα δέσμευσης με το `match /files` (ADR-866 §5.2).
                    && holdBornAbsent()
                    && request.resource.data.status == 'pending'
                    && resource == null;

      // 📝 UPDATE — ο κάτοχος: οριστικοποίηση (pending → ready|failed) ή αλλαγές σε έτοιμο αρχείο
      //    (κάδος · επαναφορά · σύνδεση · μετονομασία). Ίδια σκέλη με το `match /files`, χωρίς
      //    διαχειριστή: εδώ δεν υπάρχει οργανισμός να διαχειριστεί.
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.storagePath == resource.data.storagePath
                    && !request.resource.data.keys().hasAny(['companyId'])
                    && (
                         (resource.data.status == 'pending'
                           && request.resource.data.status in ['ready', 'failed'])
                         || (resource.data.status == 'ready'
                           && request.resource.data.status == 'ready')
                       )
                    && cdeCustodyUnchanged()
                    // 🔒 ADR-864 §21 — ο κάτοχος δεν αυτο-δεσμεύει ούτε αποδεσμεύει (`retentionUntil`
                    //    θα έβγαζε το αρχείο από κάθε καθαρισμό· `hold` θα ακύρωνε δέσμευση διακομιστή).
                    && holdCustodyUnchanged()
                    // 📒 ADR-866 §2.6.11 — κάδος · επαναφορά · μετονομασία ΜΟΝΟ μαζί με τη γραμμή τους.
                    && personalActivityPaired();

      // 🗑️ HARD DELETE — μόνο ο κάτοχος, και ΠΟΤΕ σε δεσμευμένο (ADR-864 §21 Δ21.1).
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && holdAllowsHardDelete();
    }

    // =========================================================================
    // 🏢 COMPANIES COLLECTION - TENANT-SCOPED READ (ADR-252 FR-C3)
    // =========================================================================
    // 📅 Updated: 2026-03-20 (ADR-252 FR-C3 — own company only)
    // 🔒 SECURITY: Users can only read their OWN company document
    match /companies/{companyId} {

      // 📖 READ: Own company only (token.companyId must match document ID)
      // 🔒 SECURITY (ADR-252 FR-C3): Was `auth != null` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || getUserCompanyId() == companyId
                     );

      // ✍️ CREATE/UPDATE/DELETE: ΌΧΙ από client - μόνο admin/server
      // ADR-326: settings.orgStructure managed via PUT /api/org-structure (Admin SDK, company_admin only)
      allow write: if false;

      // =========================================================================
      // 🎫 WORKSPACE_MEMBERS SUBCOLLECTION — «ποιος είναι μέλος αυτού του χώρου»
      // =========================================================================
      // 📘 ADR-787 Κ-2 / §5.1 · 📅 2026-08-22
      //
      // Το ΜΟΝΟ έγγραφο που απαντά «είναι ο Χ μέλος του χώρου Ω;».
      // Κλειδί εγγράφου = το uid — κάνει τη διπλή συμμετοχή **δομικά αδύνατη**.
      //
      // ✍️ WRITE: `false`. Η συμμετοχή δίνεται και αφαιρείται ΜΟΝΟ από τον
      //    διακομιστή (Admin SDK), όπως ήδη ισχύει για το ίδιο το `companies`.
      //    ⛔ ΜΗΝ ανοίξεις γραφή από τον πελάτη: όποιος μπορεί να γράψει εδώ,
      //    αυτοπροσκαλείται σε ξένο γραφείο.
      //
      // 📖 READ: ο ίδιος ο άνθρωπος (βλέπει τη ΔΙΚΗ του συμμετοχή) ή ο
      //    διαχειριστής του χώρου (διαχειρίζεται τα μέλη του) ή super admin.
      //    ⚠️ `belongsToCompany()` ΔΕΝ αρκεί μόνο του: ένας καλεσμένος από
      //    ΑΛΛΟ γραφείο έχει άλλο companyId στο token του, και πρέπει να
      //    μπορεί να δει τη δική του εγγραφή — γι' αυτό υπάρχει το uid σκέλος.
      //
      // ⚠️ ΔΕΝ δηλώνεται κανόνας collection-group (`/{path=**}/workspace_members`)
      //    ΕΠΙΤΗΔΕΣ: το «σε ποιους χώρους ανήκω;» απαντιέται ΜΟΝΟ στον
      //    διακομιστή (`lib/auth/workspace-membership.ts`), όπου το Admin SDK
      //    δεν περνά από κανόνες. Ένας τέτοιος κανόνας θα άνοιγε στον πελάτη
      //    σάρωση ΟΛΩΝ των γραφείων — απαρίθμηση που το ADR-787 Ε-5 §4 #1
      //    απαγορεύει ρητά.
      match /workspace_members/{memberUid} {
        allow read: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || request.auth.uid == memberUid
                         || isCompanyAdminOfCompany(companyId)
                       );

        allow write: if false;
      }

      // =========================================================================
      // 👥 PROJECT MEMBERS — η ομάδα του έργου (ADR-862 Φ0 Β14 · ADR-787 §5.1)
      // =========================================================================
      // `companies/{W}/projects/{P}/members/{mbr_…}` — ΜΟΝΟ διακομιστής.
      //
      // 🔴 ΡΗΤΟ `false` ΚΑΙ ΟΧΙ ΣΙΩΠΗΡΟ DEFAULT-DENY: μέχρι το Β14 δεν υπήρχε
      //    κανένα μπλοκ, και η άρνηση ερχόταν από το καθολικό catch-all — σωστό
      //    σήμερα, εύθραυστο αύριο: ένα μελλοντικό `match /{document=**}` μέσα στο
      //    `companies/{companyId}` θα το άνοιγε σιωπηλά. Το έγγραφο αποφασίζει
      //    ΠΟΙΟΣ ΒΛΕΠΕΙ αρχεία CDE (`decideContainerAccess`, βήμα 4): εγγραφή από
      //    πελάτη = αυτο-ένταξη σε ξένη υπόθεση, ανάγνωση = απαρίθμηση ομάδας.
      //    Ο ΕΝΑΣ γραφέας: `lib/auth/project-member-write.ts` (Admin SDK, CHECK 3.88).
      match /projects/{projectId}/members/{memberId} {
        allow read, write: if false;
      }

      // =========================================================================
      // 📋 AUDIT_LOGS SUBCOLLECTION - COMPANY-SCOPED AUDIT TRAIL
      // =========================================================================
      // 🏢 ENTERPRISE: Audit logs for company operations (ADR-029 Global Search)
      // 📅 Added: 2026-01-26
      // 🔒 SECURITY: Only users from the same company can read/write audit logs
      match /audit_logs/{logId} {
        // 📖 READ: Company members and super_admin
        allow read: if isAuthenticated()
                    && (belongsToCompany(companyId) || isSuperAdminOnly());

        // ✍️ CREATE: Company members can create audit entries
        // 🔐 SECURITY: Used by API routes for audit logging
        allow create: if isAuthenticated()
                      && belongsToCompany(companyId);

        // 📝 UPDATE/DELETE: Not allowed - audit logs are immutable
        allow update, delete: if false;
      }

      // =========================================================================
      // 🪜 STAIR_PRESETS SUBCOLLECTION — ADR-358 Phase 7.5 (G26, Q32)
      // =========================================================================
      // 📅 Added: 2026-05-17
      // 🏢 ENTERPRISE: 3-scope stair library presets (user / company / project).
      // 🔒 SECURITY: Tenant isolation via companyId === parent path segment.
      //              Scope discrimination by `scope` field on the document.
      // 📘 ADR-358 §5.3 #7, §6.6, §9.2 Q32
      match /stair_presets/{presetId} {

        // 📖 READ — Tenant-scoped + scope filter
        // user scope: only owner reads.
        // company scope: any tenant member reads.
        // project scope: any tenant member reads (project isolation handled by service-layer query).
        allow read: if isAuthenticated()
                    && belongsToCompany(companyId)
                    && (
                         resource.data.scope == 'company'
                         || resource.data.scope == 'project'
                         || (resource.data.scope == 'user'
                             && resource.data.ownerId == request.auth.uid)
                       );

        // ✍️ CREATE — Tenant member + companyId == path + ownerId == self + valid scope
        allow create: if isAuthenticated()
                      && resource == null
                      && belongsToCompany(companyId)
                      && request.resource.data.companyId == companyId
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.scope in ['user', 'company', 'project']
                      && (request.resource.data.scope != 'project'
                          || request.resource.data.keys().hasAny(['projectId']));

        // 📝 UPDATE — Owner only (immutable companyId/scope/ownerId)
        allow update: if isAuthenticated()
                      && belongsToCompany(companyId)
                      && resource.data.ownerId == request.auth.uid
                      && request.resource.data.companyId == resource.data.companyId
                      && request.resource.data.scope == resource.data.scope
                      && request.resource.data.ownerId == resource.data.ownerId;

        // 🗑️ DELETE — Owner or company_admin (per scope)
        // user scope: owner only.
        // company / project scope: owner or company_admin.
        allow delete: if isAuthenticated()
                      && belongsToCompany(companyId)
                      && (
                           resource.data.ownerId == request.auth.uid
                           || (resource.data.scope in ['company', 'project']
                               && isCompanyAdminOfCompany(companyId))
                         );
      }

      // =========================================================================
      // 🏗️ BIM_FAMILY_TYPES SUBCOLLECTION — ADR-412
      // =========================================================================
      // 📅 Added: 2026-06-03
      // 🏢 ENTERPRISE: 3-scope BIM family type library (user / company / project).
      // 🔒 SECURITY: Tenant isolation via companyId === parent path segment.
      //              Scope discrimination by `scope` field on the document.
      // 📘 ADR-412
      match /bim_family_types/{typeId} {

        // 📖 READ — Tenant-scoped + scope filter
        // user scope: only owner reads.
        // company scope: any tenant member reads.
        // project scope: any tenant member reads (project isolation handled by service-layer query).
        allow read: if isAuthenticated()
                    && belongsToCompany(companyId)
                    && (
                         resource.data.scope == 'company'
                         || resource.data.scope == 'project'
                         || (resource.data.scope == 'user'
                             && resource.data.ownerId == request.auth.uid)
                       );

        // ✍️ CREATE — Tenant member + companyId == path + ownerId == self + valid scope
        allow create: if isAuthenticated()
                      && resource == null
                      && belongsToCompany(companyId)
                      && request.resource.data.companyId == companyId
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.scope in ['user', 'company', 'project']
                      && (request.resource.data.scope != 'project'
                          || request.resource.data.keys().hasAny(['projectId']));

        // 📝 UPDATE — Owner only (immutable companyId/scope/ownerId)
        allow update: if isAuthenticated()
                      && belongsToCompany(companyId)
                      && resource.data.ownerId == request.auth.uid
                      && request.resource.data.companyId == resource.data.companyId
                      && request.resource.data.scope == resource.data.scope
                      && request.resource.data.ownerId == resource.data.ownerId;

        // 🗑️ DELETE — Owner or company_admin (per scope)
        // user scope: owner only.
        // company / project scope: owner or company_admin.
        allow delete: if isAuthenticated()
                      && belongsToCompany(companyId)
                      && (
                           resource.data.ownerId == request.auth.uid
                           || (resource.data.scope in ['company', 'project']
                               && isCompanyAdminOfCompany(companyId))
                         );
      }
    }

    // =========================================================================
    // 🏠 BUILDINGS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1A Critical Hotfix)
    // =========================================================================
    // 🔒 SECURITY: Removed public read (was: `allow read: if true;`)
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1A)
    // 🏢 ENTERPRISE: Follows /files pattern (lines 121-226)
    //
    // Security Model:
    //   - READ: Only users from the building's company (tenant-scoped)
    //   - WRITE: Admin/server only (via Firebase Admin SDK)
    // =========================================================================
    match /buildings/{buildingId} {

      // 📖 READ: Tenant-scoped - only users from the building's company
      // 🔒 SECURITY: Prevents cross-tenant data leak
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all buildings
                       isSuperAdminOnly()
                       // OR user belongs to the building's company (PRIMARY path)
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK (TRANSITIONAL - STRICT):
                       // Buildings without companyId but with projectId - lookup via project
                       // ⚠️ NOTE: Requires data migration - see docs/architecture-review/migration-companyId.md
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );

      // 🚫 WRITE: Admin/server only (via Firebase Admin SDK)
      // 🏢 ENTERPRISE: Building creation/modification requires admin privileges
      allow write: if false;
    }

    // =========================================================================
    // 🏢 FLOORS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Tenant-scoped via building→company lookup
    //
    // Security Model:
    //   - READ: Only users from the building's company (tenant-scoped)
    //   - WRITE: Admin/server only (via Firebase Admin SDK)
    // =========================================================================
    match /floors/{floorId} {
      // 📖 READ: Tenant-scoped — direct companyId first, building lookup as fallback
      // 🔒 SECURITY: Prevents cross-tenant data leak
      // 🔴 ADR-823: το σκέλος `companyId` είναι αυτό που **αποδεικνύει** το παραγωγικό
      //    ερώτημα (`tenant-config.ts` → `FLOORS` παίρνει το προεπιλεγμένο `companyId`).
      //    Χωρίς αυτό, ένα `where('companyId','==',…)` **χωρίς** συνοδό `where('buildingId')`
      //    είναι **δομικά ανικανοποίητο** — μετρημένο 2026-08-27. Δες `properties` για την
      //    πλήρη ανατομία.
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all
                       isSuperAdminOnly()
                       // PRIMARY: the tenant key the client actually queries on
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // OR user belongs to the building's company
                       || (resource.data.keys().hasAny(['buildingId'])
                           && resource.data.buildingId is string
                           && belongsToBuildingCompany(resource.data.buildingId))
                       // LEGACY FALLBACK: Creator-only for floors without buildingId
                       || (!resource.data.keys().hasAny(['buildingId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // 🚫 WRITE: Admin/server only
      allow write: if false;
    }

    // =========================================================================
    // 🌍 ADR-777 ΕΠΙΠΕΔΟ Α — ΚΟΙΝΟ ΦΥΣΙΚΟ ΓΕΓΟΝΟΣ (ΓΗ + ΚΤΙΡΙΟ ΤΟΥ ΚΟΣΜΟΥ)
    // =========================================================================
    // SPEC-777A §14.4 — ΜΗ ΔΙΑΠΡΑΓΜΑΤΕΥΣΙΜΟΙ ΚΑΝΟΝΕΣ:
    //   1. Το επίπεδο Α είναι **μόνο για ανάγνωση** από τον πελάτη. Καμία απευθείας
    //      εγγραφή — **ποτέ**.
    //   2. Γράφει **μόνο ο διακομιστής** (Firebase Admin SDK, που παρακάμπτει αυτούς
    //      τους κανόνες), μετά από επαλήθευση πηγής.
    //   3. Η συλλογή είναι δηλωμένη ρητά ως `public-world` στο `tenant-config.ts`.
    //   4. Καμία διαδρομή από το Α προς το Β — δεν κουβαλά εμπορικό δεδομένο.
    //
    // 🔴 ΓΙΑΤΙ ΤΟ `allow write: if false` ΕΙΝΑΙ ΤΟ ΟΛΟΚΛΗΡΟ ΣΧΕΔΙΟ ΑΣΦΑΛΕΙΑΣ ΕΔΩ:
    // μέχρι σήμερα ένα λάθος έγραφε σε **έναν** πελάτη. Αυτά τα έγγραφα τα βλέπουν
    // **ΟΛΟΙ** — άρα μία κακόβουλη εγγραφή γίνεται φορέας επίθεσης προς **κάθε**
    // πελάτη μαζί. Δεν υπάρχει ρόλος, ούτε καν `super_admin`, που να δικαιολογεί
    // εγγραφή από τον πελάτη: ο διαχειριστής που πρέπει να γράψει, γράφει από τον
    // διακομιστή, όπου η πηγή μπορεί να **επαληθευτεί**.
    //
    // ⚠️ ΚΑΜΙΑ ΠΡΟΣΒΑΣΗ ΣΕ ΚΛΕΙΔΙ: το `allow read: if true` δεν αγγίζει
    // `resource.data.*`, άρα δεν μπορεί να αποτύχει σε έγγραφο που δεν έχει κάποιο
    // πεδίο. (Η παγίδα «πρόσβαση σε απόν κλειδί = σφάλμα ⇒ αρνείται ΟΛΟ το σκέλος»
    // πληρώθηκε ήδη δύο φορές σε αυτό το αρχείο — 2026-08-05 και ADR-777 Α20.)
    //
    // 📖 Η δημόσια ανάγνωση είναι **σκόπιμη και ακίνδυνη**: εδώ δεν υπάρχει τίποτα
    // ιδιωτικό. Είναι, κατά γράμμα του §14.1, «ό,τι θα ήταν αληθές ακόμη κι αν
    // έσβηναν όλοι οι λογαριασμοί». Ό,τι έχει αξία (τιμές, πελάτες, ζητήσεις) ζει
    // στο επίπεδο Β, αυστηρά απομονωμένο.
    match /public_lands/{landId} {
      allow read: if true;
      allow write: if false;
    }

    match /public_buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // 📢 ADR-777 Α3/Α5/Α20 — Η ΠΡΟΒΟΛΗ ΑΝΑΓΝΩΣΗΣ ΤΗΣ ΑΓΓΕΛΙΑΣ
    // =========================================================================
    // 🔴 ΓΙΑΤΙ ΥΠΑΡΧΕΙ ΞΕΧΩΡΙΣΤΗ ΣΥΛΛΟΓΗ, ΕΝΩ ΤΟ `properties` ΕΧΕΙ ΗΔΗ ΔΗΜΟΣΙΟ ΣΚΕΛΟΣ:
    //
    // Το Firestore ΔΕΝ έχει έλεγχο ανάγνωσης σε επίπεδο πεδίου — «you either retrieve
    // the full document, or you retrieve nothing» (τεκμηρίωση Google, *Control access
    // to specific fields*). Άρα το σκέλος στο `properties` παρακάτω δίνει στον ανώνυμο
    // επισκέπτη ΟΛΟΚΛΗΡΟ το έγγραφο: `companyId`, `createdBy` (uid),
    // `_lastModifiedByName` (ονοματεπώνυμο), `linkedCompanyId`, `projectId`, `code`.
    // Το σχόλιο δίπλα του γράφει «no companyId leak» — εγγύηση ΧΩΡΙΣ μηχανισμό.
    //
    // Εδώ η απομόνωση επιτυγχάνεται με ΤΟ ΤΙ ΓΡΑΦΕΤΑΙ, όχι με κανόνα ανάγνωσης: το
    // σχήμα (`src/types/public-listing.ts`) είναι κλειστό και δεν περιέχει καμία
    // ταυτότητα πελάτη. Άγκυρα: `public-listing-projection.test.ts` Κ4, που ψάχνει
    // ονομαστικά τα διαρρέοντα πεδία στη σειριοποιημένη έξοδο.
    //
    // ⚠️ ΤΟ ΣΚΕΛΟΣ ΤΟΥ `properties` ΔΕΝ ΑΦΑΙΡΕΙΤΑΙ ΣΕ ΑΥΤΟ ΤΟ ΒΗΜΑ: ο υπάρχων
    // `usePublicProperties` το χρησιμοποιεί ακόμη. Η αφαίρεση είναι ξεχωριστή πράξη
    // ΜΕΤΑ τη μετανάστευση του καταναλωτή (ADR-777 κανόνας 19: μετακινούμε
    // ΚΑΤΑΝΑΛΩΤΕΣ, όχι αρχεία). Καταγεγραμμένο ως χρέος στο ADR.
    //
    // Γράφει ΜΟΝΟ ο διακομιστής (Admin SDK, παρακάμπτει αυτούς τους κανόνες) — και
    // εδώ ο λόγος είναι διπλός: ένα κακόβουλο έγγραφο θα το έβλεπαν ΟΛΟΙ, και ο
    // πελάτης δεν πρέπει ποτέ να αποφασίζει τι είναι δημόσιο για λογαριασμό μας.
    match /public_listings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // 🎯 ADR-827 §9 — Η ΒΙΤΡΙΝΑ ΤΟΥ ΓΡΑΦΕΙΟΥ
    // =========================================================================
    // 🔴 Η ΜΟΝΗ ΣΑΡΩΣΙΜΗ ΣΥΛΛΟΓΗ ΤΟΥ ΕΡΓΟΥ ΠΟΥ ΠΕΡΙΕΧΕΙ ΟΡΓΑΝΙΣΜΟΥΣ — και το
    // ADR-787 Ε-5 §4 #1 απαγορεύει ρητά την «απαρίθμηση γραφείων». Η άδεια στηρίζεται
    // σε ΕΝΑ πράγμα, και δεν είναι το σχήμα:
    //
    //   Ο ΠΛΗΘΥΣΜΟΣ ΕΙΝΑΙ OPT-IN. Κάθε εγγραφή γράφτηκε με ρητή, ανακλητή πράξη ΤΟΥ
    //   ΙΔΙΟΥ ΤΟΥ ΓΡΑΦΕΙΟΥ. Στο `workspace_aliases` κάθε χώρος έχει εγγραφή
    //   ΥΠΟΧΡΕΩΤΙΚΑ (το ψευδώνυμο ΕΙΝΑΙ η διεύθυνσή του) ⇒ εκεί η σάρωση είναι
    //   ΑΠΟΓΡΑΦΗ ΜΙΣΘΩΤΩΝ. Εδώ είναι ανάγνωση αφισών.
    //
    // 🔑 Ο ΦΡΟΥΡΟΣ: η απουσία από την προβολή είναι ΑΔΙΑΚΡΙΤΗ από την ανυπαρξία.
    //    Γραφείο που δεν δημοσιεύτηκε απαντά ταυτόσημα με ψευδώνυμο που δεν υπήρξε
    //    ποτέ ⇒ ούτε η σάρωση ούτε η δοκιμή διευθύνσεων λένε τίποτα για τον πίνακα
    //    μισθωτών. Αυστηρότερο από όσο ζητά το Ε-5 §4 #1.
    //
    // ⚠️ `read: if true` (ανώνυμος) ΣΚΟΠΙΜΑ: ένα `isAuthenticated()` δεν είναι άμυνα
    //    σε απαρίθμηση — η εγγραφή είναι δωρεάν και διαρκεί δευτερόλεπτα. Θα ήταν
    //    τελετουργικό. Η άμυνα είναι ο ΠΛΗΘΥΣΜΟΣ, όχι η πόρτα· και η βιτρίνα υπάρχει
    //    ακριβώς για να τη βλέπουν. Ίδια στάση με το `public_listings` από πάνω.
    //
    // ⛔ ΓΡΑΦΕΙ ΜΟΝΟ Ο ΔΙΑΚΟΜΙΣΤΗΣ, και ο έλεγχος που κάνει ΔΕΝ εκφράζεται εδώ: η
    //    δημοσίευση απαιτεί `capabilities.brokerage_listings == 'active'` (ADR-824),
    //    κατάσταση με κύκλο ζωής που ζει στο `companies/{id}`. Κανόνας που θα διάβαζε
    //    άλλο έγγραφο σε κάθε εγγραφή θα ήταν ΔΕΥΤΕΡΟΣ ΚΡΙΤΗΣ (ADR-749) — ο πρώτος
    //    είναι ο αδιαπέραστος τύπος `BrokerageAuthority`.
    match /agency_profiles/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // 🏆 ADR-841 §7 Α21.12 — ΠΟΥ ΒΡΙΣΚΕΤΑΙ ΤΟ ΠΡΩΤΟΤΥΠΟ ΤΟΥ ΣΗΜΑΤΟΣ
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΟ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ, ΚΑΙ ΕΙΝΑΙ Η ΙΔΙΑ ΑΠΟΦΑΣΗ ΜΕ ΤΟ CUSTODY.
    //
    // Το έγγραφο κρατά **μονοπάτι ιδιωτικού κάδου** — ακριβώς αυτό που το
    // `showcase-mark-custody` δηλώνει γραπτώς ότι «δεν επιστρέφει ΠΟΤΕ» στο σύρμα,
    // «γιατί θα έδειχνε την εσωτερική δομή αποθήκευσης σε κάθε ανώνυμο επισκέπτη».
    // Ανάγνωση από πελάτη εδώ θα ανέτρεπε την ίδια απόφαση από την **πίσω πόρτα**.
    //
    // ⚠️ ΚΑΙ Η ΓΡΑΦΗ ΚΛΕΙΣΤΗ: το μονοπάτι είναι η **απόδειξη προέλευσης** που θα
    // διαβάσει η μαζική επαναδημοσίευση. Πελάτης που το γράφει θα μπορούσε να δείξει
    // σε **ξένο** αρχείο και να το δημοσιεύσει ως σήμα του — δηλαδή ο φρουρός
    // `markSourceForCompany` θα παρακάμπτονταν στην επόμενη σάρωση.
    //
    // 🔑 ΓΙΑΤΙ ΞΕΧΩΡΙΣΤΗ ΡΙΖΑ και όχι υποσυλλογή του `agency_profiles`: εκείνο έχει
    // `read: if true`. Η υποσυλλογή θα ήταν ασφαλής ΜΟΝΟ όσο ο κανόνας από πάνω δεν
    // αποκτά `{document=**}` — δηλαδή η ασφάλεια θα στηριζόταν στην ΑΠΟΥΣΙΑ ενός
    // wildcard. Εδώ καμία αλλαγή εκεί δεν μπορεί να την εκθέσει.
    match /showcase_mark_sources/{companyId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🏆 ADR-841 §7 Α21.16 — ΤΑ ΚΑΝΑΛΙΑ ΤΗΣ ΚΑΡΤΑΣ (τηλέφωνα · email ανά κατάστημα)
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΟ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ — ΚΑΙ ΕΙΝΑΙ ΟΛΟΣ Ο ΛΟΓΟΣ ΥΠΑΡΞΗΣ ΤΗΣ ΣΥΛΛΟΓΗΣ.
    //
    // Τα κανάλια ΕΠΙΤΡΕΠΟΝΤΑΙ πλέον στη βιτρίνα, αλλά ΟΧΙ στο `agency_profiles`: εκείνο
    // είναι `read: if true` και ο κατάλογος το κατεβάζει ΟΛΟΚΛΗΡΟ σε κάθε ανώνυμο. Ένα
    // `read: if true` εδώ = όλα τα τηλέφωνα όλων με μία κλήση SDK. Τα σερβίρει ΜΟΝΟ ο
    // διακομιστής (`/api/pro/.../channels`), ένα κατάστημα τη φορά, με όριο HEAVY.
    //
    // ⚠️ ΟΥΤΕ Ο ΙΔΙΟΚΤΗΤΗΣ διαβάζει απευθείας: το «μα είναι τα ΔΙΚΑ του τηλέφωνα» είναι
    // ο πειρασμός που θα άνοιγε πόρτα χωρίς όριο ρυθμού. Τα παίρνει από το GET της κάρτας.
    // ⚠️ ΚΑΙ Η ΓΡΑΦΗ ΚΛΕΙΣΤΗ: τα `channelKinds` του δημόσιου εγγράφου γράφονται στην ΙΔΙΑ
    // συναλλαγή — πελάτης που γράφει εδώ θα τα έκανε να διαφωνούν (ADR-749).
    match /showcase_card_channels/{companyId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🏆 ADR-841 §7 Α21.18 — ΤΑ ΑΙΤΗΜΑΤΑ ΕΠΙΒΕΒΑΙΩΣΗΣ EMAIL ΤΗΣ ΚΑΡΤΑΣ
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΟ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ. Το έγγραφο κρατά ΔΙΕΥΘΥΝΣΗ email της κάρτας και το
    // `nonce` του υπογεγραμμένου συνδέσμου: ανάγνωση από πελάτη = τα email χωρίς όριο ρυθμού,
    // γραφή από πελάτη = σήμα «επιβεβαιώθηκε» χωρίς να πατηθεί ποτέ σύνδεσμος.
    // Η εξαργύρωση γίνεται ΜΟΝΟ από τον διακομιστή (`POST /api/showcase-email-confirmations/[token]`),
    // στην ίδια συναλλαγή με την ημερομηνία στο κανάλι και στο δημόσιο κατάστημα.
    match /showcase_email_confirmations/{confirmationId} {
      allow read: if false;
      allow write: if false;
    }

    // ADR-841 §7 Α21.21 Φάση Β — ΟΙ ΕΡΩΤΗΣΕΙΣ ΑΡΓΙΩΝ. Κρατούν το `nonce` των υπογεγραμμένων συνδέσμων:
    // γραφή από πελάτη = «απαντήθηκε» χωρίς σύνδεσμο, ανάγνωση = σύνδεσμοι χωρίς όριο ρυθμού. Η απάντηση
    // γράφεται ΜΟΝΟ από τον διακομιστή (`POST /api/holiday-hours-questions/[token]`), στην ίδια συναλλαγή
    // με τις ειδικές μέρες της κάρτας.
    match /holiday_hours_questions/{questionId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🏆 ADR-841 §7 Α21.20 — ΣΥΜΒΑΝΤΑ ΠΑΡΑΔΟΣΗΣ EMAIL + ΚΑΤΑΣΤΑΣΗ ΑΝΑ ΔΙΕΥΘΥΝΣΗ
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΑ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ. Κρατούν διευθύνσεις παραληπτών ΟΛΗΣ της πλατφόρμας (όχι ενός
    // μισθωτή) — ανάγνωση από πελάτη = κατάλογος email χωρίς όριο. ΓΡΑΦΗ από πελάτη = «το γραμματοκιβώτιο
    // πέθανε» για ξένη κάρτα, δηλαδή αφαίρεση ξένου σήματος. Γράφει ΜΟΝΟ το υπογεγραμμένο webhook
    // (`/api/communications/webhooks/mailgun/events`).
    match /email_delivery_events/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    match /email_recipient_standing/{standingId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🏆 ADR-841 §7 Α23 — ΤΙ ΑΠΑΝΤΗΣΕ ΤΟ ΓΕΜΗ (στιγμιότυπο νομικής ταυτότητας)
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΟ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ.
    // ΓΡΑΦΗ: είναι η απάντηση της ΑΡΧΗΣ. Πελάτης που γράφει εδώ = «επαληθευμένη από ΓΕΜΗ»
    // χωρίς να ρωτηθεί ποτέ το ΓΕΜΗ — ακριβώς γι' αυτό ΔΕΝ ζει στο `accounting_settings`,
    // που το γράφει ο company admin.
    // ΑΝΑΓΝΩΣΗ: κρατά την έδρα από το μητρώο (σε ατομική, συχνά η κατοικία). Δημόσια φεύγει
    // ΜΟΝΟ ό,τι επέλεξε ο επαγγελματίας στη δημοσίευση (GDPR άρθ. 25(2)).
    match /company_registry_records/{companyId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🎯 ADR-827 §8.7 — ΤΟ ΑΙΤΗΜΑ ΑΝΑΘΕΣΗΣ
    // =========================================================================
    // 🔴 ΚΛΕΙΣΤΟ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ — ΚΑΙ ΤΟ `read: false` ΓΙΑ ΤΟΝ ΠΑΡΑΛΗΠΤΗ ΕΙΝΑΙ
    // ΤΟ ΝΟΗΜΑ ΤΟΥ ΚΑΝΟΝΑ, ΟΧΙ ΠΑΡΑΛΕΙΨΗ.
    //
    // Το έγγραφο περιέχει `requestedByUserId` — την ταυτότητα του ιδιώτη. Το ADR-827
    // §8.2 αποφασίζει ότι το γραφείο ΔΕΝ τη μαθαίνει όσο κρίνει: «το γραφείο κρίνει
    // το ΑΚΙΝΗΤΟ· ο άνθρωπος δεν είναι κριτήριο». Και η τεκμηρίωση της Google λέει
    // «*It is impossible using security rules alone to prevent users from reading
    // specific fields within a document*» ⇒ ένα `allow read` για τον παραλήπτη θα του
    // έδινε την ταυτότητα, όσο κλειστή κι αν είναι η προβολή από πάνω.
    //
    // 🔑 Το γραφείο διαβάζει `MandateRequestForAgency` — σχήμα που ΔΕΝ ΕΧΕΙ ΠΕΔΙΟ
    //    ΤΑΥΤΟΤΗΤΑΣ ΚΑΘΟΛΟΥ. Δεν «απαγορεύεται» να σταλεί όνομα· δεν υπάρχει πεδίο να
    //    μπει. Ο φρουρός είναι ΤΥΠΟΣ, όχι κανόνας.
    //
    // ⚠️ ΚΑΙ Ο ΙΔΙΩΤΗΣ ΔΕΝ ΔΙΑΒΑΖΕΙ ΑΠΕΥΘΕΙΑΣ, παρότι το έγγραφο είναι δικό του: η
    //    οθόνη του ρωτά «τι έχει φτάσει στο γραφείο;», και η απάντηση είναι το
    //    `disclosedTo(request)` — ΚΑΘΑΡΗ ΣΥΝΑΡΤΗΣΗ που οφείλει να τρέξει στην ΙΔΙΑ
    //    πλευρά με τον συνθέτη της προβολής, αλλιώς γεννιούνται δύο πηγές που μπορούν
    //    να διαφωνήσουν (§8.6, ρητή απαγόρευση κάθε `disclosure_log`).
    match /mandate_requests/{requestId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🤝 ADR-843 — Η ΠΡΑΞΗ ΤΗΣ ΠΡΩΤΗΣ ΕΠΑΦΗΣ
    // =========================================================================
    // 🔴 ΤΟ ΙΔΙΟ ΖΕΥΓΟΣ ΜΕ ΤΟ `mandate_requests` ΑΠΟ ΠΑΝΩ — ΜΕ ΑΝΤΙΣΤΡΟΦΟ ΛΟΓΟ,
    // ΚΑΙ Η ΑΝΤΙΣΤΡΟΦΗ ΕΙΝΑΙ ΑΚΡΙΒΩΣ ΤΟ ΠΡΑΓΜΑ ΠΟΥ ΠΡΕΠΕΙ ΝΑ ΔΙΑΒΑΣΤΕΙ ΕΔΩ.
    //
    // Εκεί κρύβαμε το πρόσωπο: το γραφείο κρίνει το ΑΚΙΝΗΤΟ, ο άνθρωπος δεν είναι
    // κριτήριο (§8.2). Εδώ η ΑΠΟΚΑΛΥΨΗ ΕΙΝΑΙ Ο ΣΚΟΠΟΣ — αυτή είναι όλη η πράξη.
    // Παρ' όλα αυτά ο κανόνας είναι ο ΙΔΙΟΣ, και ΟΧΙ από αντιγραφή:
    //
    // 1. 🔴 ΤΟ ΩΜΟ ΕΓΓΡΑΦΟ ΛΕΕΙ ΠΕΡΙΣΣΟΤΕΡΑ ΑΠΟ ΤΗΝ ΠΡΑΞΗ. Κουβαλά `demandId`
    //    (κλειδί προς το ΕΠΙΠΕΔΟ Β, που το SPEC-777A §12.7(α) απαγορεύει να γίνει
    //    «εργαλείο πίεσης») και `matchReason`. Το Firestore ΔΕΝ φιλτράρει πεδία στην
    //    ανάγνωση — «you either retrieve the full document, or you retrieve nothing»
    //    ⇒ ένα `allow read` για τον παραλήπτη θα του έδινε ΚΑΙ ΤΑ ΔΥΟ, όσο κλειστή κι
    //    αν είναι η προβολή από πάνω. Ο παραλήπτης διαβάζει `FirstContactForOfferer`.
    //
    // 2. 🔑 Η ΑΠΟΚΑΛΥΨΗ ΥΠΟΛΟΓΙΖΕΤΑΙ, ΔΕΝ ΑΠΟΘΗΚΕΥΕΤΑΙ. Το `disclosedToOfferer()` είναι
    //    ΚΑΘΑΡΗ ΣΥΝΑΡΤΗΣΗ που οφείλει να τρέχει στην ΙΔΙΑ πλευρά με τον συνθέτη της
    //    προβολής· αλλιώς γεννιούνται δύο πηγές που μπορούν να διαφωνήσουν για το «τι
    //    είδε ο άλλος» — και η διαφωνία εκεί λέγεται ΨΕΥΔΗΣ ΔΙΑΒΕΒΑΙΩΣΗ (ΠΕ6/Κ10).
    //    Ίδια ρητή απαγόρευση κάθε `disclosure_log` με το ADR-827 §8.6.
    //
    // 3. 🔴 ΚΑΙ Η ΓΡΑΦΗ ΕΙΝΑΙ ΚΛΕΙΣΤΗ ΓΙΑ ΛΟΓΟ ΠΟΥ ΤΟ `mreq` ΔΕΝ ΕΧΕΙ: Η ΧΩΡΗΤΙΚΟΤΗΤΑ.
    //    Το ΠΕ5 δίνει ΟΡΙΣΜΕΝΕΣ ανοιχτές πράξεις ταυτόχρονα, και το όριο κρίνεται
    //    ΜΕΤΡΩΝΤΑΣ ΤΙΣ ΥΠΑΡΧΟΥΣΕΣ. Πελάτης που γράφει μόνος του θα έγραφε την ενδέκατη
    //    ΠΑΡΑΛΛΗΛΑ με τη δέκατη — ο έλεγχος θα έτρεχε δύο φορές πάνω στην ίδια
    //    κατάσταση και θα περνούσε δύο φορές. Ένας κανόνας δεν μπορεί να μετρήσει
    //    έγγραφα άλλης συλλογής, άρα το όριο ΔΕΝ ΕΚΦΡΑΖΕΤΑΙ ΕΔΩ — εκφράζεται στον
    //    γραφέα, και γι' αυτό ο γραφέας πρέπει να είναι ΕΝΑΣ.
    //
    // ⚠️ ΚΑΙ Ο ΙΔΙΟΣ Ο ΖΗΤΩΝ ΔΕΝ ΔΙΑΒΑΖΕΙ ΑΠΕΥΘΕΙΑΣ, παρότι η πράξη είναι δική του:
    // η οθόνη του ρωτά «τι βλέπει ακόμη ο άλλος;», και η απάντηση είναι η ίδια καθαρή
    // συνάρτηση του σημείου 2. Δεύτερη διαδρομή = δεύτερη αλήθεια (ADR-749).
    //
    // ⚠️ ΚΑΜΙΑ ΔΙΑΓΡΑΦΗ, ΑΠΟ ΚΑΝΕΝΑΝ — και δεν είναι αυστηρότητα: το ΠΕ6 λέει
    // «ανακαλείται η ΣΧΕΣΗ, ποτέ η ΙΣΤΟΡΙΑ». Η απόσυρση είναι `lifecycle: 'withdrawn'`.
    // Το ίχνος ΔΕΝ ΕΙΝΑΙ ΔΙΚΟ ΜΑΣ, ΕΙΝΑΙ ΤΩΝ ΔΥΟ: αν αύριο ο ένας πει «με παρενόχλησε»
    // ή ο άλλος «συμφωνήσαμε και το αρνήθηκε», το σβήσιμο αφήνει ΚΑΙ ΤΟΥΣ ΔΥΟ χωρίς
    // τίποτα να δείξουν. Η ολική διαγραφή δεν προστατεύει τον αδύναμο· προστατεύει
    // όποιον έχει κάτι να κρύψει, και δεν ξέρουμε ποιος είναι αυτός.
    // ⚠️ ΔΕΝ είναι το δικαίωμα στη λήθη (Κ11): εκείνο ικανοποιείται από άλλη, βαρύτερη
    // διαδρομή (διαγραφή λογαριασμού και δεδομένων), όχι από αυτό το κουμπί.
    match /first_contacts/{contactId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🎯 ADR-844 — Η ΠΡΟΣΚΛΗΣΗ ΤΗΣ ΠΡΩΤΗΣ ΕΠΑΦΗΣ (ό,τι ΔΕΝ είναι ακόμη πράξη)
    // =========================================================================
    // 🔑 ΙΔΙΟ ΣΧΗΜΑ ΜΕ ΤΗΝ ΠΡΑΞΗ ΑΠΟ ΠΑΝΩ, ΤΡΕΙΣ ΕΠΙΠΛΕΟΝ ΛΟΓΟΙ — ΚΑΙ Ο ΠΡΩΤΟΣ
    // ΕΙΝΑΙ ΑΡΚΕΤΟΣ ΜΟΝΟΣ ΤΟΥ:
    //
    // 1. 🔴 ΤΟ ΕΓΓΡΑΦΟ ΚΡΑΤΑ ΤΟ ΑΠΟΤΥΠΩΜΑ ΤΟΥ ΕΞΑΨΗΦΙΟΥ ΚΩΔΙΚΟΥ (`codeHash`) ΚΑΙ
    //    ΤΟ `nonce` ΤΟΥ ΣΥΝΔΕΣΜΟΥ. Μια ανάγνωση από πελάτη δίνει το υλικό για να
    //    εξαργυρώσει κάποιος ΞΕΝΗ πρόσκληση — δηλαδή να στείλει μήνυμα στο όνομα
    //    άλλου ανθρώπου, με τα ΔΙΚΑ ΤΟΥ στοιχεία επικοινωνίας μέσα.
    // 2. Ο μετρητής `attempts` ΕΙΝΑΙ ο μόνος φρουρός απέναντι στην ωμή βία που δεν
    //    παρακάμπτεται με αλλαγή IP. Πελάτης που γράφει, τον μηδενίζει.
    // 3. Το `declaration` κρατά όνομα, email και τηλέφωνο ανθρώπου που ΔΕΝ έχει
    //    ακόμη λογαριασμό — και το `demandId`, κλειδί προς το επίπεδο Β
    //    (SPEC-777A §12.7(α): «καμία διαδρομή που να το κάνει εργαλείο πίεσης»).
    //
    // ⚠️ ΚΑΙ ΕΔΩ Η ΔΙΑΓΡΑΦΗ ΕΙΝΑΙ ΤΟ ΑΝΤΙΘΕΤΟ ΤΗΣ ΠΡΑΞΗΣ, ΕΠΙΤΗΔΕΣ: εκεί «ανακαλείται
    // η ΣΧΕΣΗ, ποτέ η ΙΣΤΟΡΙΑ»· εδώ μια πρόσκληση που δεν πατήθηκε ΔΕΝ ΓΕΝΝΗΣΕ ΣΧΕΣΗ —
    // ο ιδιοκτήτης δεν έμαθε ποτέ ότι υπήρξε. Δεν υπάρχει ιστορία δύο ανθρώπων να
    // προστατευτεί, υπάρχει μόνο ένα εφήμερο έγγραφο με τα στοιχεία ενός. Σβήνεται
    // από τον σαρωτή λήξης (ADR-844 Β6) — με Admin SDK, όπως κάθε γραφή εδώ.
    match /first_contact_invitations/{invitationId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🔐 ADR-844 §13.8 — ΤΟ ΗΜΕΡΟΛΟΓΙΟ ΤΗΣ ΔΙΕΚΔΙΚΗΣΗΣ ΛΟΓΑΡΙΑΣΜΟΥ (deny-all)
    // =========================================================================
    // Λέει στην επόμενη απόδειξη email «ξαναχτίζεις ΑΥΤΟ το uid». Ένας πελάτης που θα
    // μπορούσε να το ΓΡΑΨΕΙ θα διάλεγε το uid που θα έπαιρνε το email κάποιου άλλου.
    // Και τα δύο μέρη — μόνο ο διακομιστής (Admin SDK).
    match /auth_reprovision_journal/{journalId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🎫 ADR-660 §6 — ΑΙΤΗΜΑΤΑ ΕΝΤΑΞΗΣ ΣΕ ΧΩΡΟ ΕΡΓΑΣΙΑΣ (deny-all)
    // =========================================================================
    // Η λίστα του διαχειριστή ΚΑΙ η κατάσταση του αιτούντα περνούν από διαδρομές
    // διακομιστή. Πελάτης που θα έγραφε εδώ θα ενέκρινε τον ΕΑΥΤΟ του.
    match /workspace_access_requests/{requestId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // ✉️ ADR-853 §7 — ΠΡΟΣΚΛΗΣΕΙΣ ΣΕ ΧΩΡΟ ΕΡΓΑΣΙΑΣ (deny-all)
    // =========================================================================
    // 🔴 ΤΟ ΕΓΓΡΑΦΟ ΚΡΑΤΑ ΜΥΣΤΙΚΟ, ΟΧΙ ΜΟΝΟ ΔΕΔΟΜΕΝΑ. Το `nonceHash` είναι το μισό
    // του υπογεγραμμένου συνδέσμου· μια ΑΝΑΓΝΩΣΗ δεν διαρρέει απλώς στοιχεία, δίνει
    // το υλικό για να εξαργυρωθεί ΞΕΝΗ πρόσκληση. Και μια ΓΡΑΦΗ είναι χειρότερη:
    // φτιάχνει αυτο-πρόσκληση σε ΟΠΟΙΟΝΔΗΠΟΤΕ χώρο, με ρόλο της επιλογής του γραφέα
    // — δηλαδή παρακάμπτει και το ταβάνι ρόλου (Ρ1) και τον αποκλεισμό του
    // `super_admin` (Ρ2), που κρίνονται στον διακομιστή κατά την έκδοση.
    //
    // ⚠️ Ο «λογικός» πειρασμός χαλάρωσης εδώ είναι ο ΕΤΑΙΡΙΚΟΣ — «μα ο διαχειριστής
    // πρέπει να βλέπει τις προσκλήσεις του γραφείου του». Είναι ακριβώς ο
    // επικίνδυνος: θα του έδινε το `nonceHash` ΚΑΘΕ ανθρώπου που προσκάλεσε, δηλαδή
    // τη δυνατότητα να μπει στη θέση του προσκεκλημένου. Η λίστα του διαχειριστή
    // περνά από διαδρομή διακομιστή, που στέλνει προβολή ΧΩΡΙΣ το αποτύπωμα.
    //
    // ⚠️ ΚΑΙ Ο ΠΑΡΑΛΗΠΤΗΣ ΔΕΝ ΔΙΑΒΑΖΕΙ: τη στιγμή της πρόσκλησης δεν έχει
    // απαραίτητα λογαριασμό, και το έγγραφο δεν φέρει `uid` — άρα δεν υπάρχει καν
    // «δική μου πρόσκληση» να επιτραπεί. Εξαργυρώνει με το token, όχι με ανάγνωση.
    match /workspace_invitations/{invitationId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 🎯 ADR-777 Α9 — Η ΖΗΤΗΣΗ (επίπεδο Β)
    // =========================================================================
    // 🔴 ΤΟ ΑΝΤΙΘΕΤΟ ΤΩΝ ΤΡΙΩΝ ΠΑΡΑΠΑΝΩ, ΚΑΙ ΕΠΙΤΗΔΕΣ.
    //
    // Οι `public_lands` / `public_buildings` / `public_listings` λένε
    // `allow read: if true`. Αυτή η συλλογή είναι η **μόνη** του ADR-777 που δεν
    // επιτρέπεται να τη διαβάσει κανείς πέρα από τον κάτοχό της, και ο λόγος είναι
    // γραμμένος στο SPEC-777A §14.2: οι *«ζητήσεις»* ονομάζονται **ρητά** στο
    // επίπεδο Β, «αυστηρά ιδιωτικό». Το §12.7(α) το εξειδικεύει: το σύστημα θα ξέρει
    // «ο Χ θέλει το ακίνητο του Ψ», και **καμία διαδρομή δεν επιτρέπεται να το κάνει
    // εργαλείο πίεσης».
    //
    // 🔑 ΤΙ ΒΛΕΠΕΙ Ο ΤΡΙΤΟΣ: το **επίπεδο Γ** — το ανώνυμο άθροισμα, που
    // **παράγεται** (`lib/demand/demand-aggregate.ts`) και **δεν ζει εδώ**. Ο
    // εργολάβος που πληρώνει το Ε2 αγοράζει αριθμούς, ποτέ έγγραφα. Το
    // SPEC-777-RESEARCH §15.5 το ονομάζει: «Ε2 — η ζήτηση (**επίπεδο Γ**) ως προϊόν».
    //
    // ⚠️ ΤΟ `authorUserId` ΕΙΝΑΙ ΑΜΕΤΑΒΛΗΤΟ. Χωρίς αυτό, ο κάτοχος μπορεί να
    // «χαρίσει» τη ζήτησή του σε άλλον με ένα update — δηλαδή να γράψει στο επίπεδο Β
    // τρίτου. Είναι το ίδιο invariant που το `properties` επιβάλλει για το `companyId`.
    //
    // ⚠️ ΚΑΜΙΑ ΔΙΑΓΡΑΦΗ ΑΠΟ ΤΟΝ ΠΕΛΑΤΗ: η απόσυρση είναι `lifecycle: 'withdrawn'`,
    // όχι `delete`. Μια σβησμένη ζήτηση δεν μπορεί να αποδείξει ότι μετρήθηκε ποτέ
    // σωστά στο άθροισμα — και το άθροισμα είναι προϊόν που πουλάμε.
    match /property_demands/{demandId} {
      allow read: if isAuthenticated() && resource.data.authorUserId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.authorUserId == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.authorUserId == request.auth.uid
                    && request.resource.data.authorUserId == resource.data.authorUserId;

      allow delete: if false;
    }

    // =========================================================================
    // 🎯 ADR-777 Α14 — Η ΠΡΟΣΦΟΡΑ ΤΟΥ ΙΔΙΩΤΗ (επίπεδο Β)
    // =========================================================================
    // 🔴 ΤΟ ΚΑΤΟΠΤΡΟ ΤΟΥ `property_demands` ΣΤΗΝ ΑΝΑΓΝΩΣΗ, ΚΑΙ ΤΟ ΑΝΤΙΘΕΤΟ ΤΟΥ ΣΤΗ
    //    ΓΡΑΦΗ — και οι δύο διαφορές έχουν γραμμένο λόγο.
    //
    // ΑΝΑΓΝΩΣΗ, ίδια: επίπεδο Β (SPEC-777A §14.2, «αυστηρά ιδιωτικό ανά
    // εταιρεία/ΧΡΗΣΤΗ»). Το έγγραφο κουβαλά τη διεύθυνση που πληκτρολόγησε ο άνθρωπος
    // (`place.label`) και τα μονοπάτια των αρχείων του — τίποτα από τα δύο δεν
    // επιτρέπεται να το δει τρίτος. Ό,τι βλέπει ο κόσμος είναι η ΠΡΟΒΟΛΗ
    // (`public_listings`), με ΚΛΕΙΣΤΟ σχήμα που δεν έχει κανένα από αυτά.
    //
    // 🔴 ΓΡΑΦΗ, ΑΝΤΙΘΕΤΗ: η ζήτηση γράφεται από τον ΠΕΛΑΤΗ· αυτή ΜΟΝΟ από τον
    // ΔΙΑΚΟΜΙΣΤΗ (Admin SDK, παρακάμπτει αυτούς τους κανόνες). Ο λόγος δεν είναι
    // αυστηρότητα για την αυστηρότητα — είναι ότι αυτή η συλλογή έχει ΔΗΜΟΣΙΟ
    // ΠΑΡΑΓΩΓΟ. Το `public_listings` λέει `allow write: if false` για κάθε πελάτη
    // («ο πελάτης δεν πρέπει ποτέ να αποφασίζει τι είναι δημόσιο για λογαριασμό
    // μας»). Αν ο πελάτης έγραφε ΕΔΩ και μετά καλούσε τον διακομιστή για τη
    // δημοσίευση, θα υπήρχε ΠΑΡΑΘΥΡΟ όπου το έγγραφο υπάρχει και η προβολή όχι — και
    // ο μόνος τρόπος να κλείσει θα ήταν να το θυμάται ο πελάτης. Με μία πράξη
    // διακομιστή, το «κάθε καταχώρηση έχει συνεπή προβολή» παύει να είναι ελπίδα.
    // Ίδιο σχήμα με το `properties` (`allow create: if false` → API + Admin SDK).
    //
    // ⚠️ ΤΟ `authorUserId` ΕΙΝΑΙ ΑΜΕΤΑΒΛΗΤΟ. Δεν επιβάλλεται εδώ με συνθήκη update
    // (δεν υπάρχει update από πελάτη), αλλά στον ΤΥΠΟ: το `OwnerPropertyDraft` δεν
    // το περιέχει, οπότε καμία διαδρομή δεν μπορεί να το στείλει.
    //
    // 🔴 §8.33 — ΤΟ ΠΕΔΙΟ ΜΕΤΟΝΟΜΑΣΤΗΚΕ ΑΠΟ `ownerUserId`, ΚΑΙ Ο ΚΑΝΟΝΑΣ ΔΕΝ ΑΛΛΑΞΕ
    // ΝΟΗΜΑ: δίνει ανάγνωση σε αυτόν που ΕΓΡΑΨΕ την αγγελία. Για τον ιδιώτη είναι ο
    // ίδιος ο ιδιοκτήτης· για τον μεσίτη ο υπάλληλος του γραφείου. Ποιανού ΕΙΝΑΙ το
    // ακίνητο το λέει το `mandate`, και ΔΕΝ είναι ερώτηση πρόσβασης: ο πελάτης-επαφή
    // δεν έχει καν λογαριασμό τη στιγμή που γράφεται η εντολή.
    //
    // ⚠️ ΚΑΜΙΑ ΠΡΟΣΘΗΚΗ ΣΚΕΛΟΥΣ ΓΙΑ ΤΟ ΓΡΑΦΕΙΟ. Ένα δεύτερο `allow read` πάνω στο
    // `authorCompanyId` θα ήταν ΔΕΥΤΕΡΟΣ ΑΞΟΝΑΣ ΑΠΟΜΟΝΩΣΗΣ — ρητά απαγορευμένο από το
    // `tenant-config.ts`. Ο κατάλογος του γραφείου σερβίρεται από τον ΔΙΑΚΟΜΙΣΤΗ
    // (Admin SDK), που δεν περνά από εδώ.
    //
    // ⚠️ ΚΑΜΙΑ ΔΙΑΓΡΑΦΗ, από κανέναν: η απόσυρση είναι `lifecycle: 'withdrawn'`, και
    // η δημόσια εξαφάνιση συμβαίνει ως ΣΥΝΕΠΕΙΑ (η προβολή σβήνεται από τον γραφέα).
    match /owner_properties/{ownerPropertyId} {
      allow read: if isAuthenticated() && resource.data.authorUserId == request.auth.uid;

      allow create, update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 🗂️ ΦΑΚΕΛΟΣ ΑΚΙΝΗΤΟΥ — ADR-866 Ε-1 · Φ1.1
    // =========================================================================
    // Ό,τι αφορά το ΣΠΙΤΙ, πέρα από κάθε αγγελία. ΙΔΙΟ σύνορο με το `owner_properties`
    // παραπάνω: διαβάζει ΜΟΝΟ ο κάτοχος, γράφει ΜΟΝΟ ο διακομιστής
    // (`property-dossier-write.service.ts`, Admin SDK) — γιατί η γέννηση πρέπει να μπορεί
    // να γίνει στην ΙΔΙΑ δέσμη με την αγγελία (Ε-Φ1-1), και το ίχνος είναι ιδιότητα της
    // διαδρομής γραφής.
    //
    // 🔑 Ο κάτοχος είναι `userId` και ΟΧΙ `authorUserId`: ο φάκελος ΑΛΛΑΖΕΙ ΧΕΡΙΑ (Φ4),
    // ο συγγραφέας όχι (ADR-866 §2.8.7 Δ1). Ίδιο όνομα με τα προσωπικά του αρχεία.
    //
    // ⚠️ ΚΑΝΕΝΑ σκέλος super_admin ή γραφείου: ό,τι αφορά το σπίτι ενός ανθρώπου το βλέπει
    // ο ίδιος — και από τη Φ3 όποιον ΚΑΛΕΣΕΙ, μέσω ADR-862, όχι μέσω ρόλου.
    // ⚠️ ΚΑΜΙΑ διαγραφή: η έξοδος από την καθημερινή λίστα είναι `lifecycle: 'archived'`.
    match /property_dossiers/{dossierId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create, update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 📅 ΗΜΕΡΟΛΟΓΙΟ ΚΑΤΑΛΥΜΑΤΟΣ — ADR-835 §20 (Στάδιο Α)
    // =========================================================================
    // Κεφαλή (`stay_calendars/{propertyId}`) · κλεισμένες νύχτες (`stay_blocks`) ·
    // κρατήσεις (`stay_bookings`). ΙΔΙΟ σύνορο με το `owner_properties` παραπάνω, και
    // επίτηδες: το ημερολόγιο είναι κομμάτι της αγγελίας.
    //
    // 🔴 ΚΑΝΕΙΣ ΔΕΝ ΓΡΑΦΕΙ ΑΠΟ ΤΟΝ ΠΕΛΑΤΗ, ΟΥΤΕ Ο ΣΥΝΤΑΚΤΗΣ. Κάθε εγγραφή τρέχει τον
    // κριτή κατάληψης ΜΕΣΑ σε συναλλαγή και αυξάνει το `version` της κεφαλής — ό,τι
    // έγραφε ο πελάτης θα παρέκαμπτε και τα δύο, δηλαδή θα ήταν overbooking με άλλο όνομα.
    //
    // ⚠️ Η οθόνη διαβάζει μέσω του διακομιστή (προβολή ανά θεατή, Στάδιο Ε)· ο κανόνας
    // ανάγνωσης υπάρχει ως ΑΝΩΤΑΤΟ όριο, όχι ως δρόμος. Κανένα σκέλος για γραφείο —
    // ίδιος λόγος με το `owner_properties` (ένας άξονας απομόνωσης).
    match /stay_calendars/{propertyId} {
      allow read: if isAuthenticated() && resource.data.authorUserId == request.auth.uid;
      allow create, update: if false;
      allow delete: if false;
    }

    match /stay_blocks/{blockId} {
      allow read: if isAuthenticated() && resource.data.authorUserId == request.auth.uid;
      allow create, update: if false;
      allow delete: if false;
    }

    // ADR-835 §23 (Στάδιο Δ): και ο ΕΠΙΣΚΕΠΤΗΣ διαβάζει — ΜΟΝΟ τα δικά του αιτήματα/κρατήσεις
    // (`guestUserId`, παράγωγο του κατόχου· ο αναγνώστης αρνείται έγγραφο που διαφωνεί). Η γραφή μένει
    // κλειστή: αίτημα που έγραφε ο πελάτης θα παρέκαμπτε κριτή, προθεσμία ΚΑΙ όριο ενεργών αιτημάτων.
    match /stay_bookings/{bookingId} {
      allow read: if isAuthenticated()
        && (resource.data.authorUserId == request.auth.uid
          || resource.data.get('guestUserId', null) == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    // ADR-835 §23.4 (Στάδιο Δ) — Η ΚΕΦΑΛΗ ΤΟΥ ΕΠΙΣΚΕΠΤΗ: μηχανισμός σειριοποίησης του ορίου ενεργών
    // αιτημάτων, ΟΧΙ προβολή. Κανείς πελάτης δεν τη διαβάζει ούτε τη γράφει — ούτε ο ίδιος ο επισκέπτης:
    // ό,τι χρειάζεται να δει («έχεις 3 ζωντανά αιτήματα») του το λέει ο διακομιστής, με όνομα.
    match /stay_guests/{userId} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if false;
    }

    // ADR-835 §21 (Στάδιο Β) — κανόνες ανά ημερομηνία (τιμή, ελάχ./μέγ., CTA/CTD), ένα
    // έγγραφο ανά (ακίνητο, μήνας). Ίδιο σύνορο: γραφή μόνο μέσα στη συναλλαγή της κεφαλής.
    match /stay_calendar_months/{monthId} {
      allow read: if isAuthenticated() && resource.data.authorUserId == request.auth.uid;
      allow create, update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 💬 ΔΙΚΤΥΟ ΣΥΝΕΡΓΑΤΩΝ — ADR-867 §4.1 / §4.2 / §4.3 (Β4)
    // =========================================================================
    // Το νήμα ανάμεσα σε ΔΥΟ ΠΛΕΥΡΕΣ ΔΙΑΦΟΡΕΤΙΚΩΝ ΧΩΡΩΝ. Δεν μοιάζει με καμία άλλη
    // συλλογή του αρχείου, και είναι επίτηδες: ΚΑΘΕ άλλος κανόνας ρωτά «ποιανού
    // μισθωτή είναι;» (`belongsToCompany`) ή «ποιος το έγραψε;» (`authorUserId`).
    // Εδώ και τα δύο θα ήταν ΛΑΘΟΣ ΑΠΑΝΤΗΣΗ:
    //
    //   🔴 `belongsToCompany` ⇒ το διαβάζει ΟΛΟ το γραφείο — αντίκειται ρητά στο
    //      ADR-834 §5 Β (γ) ① (το διαβάζει η ΟΜΑΔΑ της πράξης, όχι ο οργανισμός).
    //   🔴 `authorUserId` ⇒ το διαβάζει ΕΝΑΣ — δηλαδή το ορφανό νήμα σε απουσία ή
    //      αποχώρηση, το τεκμηριωμένο κενό Salesforce/HubSpot/Zendesk/Follow Up Boss.
    //
    // ✅ Η απάντηση είναι Η ΥΠΟΣΥΛΛΟΓΗ ΑΚΡΟΑΤΗΡΙΟΥ: «υπάρχει γραμμή για μένα, και
    //    είναι ΖΩΝΤΑΝΗ (`until == null`);». ΕΝΑΣ τόπος απαντά «ποιος διαβάζει;» —
    //    και για τον κανόνα ΚΑΙ για την οθόνη (ADR-867 §4.2).
    //
    // ⚠️ Η ΣΦΡΑΓΙΔΑ ΕΙΝΑΙ Ο ΚΑΝΟΝΑΣ, ΟΧΙ Η ΔΙΑΓΡΑΦΗ: όποιος βγήκε από την ομάδα έχει
    //    γραμμή με `until != null` — ΥΠΑΡΧΕΙ, και ΔΕΝ διαβάζει. Ένας κανόνας με σκέτο
    //    `exists()` θα έδινε πρόσβαση σε κάθε πρώην μέλος, για πάντα.

    // 🔒 ΤΟ ΒΙΒΛΙΟ ΤΩΝ ΑΝΑΚΛΗΣΕΩΝ — ADR-867 §4.1. ΤΟ ΚΕΙΜΕΝΟ ΠΟΥ ΠΗΡΕ ΠΙΣΩ Ο ΑΝΘΡΩΠΟΣ.
    //
    // 🔴 ΚΛΕΙΣΤΟ ΣΕ ΚΑΘΕ ΠΕΛΑΤΗ — ΚΑΙ ΣΤΟΝ ΙΔΙΟ ΤΟΝ ΑΠΟΣΤΟΛΕΑ. Αυτό είναι το σημείο
    // όπου η ανάκληση γίνεται ΑΛΗΘΙΝΗ: αν οποιοσδήποτε πελάτης μπορούσε να διαβάσει
    // εδώ, ο άνθρωπος θα νόμιζε ότι πήρε πίσω τα λόγια του ενώ θα ήταν ΕΝΑ ΕΡΩΤΗΜΑ
    // μακριά. Το διαβάζει ΜΟΝΟ ο διακομιστής, για τον ΕΝΑ λόγο που υπάρχει: ΓΚΠΔ
    // άρθρο 17 §3(ε) — θεμελίωση/άσκηση/υποστήριξη νομικών αξιώσεων.
    //
    // 🔑 ΓΙΑΤΙ ΕΙΝΑΙ ΕΔΩ, ΚΑΙ ΟΧΙ ΥΠΟΣΥΛΛΟΓΗ ΤΟΥ ΝΗΜΑΤΟΣ: μέσα στο `network_threads`
    // ζουν ΔΥΟ υποσυλλογές που ΔΙΝΟΥΝ ανάγνωση στο ακροατήριο. Ένα αντιγραμμένο
    // μπλοκ ή ένα μελλοντικό `{document=**}` θα άνοιγε ΣΙΩΠΗΛΑ και αυτή. Χωριστή
    // ρίζα = χωριστός κανόνας = καμία κληρονομιά άδειας κατά λάθος.
    //
    // 📐 Πρότυπο: Microsoft Teams κρατά ΔΥΟ αντίγραφα («one for compliance purposes,
    // one for end-user access») και η διαγραφή ΜΕΤΑΚΙΝΕΙ στο κρυφό `SubstrateHolds`·
    // Slack «save edits and deletions» + eDiscovery API· XMPP XEP-0424: «the
    // archiving service MUST store the retraction message». Εδώ ο «κρυφός τόπος»
    // είναι ΡΗΤΗ συλλογή με ΡΗΤΟ κανόνα — όχι φάκελος που τον μαθαίνεις σε αγωγή.
    match /network_message_retractions/{messageId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ✏️ ADR-867 Β7 — ΤΟ ΚΕΙΜΕΝΟ ΠΡΙΝ ΑΠΟ ΚΑΘΕ ΕΠΕΞΕΡΓΑΣΙΑ. Ίδιο δόγμα με τις ανακλήσεις: η
    // επεξεργασία δεν έχει όριο χρόνου (Teams · Slack), άρα ΚΑΘΕ προηγούμενη μορφή μένει εδώ —
    // αλλιώς το νήμα-τεκμήριο θα ξαναγραφόταν χωρίς ίχνος. Κλειστό σε ΚΑΘΕ πελάτη, και στον
    // αποστολέα. Γράφει ΜΟΝΟ ο `services/network-messaging/thread-messages.ts` (CHECK 3.89).
    match /network_message_revisions/{revisionId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // 🌴 ADR-867 §4.4 (Β5) — Η ΑΠΟΥΣΙΑ. ΚΛΕΙΣΤΗ ΣΕ ΚΑΘΕ ΠΕΛΑΤΗ, ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ.
    // Ο αντισυμβαλλόμενος μαθαίνει ΜΟΝΟ «ως πότε» και «ποιος διαβάζει στη θέση του», από
    // τον ΔΙΑΚΟΜΙΣΤΗ, και ΜΟΝΟ για όσους διαβάζουν το ΙΔΙΟ νήμα με αυτόν. Μια ανάγνωση
    // πελάτη εδώ θα έκανε το ημερολόγιο απουσιών ενός γραφείου ΑΠΑΡΙΘΜΗΣΙΜΟ από ξένους.
    // Γράφει ΜΟΝΟ ο `services/network-messaging/network-away.ts`.
    match /network_away/{awayId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /network_act_teams/{actTeamId} {
      // 🔴 ΚΛΕΙΣΤΗ ΚΑΙ ΣΤΙΣ ΔΥΟ ΠΛΕΥΡΕΣ. Η ομάδα είναι Η ΑΥΘΕΝΤΙΑ του «ποιος διαβάζει»
      // (§4.3): μια γραφή πελάτη εδώ θα ΕΒΑΖΕ ΤΟΝ ΕΑΥΤΟ ΤΟΥ στο ακροατήριο κάθε νήματος
      // — δηλαδή θα παρέκαμπτε ολόκληρο τον παραπάνω κανόνα από την πίσω πόρτα.
      // Η οθόνη τη διαβάζει από τον ΔΙΑΚΟΜΙΣΤΗ (Β5/Β7), που δεν περνά από εδώ.
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /network_threads/{threadId} {
      function audienceSeat() {
        return /databases/$(database)/documents/network_threads/$(threadId)/network_audience/$(request.auth.uid);
      }

      // 🔑 Η ΜΙΑ ΕΡΩΤΗΣΗ: «διαβάζω ΤΩΡΑ αυτό το νήμα;»
      function readsThisThread() {
        return isAuthenticated()
               && exists(audienceSeat())
               && get(audienceSeat()).data.until == null;
      }

      // 📖 GET: ναι — ώστε η οθόνη να είναι ΖΩΝΤΑΝΗ (onSnapshot). Χωρίς αυτό, κάθε νέο
      //    μήνυμα θα απαιτούσε δημοσκόπηση του διακομιστή, και μια συνομιλία που
      //    ανανεώνεται κάθε 10″ δεν είναι συνομιλία.
      allow get: if readsThisThread();

      // 🚫 LIST: ΠΟΤΕ. Το ακροατήριο είναι ΥΠΟΣΥΛΛΟΓΗ, άρα ένα ερώτημα πάνω στη συλλογή
      //    ΔΕΝ μπορεί να το ρωτήσει («rules are not filters»). Ο κατάλογος νημάτων
      //    σερβίρεται από τον ΔΙΑΚΟΜΙΣΤΗ (Β5) — ίδιο δόγμα με τον κατάλογο του γραφείου.
      allow list: if false;

      // ✍️ ΚΑΜΙΑ ΓΡΑΦΗ ΠΕΛΑΤΗ — ίδιο δόγμα με το `owner_properties`. Κάθε γραφή περνά
      //    από ΕΝΑΝ γραφέα μέσα σε συναλλαγή (`thread-writer.ts`, CHECK 3.89): εκεί
      //    ξαναελέγχεται το ακροατήριο και ενημερώνεται το `lastMessageAt` ΜΑΖΙ με το
      //    μήνυμα. Ένα μήνυμα γραμμένο από τον πελάτη θα παρέκαμπτε και τα δύο.
      allow create, update, delete: if false;

      // 💬 ΤΑ ΜΗΝΥΜΑΤΑ — ίδια ερώτηση, γιατί ίδιο ακροατήριο.
      // ⚠️ Εδώ το LIST ΕΠΙΤΡΕΠΕΤΑΙ: ο κανόνας δεν κοιτά ΚΑΝΕΝΑ πεδίο του εγγράφου, άρα
      //    δεν υπάρχει φίλτρο να «ξεχαστεί» — η άδεια κρίνεται από το ΝΗΜΑ, όχι από το
      //    ερώτημα. (Το `/messages` του ADR-029 είναι ΑΛΛΗ συλλογή· δες
      //    `firestore-collections.ts` για το γιατί το όνομα εδώ είναι `network_messages`.)
      match /network_messages/{messageId} {
        allow read: if readsThisThread();
        allow create, update, delete: if false;
      }

      // 👥 ΤΟ ΑΚΡΟΑΤΗΡΙΟ ΕΙΝΑΙ ΟΡΑΤΟ ΣΤΟ ΑΚΡΟΑΤΗΡΙΟ — ΚΑΙ ΕΙΝΑΙ ΧΑΡΑΚΤΗΡΙΣΤΙΚΟ, ΟΧΙ
      //    ΔΙΑΡΡΟΗ (ADR-834 §5 Β (ε) 🏆). Ο πελάτης βλέπει «ποιοι διαβάζουν» ΚΑΙ «από
      //    πότε» — αυτό ακριβώς που δεν κάνει κανένας από Front/Intercom/HubSpot/
      //    Zendesk/Teams, και ο λόγος που ο διαχειριστής χώρου ΔΕΝ μπαίνει σιωπηλά.
      //    ⚠️ Γράφει ΜΟΝΟ ο γραφέας: μια γραφή πελάτη εδώ είναι αυτοπρόσκληση σε ξένη
      //    συνομιλία — η ΜΙΑ πίσω πόρτα που ολόκληρο το σχήμα υπάρχει για να κλείσει.
      match /network_audience/{memberUid} {
        allow read: if readsThisThread();
        allow create, update, delete: if false;
      }
    }

    // ADR-835 §22 (Στάδιο Γ) — ΤΑ ΚΑΝΑΛΙΑ: πηγές iCal + γενιά του συνδέσμου εξαγωγής.
    //
    // 🔴 Η ΜΟΝΗ ΣΥΛΛΟΓΗ ΤΗΣ ΟΙΚΟΓΕΝΕΙΑΣ ΧΩΡΙΣ ΚΑΜΙΑ ΑΝΑΓΝΩΣΗ ΠΕΛΑΤΗ — και ο λόγος δεν
    // είναι η αυστηρότητα, είναι το ΠΕΡΙΕΧΟΜΕΝΟ: το URL ενός feed **ΕΙΝΑΙ
    // διαπιστευτήριο**. Ο σύνδεσμος `.ics` της Airbnb δίνει σε όποιον τον έχει
    // ΟΛΟΚΛΗΡΟ το ημερολόγιο του οικοδεσπότη εκεί — και η Firestore **δεν μπορεί** να
    // κρύψει πεδίο σε ανάγνωση εγγράφου (τεκμηρίωση Google, *Control access to specific
    // fields*: «You either retrieve the full document, or you retrieve nothing»).
    //
    // Άρα ο συντάκτης **δεν** διαβάζει ούτε το δικό του: η οθόνη παίρνει **προβολή** από
    // τον διακομιστή (host + κατάσταση + υπογεγραμμένοι σύνδεσμοι), ποτέ το έγγραφο.
    match /stay_channels/{propertyId} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 🏠 UNITS COLLECTION - ENTERPRISE TENANT ISOLATION (2026-01-24)
    // =========================================================================
    // 🏢 ENTERPRISE: Full tenant isolation via project→company lookup
    // 📋 Security Model:
    //    - READ: Only users belonging to the project's company (tenant-scoped)
    //    - UPDATE: Company admins of project's company + field allowlist + invariants
    //    - CREATE/DELETE: Admin/server only (via Firebase Admin SDK)
    // 🔐 Invariants: project, buildingId, floorId, name, id cannot be changed by client
    // 📅 Implemented: 2026-01-24
    match /properties/{propertyId} {
      // =======================================================================
      // 🔴 ΤΑ ΔΥΟ ΔΗΜΟΣΙΑ ΣΚΕΛΗ ΑΦΑΙΡΕΘΗΚΑΝ — ADR-777 Β2β (2026-08-10)
      // =======================================================================
      // Εδώ ζούσαν δύο `allow read` που δεν ζητούσαν `isAuthenticated()`:
      //
      //   allow read: if resource.data.commercialStatus in ['for-sale', ...];
      //   allow read: if resource.data.keys().hasAny(['offerKinds']) && ...;
      //
      // Το σχόλιο του πρώτου έγραφε «*no companyId leak*». **Η εγγύηση δεν είχε
      // μηχανισμό, και δεν μπορούσε να έχει:** «*Reads are performed at the document
      // level. You either retrieve the full document, or you retrieve nothing… It is
      // impossible using security rules alone to prevent users from reading specific
      // fields within a document*» (τεκμηρίωση Google, *Control access to specific
      // fields*). Μετρημένο στη ζωντανή βάση: κάθε δημοσιευμένο έγγραφο έδινε στον
      // ανώνυμο `companyId` · `createdBy` (uid) · `_lastModifiedByName`
      // (**ονοματεπώνυμο**) · `linkedCompanyId` · `projectId` · `buildingId` · `code` ·
      // `levelData`.
      //
      // 🔑 **Και δεν έδειχνε τίποτα σε αντάλλαγμα.** Ο μόνος καταναλωτής
      // (`usePublicProperties` → `usePublicPropertyViewer`) χαρτογραφούσε τα έγγραφα σε
      // `RealtimeUnit`, τύπο **χωρίς** `commercial`/`areas`, και τα περνούσε από το
      // `isDisplayableInSalesDashboard`, που απαιτεί `askingPrice > 0` (ή `rentPrice`).
      // Καμία από τις τρεις listed καταστάσεις δεν μπορούσε να το ικανοποιήσει ⇒ η
      // ανώνυμη λίστα ήταν **πάντα κενή**. Διέρρεε τα πάντα και εμφάνιζε τίποτα.
      //
      // Η αντικατάσταση είναι η **προβολή ανάγνωσης** `public_listings` (παραπάνω):
      // κλειστό σχήμα, γραμμένο από τον διακομιστή, **χωρίς πεδίο να διαρρεύσει**.
      // Σύσταση της ίδιας τεκμηρίωσης: «*separate public and private data into
      // different collections*».
      //
      // ⚠️ **ΜΗΝ ξαναπροσθέσεις δημόσιο σκέλος εδώ.** Άγκυρα: τα τέσσερα tests
      // «ο ΑΝΩΝΥΜΟΣ δεν διαβάζει ΔΗΜΟΣΙΕΥΜΕΝΟ ακίνητο» στο `properties.rules.test.ts`,
      // που σπέρνουν **και τα τρία** σχήματα που πυροδοτούσαν τα σκέλη — γιατί ο
      // πίνακας personas ήταν πράσινος πάνω στη διαρροή επί μήνες, σπέρνοντας έγγραφο
      // χωρίς κανένα από τα δύο πεδία.
      //
      // 📖 READ PRIVATE: Authenticated users of the property's company
      // 🔒 SECURITY: Tenant-scoped - prevents cross-tenant data leak
      //
      // ============================================================================
      // 🔴 ΓΙΑΤΙ ΥΠΑΡΧΕΙ ΤΟ ΣΚΕΛΟΣ `companyId` — ΤΟ ΕΡΩΤΗΜΑ ΠΡΕΠΕΙ ΝΑ ΜΠΟΡΕΙ ΝΑ
      //    ΑΠΟΔΕΙΞΕΙ ΤΟΝ ΚΑΝΟΝΑ (ADR-823, μετρημένο 2026-08-27)
      // ============================================================================
      //
      // Το Firestore κρίνει ένα `list` **ΟΧΙ** πάνω στα αποθηκευμένα έγγραφα αλλά
      // πάνω στο **δυνητικό σύνολο αποτελεσμάτων** που ορίζουν οι περιορισμοί του
      // ερωτήματος — κατά λέξη από την τεκμηρίωση: *«Cloud Firestore evaluates a
      // query against its potential result set instead of the actual field values»*.
      // Πεδίο που ο κανόνας διαβάζει και το ερώτημα **δεν περιορίζει** αποτιμάται
      // ως απροσδιόριστο ⇒ **σφάλμα αξιολόγησης** ⇒ **άρνηση ΟΛΟΚΛΗΡΟΥ** του
      // ερωτήματος. «Rules are not filters.»
      //
      // 🔴 **ΜΕΤΡΗΜΕΝΟ**: μέχρι τις 2026-08-27 αυτό το μπλοκ διάβαζε **μόνο**
      // `resource.data.projectId`, ενώ ο πελάτης στέλνει `where('companyId','==',…)`
      // (`tenant-config.ts` — το `PROPERTIES` δεν έχει override, άρα παίρνει το
      // προεπιλεγμένο `companyId`). Αποτέλεσμα: η λίστα ακινήτων ήταν **ΠΑΝΤΑ
      // κλειστή** για **κάθε** μη-super-admin — με **υγιή** βάση, **ένα** έγγραφο,
      // **νόμιμο** χρήστη:
      //     false for 'list' @ L21, Property projectId is undefined on object.
      // Νεκροί καταναλωτές: `useRealtimeProperties` (μετρητές πλοήγησης) και
      // `useRealtimePropertiesTrashCount`. Η **σελίδα** επιβίωνε μόνο επειδή περνά
      // από `/api/properties` (Admin SDK, **παρακάμπτει** τους κανόνες).
      //
      // ⚠️ **ΓΙΑΤΙ ΕΜΕΙΝΕ ΑΟΡΑΤΟ**: ο `isSuperAdminOnly()` αποδεικνύεται **χωρίς**
      // `resource`, οπότε ο μοναδικός λογαριασμός της ανάπτυξης περνούσε πάντα.
      // Ταυτόσημο σχήμα με το ADR-745 (`contacts`) — **δεύτερη φορά**.
      //
      // 🏢 **Η ΠΡΑΚΤΙΚΗ ΤΩΝ ΜΕΓΑΛΩΝ**: το κλειδί μισθωτή ζει σε **κάθε** έγγραφο και
      // το ερώτημα το φιλτράρει· το cross-doc `get()` μένει **εφεδρικό** σκέλος.
      // Δεν είναι χαλάρωση: ο **ίδιος ο διακομιστής** θεωρεί ήδη το `companyId`
      // κλειδί μισθωτή των ακινήτων (`tenantScopedCollection(COLLECTIONS.PROPERTIES,…)`
      // στο `/api/properties`). Ήταν **δύο δόγματα για την ίδια ερώτηση**· τώρα ένα.
      //
      // ✅ Ίδιο σχήμα με **τις άλλες εννέα** συλλογές της ίδιας κλάσης
      // (`buildings` 937 · `obligations` 2668 · `employment_records` 508 …) — το
      // `properties` ήταν το **μοναδικό** που αποαναφερόταν γυμνό.
      //
      // ⚠️ Ο φρουρός `keys().hasAny([...]) && … is string` στο **εφεδρικό** σκέλος
      // μένει για **δύο** λόγους, και **κανένας δεν είναι «αλλιώς πέφτει η λίστα»**:
      //   1. είναι το **ίδιο σχήμα** με τις άλλες εννέα συλλογές της κλάσης — το
      //      `properties` ήταν το μοναδικό που αποαναφερόταν γυμνό·
      //   2. γίνεται **φορτιοφέρων** αν κάποτε φύγει το σκέλος `companyId`.
      // 🔴 **Μετρημένο 2026-08-27**: με το σκέλος `companyId` παρόν, η αφαίρεσή του
      // **δεν αλλάζει καμία ετυμηγορία** (μετάλλαξη Μ3 → πράσινη). Γράφεται εδώ ώστε
      // να μην πιστέψει κανείς ότι τον προστατεύει άγκυρα που δεν υπάρχει.
      // Ό,τι **είναι** αγκυρωμένο: η αφαίρεση του σκέλους `companyId` ρίχνει **7**
      // δοκιμές στο `tenant-list-satisfiability.rules.test.ts` (μετάλλαξη Μ1).
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all
                       isSuperAdminOnly()
                       // PRIMARY: the tenant key the client actually queries on
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // FALLBACK: legacy documents without companyId — resolve via project.
                       // 📅 2026-08-05: field was `project` — every production document
                       //    carries `projectId` (server writes it, ADR-284 §3.1). Accessing a
                       //    missing key errors → this leg denied for ALL non-super-admins.
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );

      // ✍️ CREATE: Admin/server only
      allow create: if false;

      // 📝 UPDATE: Company admin of project's company + field allowlist + invariants
      // 🔒 SECURITY LAYERS:
      //    1. Role gate: Must be company_admin or super_admin
      //    2. Tenant gate: Must belong to project's company
      //    3. Field allowlist: Only property fields can be updated (not structural fields)
      //    4. Invariants: Structural fields (project, buildingId, floorId, name, id) unchanged
      allow update: if isAuthenticated()
                    && (
                         // Super admin bypasses all checks
                         isSuperAdminOnly()
                         // OR company admin of project's company with allowlist + invariants
                         || (
                              isCompanyAdminOfProject(resource.data.projectId)
                              && isAllowedPropertyFieldUpdate()
                              && propertyStructuralFieldsUnchanged()
                            )
                       );

      // 🗑️ DELETE: Admin/server only
      allow delete: if false;
    }

    // =========================================================================
    // 📦 STORAGE_UNITS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Storage units are a PARALLEL category to Properties, not nested
    // Architecture: Building → [Properties | Storage | Parking] (parallel)
    //
    // Security Model:
    //   - READ: Only users from the building's company (tenant-scoped)
    //   - WRITE: Admin/server only (via Firebase Admin SDK)
    // =========================================================================
    match /storage_units/{storageId} {
      // 📖 READ: Tenant-scoped — direct companyId first, building lookup as fallback
      // 🔒 SECURITY: Prevents cross-tenant data leak
      // 🔴 ADR-823 — ίδιο σκεπτικό με `floors`/`properties`: το παραγωγικό ερώτημα
      //    φιλτράρει `companyId`, άρα ο κανόνας πρέπει να μπορεί να αποδειχθεί από αυτό.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       // PRIMARY: the tenant key the client actually queries on
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (resource.data.keys().hasAny(['buildingId'])
                           && resource.data.buildingId is string
                           && belongsToBuildingCompany(resource.data.buildingId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['buildingId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // 🚫 WRITE: Admin/server only
      allow write: if false;
    }

    // =========================================================================
    // 🚗 PARKING_SPOTS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Parking spaces are a PARALLEL category to Units, not nested
    // Architecture: Building → [Units | Storage | Parking] (parallel)
    // 📍 Collection name: parking_spots (με underscore - όπως στη Firestore)
    //
    // Security Model:
    //   - READ: Only users from the building's company (tenant-scoped)
    //   - WRITE: Admin/server only (via Firebase Admin SDK)
    // =========================================================================
    match /parking_spots/{parkingId} {
      // 📖 READ: Tenant-scoped — direct companyId first, building lookup as fallback
      // 🔒 SECURITY: Prevents cross-tenant data leak
      // 🔴 ADR-823 — ίδιο σκεπτικό με `floors`/`storage_units`/`properties`.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       // PRIMARY: the tenant key the client actually queries on
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (resource.data.keys().hasAny(['buildingId'])
                           && resource.data.buildingId is string
                           && belongsToBuildingCompany(resource.data.buildingId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['buildingId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // 🚫 WRITE: Admin/server only
      allow write: if false;
    }

    // =========================================================================
    // 🧭 NAVIGATION_COMPANIES COLLECTION - TENANT-SCOPED READ ACCESS
    // =========================================================================
    // 🏢 ENTERPRISE: Εταιρείες που εμφανίζονται χειροκίνητα στην πλοήγηση
    // Περιέχει contactIds που αντιστοιχούν σε εταιρείες στη contacts collection
    // 🔒 ADR-252 Phase 3: Tenant isolation — super_admin βλέπει όλα,
    //    οι υπόλοιποι μόνο τα documents με companyId == δικό τους
    match /navigation_companies/{navCompanyId} {
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || belongsToCompany(resource.data.companyId));
      allow write: if false; // Admin/server only
    }

    // =========================================================================
    // 🔔 NOTIFICATIONS COLLECTION - USER-SCOPED ACCESS
    // =========================================================================
    // 🏢 ENTERPRISE: Secure notification access per user
    // 🔒 AUTHENTICATED: User can only access their own notifications
    // 📋 ADR-027: CRM Notifications Integration - Updated 2026-01-13
    // ⚠️ NOTE: For list queries, the userId filter must be in the query itself
    //          (where userId == auth.uid). Rules validate single doc reads.
    match /notifications/{notificationId} {
      // 📖 READ: Authenticated users can read notifications
      // Query MUST include: where('userId', '==', currentUserId) for security
      // Single doc reads verify ownership
      allow read: if isAuthenticated()
                  && (resource == null || resource.data.userId == request.auth.uid);

      // 📝 UPDATE: Users can mark their own notifications as read
      // Only allows updating delivery state and seen timestamp
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && isValidNotificationUpdate(request.resource.data, resource.data);

      // 🔒 CREATE: Server-only via Admin SDK (notification-orchestrator.ts)
      // Client create blocked — prevents notification spam/injection
      allow create: if false;

      // 🔒 DELETE: Server-only via Admin SDK
      // Client-side cleanup unnecessary — server handles lifecycle
      allow delete: if false;
    }

    // =========================================================================
    // ✅ TASKS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 🏢 ENTERPRISE: Task management για CRM leads, projects, και users
    // 🔒 SECURITY: Tenant-scoped via companyId field
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 📋 ADR-026: CRM Tasks Backend Fix - Added 2026-01-13
    //
    // Security Model:
    //   - READ: Only users from the task's company + assignedTo
    //   - CREATE: companyId must match user's company claim
    //   - UPDATE: Creator, assignedTo, or company admin
    //   - DELETE: Creator or company admin
    // =========================================================================
    match /tasks/{taskId} {

      // 📖 READ: Creator, assignee, same company, or super admin
      // 🔐 SECURITY: Tenant-scoped access
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all tasks
                       isSuperAdminOnly()
                       // OR user is the creator
                       || resource.data.createdBy == request.auth.uid
                       // OR user is the assignee
                       || resource.data.assignedTo == request.auth.uid
                       // OR user belongs to the task's company
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Authenticated users with companyId from claims, or super admin
      // 🔐 SECURITY: companyId MUST match user's company claim (super admin exempt)
      allow create: if isAuthenticated()
                    && isValidTaskData(request.resource.data)
                    && resource == null
                    && (
                         request.resource.data.companyId == getUserCompanyId()
                         || isSuperAdminOnly()
                       );

      // 📝 UPDATE: Creator, assignee, or company admin
      allow update: if isAuthenticated()
                    && isValidTaskData(request.resource.data)
                    && resource != null
                    && (
                         // Creator can update
                         resource.data.createdBy == request.auth.uid
                         // OR assignee can update
                         || resource.data.assignedTo == request.auth.uid
                         // OR company admin
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super admin
                         || isSuperAdminOnly()
                       )
                    // Prevent changing companyId
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📅 APPOINTMENTS COLLECTION - ENTERPRISE TENANT ISOLATION (ADR-089)
    // =========================================================================
    // 🏢 ENTERPRISE: Appointments from AI Pipeline (UC-001) with tenant isolation
    // 📅 Added: 2026-02-08 (CRM Calendar MVP - ADR-089)
    // 🔒 SECURITY: Documents created server-side via Admin SDK (bypasses rules)
    //              Client-side READ only — tenant-scoped via companyId
    //
    // Security Model:
    //   - READ: Tenant-scoped (companyId match or super admin)
    //   - WRITE: Server-side only via Admin SDK (no client writes)
    // =========================================================================
    match /appointments/{appointmentId} {

      // 📖 READ: Tenant-scoped via companyId
      // 🔐 SECURITY: Only users from the appointment's company
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all appointments
                       isSuperAdminOnly()
                       // OR user belongs to the appointment's company
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // 🚫 WRITE: Server-side only (Admin SDK bypasses rules)
      // Appointments are created by UC-001 pipeline via Admin SDK
      allow write: if false;
    }

    // =========================================================================
    // 📐 PROJECT_FLOORPLANS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 🏢 ENTERPRISE: Floorplans for projects with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    // ⚠️ NOTE: Requires companyId migration - derive from projectId
    // ADR-657 PRESENTATION tier (legacy container) — read tenant-wide + projectId-company fallback
    // (kept as an extra OR-leg, this block only); write internal-only, no ownership grant.
    match /project_floorplans/{floorplanId} {
      allow read: if isAuthenticated()
                  && (
                       canReadLegacyFloorplan()
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                     );
      allow create: if isAuthenticated() && canCreateLegacyFloorplan();
      allow update: if isAuthenticated() && canWriteLegacyFloorplan();
      allow delete: if isAuthenticated() && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 📐 BUILDING_FLOORPLANS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    // ADR-657 PRESENTATION tier (legacy container) — read tenant-wide; write internal-only, no ownership grant.
    match /building_floorplans/{floorplanId} {
      allow read:   if isAuthenticated() && canReadLegacyFloorplan();
      allow create: if isAuthenticated() && canCreateLegacyFloorplan();
      allow update: if isAuthenticated() && canWriteLegacyFloorplan();
      allow delete: if isAuthenticated() && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 📐 FLOOR_FLOORPLANS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 📅 Added: 2026-02-01 (Floor-level floorplan storage)
    // 🏢 ENTERPRISE: Floor-level floorplans with tenant isolation
    // ADR-657 PRESENTATION tier (legacy container). SECURITY FIX: removed the cross-tenant
    // dev-fallback read leg (`!keys().hasAny(['companyId','createdBy'])`) that let ANY authed
    // user of ANY company read docs missing both fields. canReadLegacyFloorplan() replaces it —
    // its no-companyId leg requires createdBy == uid. Write internal-only, no ownership grant.
    match /floor_floorplans/{floorplanId} {
      allow read:   if isAuthenticated() && canReadLegacyFloorplan();
      allow create: if isAuthenticated() && canCreateLegacyFloorplan();
      allow update: if isAuthenticated() && canWriteLegacyFloorplan();
      allow delete: if isAuthenticated() && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 📐 UNIT_FLOORPLANS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    // ADR-657 PRESENTATION tier (legacy container) — read tenant-wide; write internal-only, no ownership grant.
    match /unit_floorplans/{floorplanId} {
      allow read:   if isAuthenticated() && canReadLegacyFloorplan();
      allow create: if isAuthenticated() && canCreateLegacyFloorplan();
      allow update: if isAuthenticated() && canWriteLegacyFloorplan();
      allow delete: if isAuthenticated() && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 🎚️ DXF VIEWER LEVELS — underscore naming (post-rename 2026-04-16)
    // =========================================================================
    // Code: COLLECTIONS.DXF_VIEWER_LEVELS = 'dxf_viewer_levels'
    // Old kebab names (dxf-viewer-levels, dxf-overlay-levels, dxfOverlayLevels) removed.
    // See commit 9344c70f for the rename.
    // Rule for dxf_viewer_levels is at the bottom of this file (near line 3187).

    // =========================================================================
    // 🎨 DXF OVERLAY LEVELS — underscore naming (post-rename 2026-04-16)
    // =========================================================================
    // Code: COLLECTIONS.DXF_OVERLAY_LEVELS = 'dxf_overlay_levels'
    match /dxf_overlay_levels/{levelId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(resource.data.companyId)
                     );

      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              request.resource.data.companyId == getUserCompanyId()
                              && request.resource.data.createdBy == request.auth.uid
                            )
                       );

      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );

      // 📁 Items subcollection
      match /items/{itemId} {
        allow read: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(get(/databases/$(database)/documents/dxf_overlay_levels/$(levelId)).data.companyId)
                       );
        allow create: if isAuthenticated()
                      && request.resource.data.companyId == getUserCompanyId();
        allow update, delete: if isAuthenticated()
                              && (
                                   resource.data.createdBy == request.auth.uid
                                   || isCompanyAdminOfCompany(resource.data.companyId)
                                   || isSuperAdminOnly()
                                 );
      }
    }

    // =========================================================================
    // 🖼️ FLOORPLAN BACKGROUNDS — ADR-340 Phase 7 (Q9 RBAC)
    // =========================================================================
    // Domain entity for raster (PDF/Image) background per κάτοψη ορόφου.
    // RBAC: super_admin / company_admin / internal_user can write/delete.
    // Read: any authenticated user belonging to the document's company.
    // Immutables (D6): companyId, floorId, fileId, providerId, providerMetadata, naturalBounds.
    // ADR-657 PRESENTATION tier — read tenant-wide; write internal-only (ADR-340 semantics, shared vocabulary).
    // Bespoke D6 immutables + scale validator kept verbatim — we share role gates, not field guards.
    match /floorplan_backgrounds/{rbgId} {
      allow read: if isAuthenticated() && canReadBimPresentation(resource.data.companyId);

      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              isInternalUser()
                              && request.resource.data.companyId == getUserCompanyId()
                              && request.resource.data.createdBy == request.auth.uid
                            )
                       );

      allow update: if isAuthenticated()
                    && isBimWriter(resource.data.companyId)
                    // Immutable fields (ADR-340 D6)
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.floorId == resource.data.floorId
                    && request.resource.data.fileId == resource.data.fileId
                    && request.resource.data.providerId == resource.data.providerId
                    && request.resource.data.naturalBounds == resource.data.naturalBounds
                    && request.resource.data.createdBy == resource.data.createdBy
                    // Optional scale calibration (ADR-340 Phase 9 — structural check only)
                    && (
                         !request.resource.data.keys().hasAny(['scale'])
                         || (
                              request.resource.data.scale.unitsPerMeter is number
                              && request.resource.data.scale.unitsPerMeter > 0
                              && (
                                   request.resource.data.scale.sourceUnit == 'mm'
                                   || request.resource.data.scale.sourceUnit == 'cm'
                                   || request.resource.data.scale.sourceUnit == 'm'
                                   || request.resource.data.scale.sourceUnit == 'pixel'
                                 )
                            )
                       );

      allow delete: if isAuthenticated()
                    && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 🖼️ FLOORPLAN OVERLAYS — ADR-340 Phase 9 (multi-kind discriminated union)
    // =========================================================================
    // geometry: discriminated union {polygon|line|circle|arc|dimension|measurement|text}
    // role: semantic {property|parking|storage|footprint|annotation|auxiliary}
    // Immutables (D6): id, companyId, backgroundId, floorId.
    // role↔geometry consistency + linked entity required for role business types.
    match /floorplan_overlays/{ovrlId} {

      function _validGeometryType() {
        let t = request.resource.data.geometry.type;
        return t == 'polygon'
            || t == 'line'
            || t == 'circle'
            || t == 'arc'
            || t == 'dimension'
            || t == 'measurement'
            || t == 'text';
      }

      function _validRole() {
        let r = request.resource.data.role;
        return r == 'property'
            || r == 'parking'
            || r == 'storage'
            || r == 'footprint'
            || r == 'annotation'
            || r == 'auxiliary';
      }

      function _polygonOnlyRole(r) {
        return r == 'property' || r == 'parking' || r == 'storage' || r == 'footprint';
      }

      function _annotationGeometry(t) {
        return t == 'line' || t == 'circle' || t == 'arc'
            || t == 'dimension' || t == 'measurement' || t == 'text';
      }

      // role → allowed geometry.type
      function _roleGeometryConsistent() {
        let r = request.resource.data.role;
        let t = request.resource.data.geometry.type;
        return (_polygonOnlyRole(r) && t == 'polygon')
            || (r == 'annotation' && _annotationGeometry(t))
            || (r == 'auxiliary');
      }

      // role → required linked.<x>Id
      function _linkedConsistent() {
        let r = request.resource.data.role;
        let d = request.resource.data;
        let hasLinked = d.keys().hasAny(['linked']);
        let linked = hasLinked ? d.linked : {};
        let linkedKeys = hasLinked ? linked.keys() : [];
        return (r == 'property'  && hasLinked && linkedKeys.hasAny(['propertyId']) && linked.propertyId is string)
            || (r == 'parking'   && hasLinked && linkedKeys.hasAny(['parkingId'])  && linked.parkingId  is string)
            || (r == 'storage'   && hasLinked && linkedKeys.hasAny(['storageId']) && linked.storageId is string)
            || r == 'footprint' || r == 'annotation' || r == 'auxiliary';
      }

      function _overlayWriteValid() {
        return _validGeometryType()
            && _validRole()
            && _roleGeometryConsistent()
            && _linkedConsistent();
      }

      // ADR-657 PRESENTATION tier — read tenant-wide; write internal-only (shared vocabulary).
      // Bespoke geometry/role discriminated-union guard (_overlayWriteValid) kept verbatim.
      allow read: if isAuthenticated() && canReadBimPresentation(resource.data.companyId);

      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              isInternalUser()
                              && request.resource.data.companyId == getUserCompanyId()
                              && _overlayWriteValid()
                            )
                       );

      allow update: if isAuthenticated()
                    && isBimWriter(resource.data.companyId)
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.backgroundId == resource.data.backgroundId
                    && request.resource.data.floorId == resource.data.floorId
                    && _overlayWriteValid();

      allow delete: if isAuthenticated()
                    && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 🎨 LAYERS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 🏢 ENTERPRISE: Legacy layers for property visualization with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    match /layers/{layerId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📋 LAYER EVENTS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 🏢 ENTERPRISE: Events for layer synchronization with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    match /layer-events/{eventId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🏠 PROPERTY LAYERS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 🏢 ENTERPRISE: Property-specific layers with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    match /property-layers/{layerId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🔐 SECURITY_ROLES COLLECTION - ΚΡΙΣΙΜΟ ΓΙΑ LOGIN!
    // =========================================================================
    // 🏢 ENTERPRISE: Role-based access control για EnterpriseSecurityService
    match /security_roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin/server only
    }

    // =========================================================================
    // 👤 USERS COLLECTION & SESSIONS SUBCOLLECTION
    // =========================================================================
    // 🏢 ENTERPRISE: User profile και active sessions management
    // 🔒 OWNERSHIP-BASED: Κάθε χρήστης μπορεί να διαχειρίζεται ΜΟΝΟ τα δικά του
    match /users/{userId} {
      // 📖 READ: Own profile + same-company users + super admin (SPEC-259B)
      // 🔒 SECURITY: Tenant-scoped — prevents cross-company user enumeration
      // 📅 Updated: 2026-03-23 (SPEC-259B — Firestore Security Hardening)
      allow read: if isAuthenticated()
                  && (
                       // Own profile — always allowed
                       request.auth.uid == userId
                       // Same company — for team/colleague visibility
                       || (resource.data.keys().hasAny(['companyId'])
                           && resource.data.companyId != null
                           && belongsToCompany(resource.data.companyId))
                       // Super admin — system-wide access
                       || isSuperAdminOnly()
                     );

      // =====================================================================
      // 🔒 Ο ΚΑΘΡΕΦΤΗΣ ΠΡΕΠΕΙ ΝΑ ΑΠΟΔΕΙΚΝΥΕΤΑΙ ΚΑΘΡΕΦΤΗΣ  (ADR-787 §5.3)
      // =====================================================================
      //
      // 🔴 ΤΙ ΗΤΑΝ ΕΔΩ ΠΡΙΝ (μετρημένο 2026-08-24): `allow update: uid == userId`
      // **χωρίς καμία allowlist πεδίων** — δηλαδή ο χρήστης έγραφε ΟΤΙΔΗΠΟΤΕ στο
      // δικό του `users/{uid}`. Και **τρία** σημεία του διακομιστή διαβάζουν αυτό
      // το έγγραφο ως **αλήθεια**:
      //
      //   1. `server/auth/pending-registration.ts:113` — αυτο-γραμμένο `companyId`
      //      ⇒ η συνάρτηση επιστρέφει `'assigned'` ⇒ **παρακάμπτεται σιωπηλά όλη
      //      η ροή έγκρισης του ADR-660**.
      //   2. `server/auth/pending-registration.ts:221-232` — `where('companyId')`
      //      + `globalRole ∈ ADMIN_ROLES` ⇒ αυτο-γραμμένος ρόλος ⇒ **λαμβάνει τα
      //      emails ειδοποίησης νέων εγγραφών** (διαρροή διευθύνσεων τρίτων).
      //   3. `api/admin/role-management/users/route.ts:161` — **εμφανίζεται ως
      //      διαχειριστής** στην κονσόλα, όπου άνθρωπος μπορεί να πράξει πάνω του.
      //
      // ✅ **ΔΕΝ ήταν άμεση κλιμάκωση σε claims** — επαληθεύτηκε: το
      // `set-user-claims/claims-handler.ts:64-90` **γράφει** αυτό το έγγραφο
      // (κάτοπτρο) και παίρνει τον ρόλο από το **αίτημα του διαχειριστή**, ποτέ
      // από το έγγραφο. Είναι όμως *confused deputy* με την τεχνική σημασία.
      //
      // ────────────────────────────────────────────────────────────────────
      // ⚠️ ΓΙΑΤΙ Η ΘΕΡΑΠΕΙΑ ΔΕΝ ΕΙΝΑΙ «ΑΠΑΓΟΡΕΥΣΕ ΤΑ ΠΕΔΙΑ»
      // ────────────────────────────────────────────────────────────────────
      //
      // Μετρήθηκε ότι ο **μόνος** πελάτης που γράφει εδώ
      // (`auth/contexts/auth-context/auth-context-profile.ts:44,50-65`) γράφει
      // **σκόπιμα** `companyId` και `globalRole`: κρατά το προφίλ **κάτοπτρο των
      // ΔΙΚΩΝ ΤΟΥ claims** (JIT profile). Σκέτη απαγόρευση θα **έσπαγε κάθε
      // σύνδεση** — και θα ήταν «διόρθωση» που φαίνεται αυστηρή και είναι βλάβη.
      //
      // 🔑 Ένα κάτοπτρο είναι νόμιμο **ακριβώς όταν μπορεί να αποδειχθεί
      // κάτοπτρο**. Οι κανόνες βλέπουν το **υπογεγραμμένο token**, οπότε η
      // απόδειξη είναι διαθέσιμη επιτόπου: η γραμμένη τιμή οφείλει να είναι
      // **ταυτόσημη** με το claim του ίδιου του καλούντος. Ο,τιδήποτε άλλο δεν
      // είναι καθρέφτισμα — είναι **ισχυρισμός**.
      //
      // ⛔ ΜΗΝ προσθέσεις πεδίο στα «ελεύθερα» χωρίς να μετρήσεις ΠΟΙΟΣ ΤΟ
      //    ΔΙΑΒΑΖΕΙ στον διακομιστή. Το ελάττωμα δεν ήταν η εγγραφή· ήταν ότι
      //    κάποιος **την πίστεψε**.

      /** Ταυτίζονται τα προνομιακά πεδία με τα claims του ΙΔΙΟΥ του καλούντος; */
      function mirrorsOwnClaims(data) {
        return data.get('companyId', null) == request.auth.token.get('companyId', null)
               && data.get('globalRole', null) == request.auth.token.get('globalRole', null);
      }

      /**
       * 🔴 ΑΝΑ ΠΕΔΙΟ, ΠΟΤΕ ΣΥΝΟΛΙΚΑ — *πεδίο που δεν άλλαξε δεν είναι ισχυρισμός.*
       *
       * Η πρώτη γραφή απαιτούσε να ταιριάζουν **και τα δύο** προνομιακά πεδία σε
       * κάθε ενημέρωση που άγγιζε **έστω ένα**. Βρέθηκε ζωντανό σενάριο όπου
       * αυτό αρνείται **νόμιμη** εγγραφή:
       *
       *   έγγραφο με `globalRole` που **δεν καθρεφτίστηκε ποτέ** στα claims
       *   (παλαιό έγγραφο, ή το `'admin'` που γράφει το `ensureDevUserProfile`)
       *   → ο χρήστης αλλάζει εταιρεία → ο πελάτης γράφει το **νέο** `companyId`
       *   από το claim αλλά **κρατά** το παλιό `globalRole`
       *   (`auth-context-profile.ts:62-64`: `existingData.globalRole ?? null`
       *   όταν λείπει το claim) ⇒ ο έλεγχος έπεφτε πάνω σε πεδίο που **δεν
       *   άλλαξε καν**, και ο άνθρωπος έμενε κλειδωμένος έξω από το προφίλ του.
       *
       * ⚠️ Είναι **αυστηρότερο εκεί που πρέπει και μόνο εκεί**: κάθε προνομιακό
       * πεδίο που **όντως άλλαξε** οφείλει να ισούται με το claim· κάθε άλλο δεν
       * κρίνεται, γιατί κανείς δεν το διεκδίκησε. Άγκυρα: `Κ10`.
       */
      function changedPrivilegedFieldsMirrorClaims(changed, data) {
        return (!changed.hasAny(['companyId'])
                || data.get('companyId', null) == request.auth.token.get('companyId', null))
               && (!changed.hasAny(['globalRole'])
                   || data.get('globalRole', null) == request.auth.token.get('globalRole', null));
      }

      /**
       * Πεδία που ο πελάτης **δεν γράφει ΠΟΤΕ** — τα γράφει μόνο ο διακομιστής
       * (Admin SDK, που παρακάμπτει αυτούς τους κανόνες).
       *
       * `claimsUpdatedAt`: το διαβάζει το `use-claims-refresh.ts:57` για να
       * επιβάλει ανανέωση token. `permissions`/`status`: τα γράφει ο
       * `claims-handler.ts:82-84`. `uid`/`createdAt`: ταυτότητα και γένεση.
       */
      function serverOwnedUserFields() {
        return ['permissions', 'status', 'uid', 'createdAt',
                'claimsUpdatedAt', 'pendingNotifiedAt', 'requestedAt',
                // 🆕 ADR-798 §7 — ΚΛΕΙΔΩΝΕΤΑΙ ΠΡΙΝ ΥΠΑΡΞΕΙ, ΕΠΙΤΗΔΕΣ.
                //
                // Το επάγγελμα (`profession`/`escoUri`/`escoLabel`/`iscoCode`,
                // ADR-798 Φάση 2) είναι **αυτο-δηλωμένο** και μένει ελεύθερο:
                // δεν δίνει δικαίωμα, κανείς στον διακομιστή δεν το πιστεύει
                // για εξουσιοδότηση (Α4), άρα η ελευθερία του είναι σωστή.
                //
                // 🔴 Η **επαλήθευσή** του ΔΕΝ είναι. Αν ο πελάτης μπορεί να
                // γράψει `occupationVerification`, τότε «επαληθευμένο» σημαίνει
                // «το είπα μόνος μου» — δηλαδή **η διάκριση δηλωμένο ≠
                // επαληθευμένο πεθαίνει τη στιγμή που γεννιέται**, και μαζί της
                // όλο το §7 (ΤΕΕ · ΔΣΑ · ΟΕΕ · EUDI QEAA).
                //
                // ⚠️ Το πεδίο **δεν υπάρχει ακόμη** — και γι' αυτό ακριβώς
                // μπαίνει τώρα: ένα zero-tolerance που κλειδώνει την κατάσταση
                // **πριν** εμφανιστεί δεν χρειάζεται ποτέ μετανάστευση (πρότυπο
                // CHECK 3.43 Κ1). Η Φάση 5 οφείλει να χρησιμοποιήσει **αυτό
                // ακριβώς το όνομα**· αν διαλέξει άλλο, ο φρουρός θα είναι
                // πράσινος και **ανενεργός** (ADR-749 §5, αδρανής φρουρός).
                'occupationVerification',
                // 🆕 ADR-827 §9.20 — ΤΟ ΑΦΜ ΓΡΑΦΕΤΑΙ ΑΠΟ ΤΟΝ ΙΔΙΟ, ΑΛΛΑ **ΜΕΣΩ
                // ΤΟΥ ΔΙΑΚΟΜΙΣΤΗ** — και η διαφορά είναι ο **ελεγκτής ψηφίου**.
                //
                // Ο άνθρωπος **είναι** ο μόνος που το δηλώνει (απόφαση Giorgio
                // 29/08, §9.20 γ) — το γραφείο ποτέ. Αλλά «μόνο ο ίδιος» **δεν
                // αρκεί**: αυτός ο αριθμός μπαίνει σε **σύμβαση** που ο νόμος
                // απαιτεί να τον περιέχει (άρθρο 200 §2 Ν.4072/2012), και
                // ταξιδεύει στο αποτύπωμα της επαφής (§8.3).
                //
                // 🔴 Ο **mod-11 ελεγκτής** του `lib/validation/vat-validation.ts`
                // **ΔΕΝ εκφράζεται εδώ**: οι κανόνες δεν έχουν βρόχο πάνω στα
                // ψηφία. Άρα ελεύθερη πελατική γραφή θα σήμαινε «κάθε εννιάδα
                // ψηφίων είναι ΑΦΜ» — δηλαδή **άκυρη σύμβαση με πράσινη όψη**.
                // ⇒ Η μόνη πόρτα είναι το `/api/account/vat-number`, όπου ο
                // κανονικός επικυρωτής **εκτελείται**.
                //
                // ⚠️ Server-owned **δεν** σημαίνει «ο διακομιστής αποφασίζει τι
                // είναι»: σημαίνει «ο διακομιστής επαληθεύει πριν το γράψει».
                // Η **πηγή** παραμένει ο άνθρωπος.
                'vatNumber'];
      }

      /**
       * ⚠️ `Set.hasAny(List)` — ΠΟΤΕ `List.hasAny(Set)`. Το `affectedKeys()`
       * επιστρέφει **Set**· η αντίστροφη σειρά πετά
       * `Unsupported operation error. Received: list.hasAny(set).` σε χρόνο
       * εκτέλεσης και **αρνείται σιωπηλά** (μάθημα ADR-298 Phase D.2, γρ. ~4829).
       */
      function isHonestSelfUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(serverOwnedUserFields())
               && changedPrivilegedFieldsMirrorClaims(changed, request.resource.data);
      }

      /**
       * Στη **δημιουργία** δεν υπάρχει προηγούμενο έγγραφο να συγκριθεί, άρα
       * κρίνεται το σύνολο: τα προνομιακά πεδία καθρεφτίζουν τα claims, και το
       * `status` — αν δηλωθεί — είναι **μόνο** `active` (η κατάσταση της ταυτότητας).
       * 🔴 ADR-660 §6: μέχρι 2026-09-11 δεχόταν και `'pending'` για χρήστη χωρίς
       * tenant — το «περιμένει έγκριση» ζει πλέον στο `workspace_access_requests`,
       * και καμία πηγή δεν γράφει `'pending'`. Η απουσία επιτρέπεται.
       */
      function isHonestSelfCreate() {
        let d = request.resource.data;
        return mirrorsOwnClaims(d)
               && !d.keys().hasAny(['permissions', 'claimsUpdatedAt'])
               && (!d.keys().hasAny(['status']) || d.status == 'active');
      }

      // 📝 UPDATE: Own profile (ΜΕ απόδειξη καθρέφτη) or company admin
      allow update: if isAuthenticated()
                    && (
                         (request.auth.uid == userId && isHonestSelfUpdate())
                         || (resource.data.keys().hasAny(['companyId'])
                             && resource.data.companyId != null
                             && isCompanyAdminOfCompany(resource.data.companyId))
                       );

      // ✅ CREATE: Own profile (signup, ΜΕ απόδειξη καθρέφτη) or company admin (invite)
      allow create: if isAuthenticated()
                    && (
                         (request.auth.uid == userId && isHonestSelfCreate())
                         || (request.resource.data.keys().hasAny(['companyId'])
                             && request.resource.data.companyId != null
                             && isCompanyAdminOfCompany(request.resource.data.companyId))
                       );

      // 🗑️ DELETE: Απαγορεύεται — user documents δεν σβήνονται
      allow delete: if false;

      // 🔐 SESSIONS SUBCOLLECTION - Enterprise Active Sessions Management
      match /sessions/{sessionId} {
        // Ο χρήστης μπορεί να διαβάζει και να γράφει ΜΟΝΟ τα δικά του sessions
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // 🔐 USER_2FA_SETTINGS COLLECTION - Two-Factor Authentication
    // =========================================================================
    // 🏢 ENTERPRISE: 2FA settings και backup codes storage
    // 🔒 OWNERSHIP-BASED: Κάθε χρήστης μπορεί να διαχειρίζεται ΜΟΝΟ τα δικά του 2FA settings
    match /user_2fa_settings/{userId} {
      // Ο χρήστης μπορεί να διαβάζει και να γράφει ΜΟΝΟ τα δικά του 2FA settings
      allow read, write: if isOwner(userId);
    }

    // =========================================================================
    // 🔔 USER_NOTIFICATION_SETTINGS COLLECTION - Notification Preferences
    // =========================================================================
    // 🏢 ENTERPRISE: User notification preferences management
    // 🔒 OWNERSHIP-BASED: Κάθε χρήστης μπορεί να διαχειρίζεται ΜΟΝΟ τις δικές του ρυθμίσεις
    match /user_notification_settings/{userId} {
      // Ο χρήστης μπορεί να διαβάζει και να γράφει ΜΟΝΟ τις δικές του ρυθμίσεις ειδοποιήσεων
      allow read, write: if isOwner(userId);
    }

    // =========================================================================
    // ⚙️ USER_PREFERENCES COLLECTION - Per-user UI Settings (SSoT)
    // =========================================================================
    // 🏢 ENTERPRISE: Server-side single source of truth for ALL UI settings
    // (cursor / crosshair / selection / rulers / grid / dxf line+text+grip / snap).
    // 📅 Created: 2026-05-08 (industry-standard pattern: Google Drive / Procore / SAP UME)
    //
    // Doc ID convention: deterministic composite `{userId}_{companyId}` so each
    // user has exactly one preferences blob per tenant. The body MUST carry
    // both `userId` and `companyId` fields matching the auth context.
    //
    // 🔒 PATH-BASED OWNERSHIP: the docId itself encodes the owner — we check
    // it starts with `{auth.uid}_`. This works for non-existent docs too
    // (which is required for the snapshot listener to resolve before first
    // write — `resource.data` is null on a non-existent doc).
    match /user_preferences/{docId} {
      // 📖 READ: docId must start with caller's uid (works for non-existent docs)
      allow read: if isAuthenticated()
                  && docId.matches('^' + request.auth.uid + '_.+');

      // ✍️ CREATE: caller must own the docId path AND set body userId/companyId
      //    matching auth context, with valid schemaVersion.
      allow create: if isAuthenticated()
                    && docId.matches('^' + request.auth.uid + '_.+')
                    && request.resource.data.keys().hasAll(['userId', 'companyId', 'schemaVersion'])
                    && isOwner(request.resource.data.userId)
                    && belongsToCompany(request.resource.data.companyId)
                    && request.resource.data.schemaVersion is number;

      // ✍️ UPDATE: ownership via docId; userId / companyId / schemaVersion floor invariants.
      allow update: if isAuthenticated()
                    && docId.matches('^' + request.auth.uid + '_.+')
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.schemaVersion >= resource.data.schemaVersion;

      // 🗑️ DELETE: ownership via docId (rare — used only for account cleanup)
      allow delete: if isAuthenticated()
                    && docId.matches('^' + request.auth.uid + '_.+');
    }

    // =========================================================================
    // 🏢 WORKSPACES COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 🏢 ENTERPRISE: Workspaces are company-scoped
    match /workspaces/{workspaceId} {
      // 📖 READ: Tenant-scoped (SPEC-259B — legacy fallback removed)
      // 🔒 SECURITY: Only same-company users or super admin
      // 📅 Updated: 2026-03-23 (SPEC-259B — removed dangerous legacy fallback)
      // ℹ️ Pre-check: 0 workspaces without companyId (2026-03-23)
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ WRITE: Admin/server only (via Firebase Admin SDK)
      allow write: if false;
    }

    // =========================================================================
    // 📞 CONTACTS COLLECTION - ENTERPRISE TENANT ISOLATION (ADR-029)
    // =========================================================================
    // 🏢 ENTERPRISE: Multi-tenant security via companyId field
    // 📅 Updated: 2026-01-26 (Global Search v1 - Tenant Isolation Fix)
    //
    // Security Model:
    //   - READ: Only users from the same company (tenant-scoped)
    //   - CREATE: Authenticated users, companyId auto-set from claims
    //   - UPDATE: Creator or company admin
    //   - DELETE: Creator or company admin
    // =========================================================================
    match /contacts/{contactId} {

      // 📖 READ: Tenant-scoped - only users from the contact's company
      // 🔒 SECURITY: Prevents cross-tenant data leak
      // 🏢 ENTERPRISE: Follows SAP/Salesforce/Microsoft multi-tenant patterns
      allow read: if isAuthenticated()
                  && (
                       // Super admin can read all contacts
                       isSuperAdminOnly()
                       // OR user belongs to the contact's company
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: Contacts without companyId readable by creator only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: Authenticated users with companyId from claims
      // 🔐 SECURITY: companyId MUST match user's company claim (no cross-tenant creation)
      // 🏢 EXCEPTION: Super Admin can create contacts for any company (same as projects)
      allow create: if isAuthenticated()
                    && isValidContactData(request.resource.data)
                    && resource == null
                    && (
                         // Super Admin can create for any company
                         isSuperAdminOnly()
                         // OR user creates for their own company
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: Creator or company admin of contact's company
      // 🔒 SECURITY: Prevents cross-tenant modification
      // 🏢 ENTERPRISE: isValidContactData + isAttemptingToModifySystemFields removed from update rule
      //    - isValidContactData: updateDoc partial writes cause false negatives on field checks
      //    - isAttemptingToModifySystemFields: diff() fails on complex updateDoc payloads
      //    Both are enforced at CREATE time + client-side cleanup in contacts.service.ts
      allow update: if isAuthenticated()
                    && (
                         // Creator can always update their contacts
                         resource.data.createdBy == request.auth.uid
                         // OR company admin can update contacts in their company
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         // OR super admin can update any contact
                         || isSuperAdminOnly()
                         // 🔄 LEGACY FALLBACK: Contacts without createdBy can be updated by same-company users
                         || (!resource.data.keys().hasAny(['createdBy']) && belongsToCompany(resource.data.companyId))
                       )
                    // Prevent changing companyId (no re-tenanting)
                    && request.resource.data.companyId == resource.data.companyId;

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );

      // =====================================================================
      // 🏦 BANK ACCOUNTS SUBCOLLECTION - INHERITS PARENT TENANT ISOLATION
      // =====================================================================
      // 🏢 ENTERPRISE: Bank accounts for contacts (2026-02-01)
      // 📁 Path: contacts/{contactId}/bank_accounts/{accountId}
      // 🔒 SECURITY: Inherits access from parent contact document
      // =====================================================================
      match /bank_accounts/{accountId} {

        // Helper: Check if user can access parent contact
        function canAccessParentContact() {
          let parentContact = get(/databases/$(database)/documents/contacts/$(contactId)).data;
          return isAuthenticated()
                 && (
                      isSuperAdminOnly()
                      || (parentContact.keys().hasAny(['companyId'])
                          && belongsToCompany(parentContact.companyId))
                      || (!parentContact.keys().hasAny(['companyId'])
                          && parentContact.createdBy == request.auth.uid)
                    );
        }

        // 📖 READ: Same access as parent contact
        allow read: if canAccessParentContact();

        // ✍️ CREATE: Users who can access parent contact
        allow create: if canAccessParentContact()
                      && request.resource.data.keys().hasAll(['bankName', 'iban', 'accountType', 'currency', 'isPrimary', 'isActive'])
                      && request.resource.data.iban is string
                      && request.resource.data.iban.size() >= 15;

        // 📝 UPDATE: Users who can access parent contact
        allow update: if canAccessParentContact()
                      && request.resource.data.keys().hasAll(['bankName', 'iban', 'accountType', 'currency', 'isPrimary', 'isActive']);

        // 🗑️ DELETE: Users who can access parent contact
        allow delete: if canAccessParentContact();
      }
    }

    // =========================================================================
    // =========================================================================
    // 💬 COMMUNICATIONS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 🏢 ENTERPRISE: Legacy CRM communications with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // ⚠️ NOTE: Requires companyId migration for legacy docs
    match /communications/{communicationId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // ⚙️ SYSTEM COLLECTION - ADMIN-ONLY READ (ADR-252 FR-M1)
    // =========================================================================
    // 🏢 ENTERPRISE: System-wide configuration and templates
    // 📅 Updated: 2026-03-20 (ADR-252 FR-M1 — restrict to company admin)
    // 🔒 SECURITY: System config contains sensitive routing rules, integrations
    // NOTE: Merged duplicate block (was at lines ~1442 and ~2549)
    match /system/{docId} {
      allow read: if isAuthenticated() && isCompanyAdmin();
      allow write: if false; // Admin/server only

      // 📁 Subcollections (e.g., project-templates)
      match /{subcollection}/{subDocId} {
        allow read: if isAuthenticated() && isCompanyAdmin();
        allow write: if false; // Admin/server only
      }
    }

    // =========================================================================
    // ⚙️ CONFIG COLLECTION - APPLICATION CONFIGURATION
    // =========================================================================
    // 🏢 ENTERPRISE: Application configuration
    // 📅 Added: 2026-01-17 (Permission-denied fix)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin/server only
    }

    // =========================================================================
    // 🎯 CRM CORE — LEADS · OPPORTUNITIES · ACTIVITIES
    // =========================================================================
    // 🏢 ENTERPRISE: CRM με απομόνωση tenant μέσω `companyId`
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 — PR-1B / PR-1D)
    // 🔀 Merged:  2026-09-08 (ADR-841 §7 Α21.14.8) — ΕΝΑ μπλοκ ανά διαδρομή
    //
    // 🔴 Μέχρι σήμερα κάθε μία από τις τρεις είχε ΔΥΟ `match` μπλοκ, γεννημένα σε
    //    δύο PR της ίδιας εκστρατείας. Το Firestore ΕΝΩΝΕΙ τα μπλοκ που ταιριάζουν
    //    ⇒ το δεύτερο (PR-1D) δεν ίσχυσε ΠΟΤΕ. Τα κοινά κατηγορήματα ζουν πλέον
    //    στους βοηθούς `crm*()` (βλ. «CRM MODULE — OWNER-AWARE …» παρακάτω στο
    //    αρχείο)· εδώ μένει ΜΟΝΟ η πολιτική της κάθε συλλογής, ορατή με μια ματιά.
    //
    // ⚠️ Η ΑΣΥΜΜΕΤΡΙΑ ΕΙΝΑΙ ΣΚΟΠΙΜΗ, ΜΕΤΡΗΜΕΝΗ ΚΑΙ ΚΑΡΦΩΜΕΝΗ: ΜΟΝΟ το `leads`
    //    δίνει πρόσβαση στον ανατεθειμένο. Έτσι ήταν και ΠΡΙΝ την ένωση — η ένωση
    //    ΔΕΝ αλλάζει πρόσβαση παραγωγής, σε κανένα από τα 9 μετρημένα σενάρια.
    //    🔓 ΑΝΟΙΧΤΟ ΕΡΩΤΗΜΑ (ADR-841 §7 Α21.14.8): κατά Salesforce/HubSpot/Zoho το
    //    ίδιο θα έπρεπε να ισχύει και για `opportunities` / `activities` — και το
    //    `Opportunity.assignedTo` είναι ΥΠΟΧΡΕΩΤΙΚΟ πεδίο (`src/types/crm.ts:37`),
    //    δηλαδή ο ανατεθειμένος πωλητής ΔΕΝ μπορεί να ενημερώσει τη δική του
    //    ευκαιρία. Είναι ΔΙΕΥΡΥΝΣΗ πρόσβασης παραγωγής, άρα ΞΕΧΩΡΙΣΤΗ απόφαση —
    //    όχι λαθραία μέσα σε refactor. Καρφωμένο ως γεγονός στις τρεις σουίτες.

    match /leads/{leadId} {
      // 📖 READ: tenant-scoped· legacy fallback για δημιουργό Ή ανατεθειμένο.
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || crmInTenant(resource.data)
                       || (crmIsLegacy(resource.data)
                           && (crmIsCreator(resource.data) || crmIsAssignee(resource.data)))
                     );

      // ✍️ CREATE: `companyId` του φορτίου == του καλούντος.
      allow create: if crmCanCreate();

      // 📝 UPDATE: + Ο ΑΝΑΤΕΘΕΙΜΕΝΟΣ — δουλεύει το lead που του δόθηκε.
      allow update: if isAuthenticated()
                    && resource != null
                    && (crmWriterIsPrivileged(resource.data)
                        || (crmIsAssignee(resource.data) && crmNotForeignTenant(resource.data)))
                    && crmCompanyIdUnchanged(resource.data);

      // 🗑️ DELETE: ΟΧΙ ο ανατεθειμένος — η ανάθεση δίνει το δικαίωμα να το
      //    δουλέψεις, όχι να το εξαφανίσεις.
      allow delete: if isAuthenticated()
                    && resource != null
                    && crmWriterIsPrivileged(resource.data);
    }

    match /opportunities/{opportunityId} {
      // 📖 READ: tenant-scoped· legacy fallback ΜΟΝΟ για δημιουργό (βλ. ⚠️ πιο πάνω).
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || crmInTenant(resource.data)
                       || (crmIsLegacy(resource.data) && crmIsCreator(resource.data))
                     );

      allow create: if crmCanCreate();

      allow update: if isAuthenticated()
                    && resource != null
                    && crmWriterIsPrivileged(resource.data)
                    && crmCompanyIdUnchanged(resource.data);

      allow delete: if isAuthenticated()
                    && resource != null
                    && crmWriterIsPrivileged(resource.data);
    }

    match /activities/{activityId} {
      // 📖 READ: tenant-scoped· legacy fallback ΜΟΝΟ για δημιουργό (βλ. ⚠️ πιο πάνω).
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || crmInTenant(resource.data)
                       || (crmIsLegacy(resource.data) && crmIsCreator(resource.data))
                     );

      allow create: if crmCanCreate();

      allow update: if isAuthenticated()
                    && resource != null
                    && crmWriterIsPrivileged(resource.data)
                    && crmCompanyIdUnchanged(resource.data);

      allow delete: if isAuthenticated()
                    && resource != null
                    && crmWriterIsPrivileged(resource.data);
    }

    // =========================================================================
    // 💬 CONVERSATIONS - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 🏢 ENTERPRISE: Telegram/email conversations για CRM with tenant isolation
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // ⚠️ NOTE: Requires companyId migration for legacy docs
    match /conversations/{conversationId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: creator or participant
                       || (!resource.data.keys().hasAny(['companyId'])
                           && (resource.data.createdBy == request.auth.uid
                               || resource.data.assignedTo == request.auth.uid))
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && isValidConversationData(request.resource.data)
                    && request.resource.data.companyId == getUserCompanyId()
                    && resource == null;

      // 📝 UPDATE: Creator, assignee, or company admin
      allow update: if isAuthenticated()
                    && isValidConversationData(request.resource.data)
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || resource.data.assignedTo == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 💬 MESSAGES - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 🏢 ENTERPRISE: Messages stored in ROOT collection with tenant isolation
    // Architecture: messages/{messageId} with conversationId field
    // 📋 REAL-TIME UPDATES: Supports Firestore onSnapshot για instant message updates
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    match /messages/{messageId} {
      // 📖 READ: Tenant-scoped via companyId or conversation lookup
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: sender only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.senderId == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && isValidMessageData(request.resource.data)
                    && request.resource.data.companyId == getUserCompanyId()
                    && resource == null;

      // 📝 UPDATE: Sender or company admin
      allow update: if isAuthenticated()
                    && isValidMessageData(request.resource.data)
                    && resource != null
                    && (
                         resource.data.senderId == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Sender or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.senderId == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🔐 EXTERNAL IDENTITIES - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 🏢 ENTERPRISE: Maps external platform IDs (Telegram chatId) to internal contacts
    // ⚠️ NOTE: Requires companyId migration for legacy docs
    match /external_identities/{identityId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId()
                    && resource == null;

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // ⚙️ CONFIG - DUPLICATE REMOVED (ADR-252 Security Fix)
    // =========================================================================
    // 📅 Removed: 2026-03-20 — This was a DANGEROUS duplicate with open writes
    // 🔒 SECURITY: The first config block (above) has `allow write: if false`
    //    but this duplicate had `allow create, update, delete: if isAuthenticated()`
    //    Firestore uses most-permissive-wins, so ANY auth user could write config!
    // =========================================================================

    // =========================================================================
    // 🔗 RELATIONSHIPS - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 🏢 ENTERPRISE: General-purpose relationships between entities with tenant isolation
    // ⚠️ Note: contact_relationships has separate, more strict rules above
    match /relationships/{relationshipId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId()
                    && resource == null;

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🔐 SECURITY POLICIES - EMAIL DOMAIN & COUNTRY RESTRICTIONS
    // =========================================================================
    // 📅 Added: 2026-01-17 (Permission-denied fix - CRITICAL collection)
    // 🏢 ENTERPRISE: EnterpriseSecurityService policy collections (READ-ONLY for clients)
    match /email_domain_policies/{policyId} {
      // 📖 READ: Authenticated users (security validation needs this)
      allow read: if isAuthenticated();
      // 🚫 WRITE: Server-side only (via Admin SDK)
      allow write: if false;
    }

    match /country_security_policies/{policyId} {
      // 📖 READ: Authenticated users (security validation needs this)
      allow read: if isAuthenticated();
      // 🚫 WRITE: Server-side only (via Admin SDK)
      allow write: if false;
    }

    // =========================================================================
    // 🔢 COUNTERS - PROJECT CODE GENERATION
    // =========================================================================
    // 📅 Added: 2026-01-17 (Permission-denied fix - HIGH priority)
    // 🏢 ENTERPRISE: Auto-increment counters for project codes, etc.
    match /counters/{counterId} {
      // 📖 READ: Authenticated users (need to read current counter)
      allow read: if isAuthenticated();
      // ✍️ WRITE: Authenticated users (increment on create)
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 📊 ANALYTICS - ENTERPRISE TENANT ISOLATION (PR-1B)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1B)
    // 🏢 ENTERPRISE: SendGrid webhook analytics with tenant isolation
    match /analytics/{analyticsId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // Legacy fallback: creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📋 OBLIGATIONS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Obligations with tenant isolation via project lookup
    //
    // Security Model:
    //   - READ: Tenant-scoped via projectId→company or companyId
    //   - CREATE: companyId required from claims
    //   - UPDATE: Creator or company admin, companyId immutable
    //   - DELETE: Creator or company admin
    // =========================================================================
    match /obligations/{obligationId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       // Direct companyId check
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // OR via projectId lookup
                       || (resource.data.keys().hasAny(['projectId'])
                           && resource.data.projectId is string
                           && belongsToProjectCompany(resource.data.projectId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['companyId', 'projectId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📤 OBLIGATION_TRANSMITTALS COLLECTION - ENTERPRISE TENANT ISOLATION
    // =========================================================================
    // Security Model:
    //   - READ: Tenant-scoped via companyId
    //   - CREATE: companyId required from claims
    //   - UPDATE/DELETE: creator or company admin
    // =========================================================================
    match /obligation_transmittals/{transmittalId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.companyId == getUserCompanyId();

      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📋 OBLIGATION_TEMPLATES COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Templates are company-scoped
    // =========================================================================
    match /obligation_templates/{templateId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📋 OBLIGATION-SECTIONS COLLECTION - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Sections are company-scoped (linked to templates)
    // =========================================================================
    match /obligation-sections/{sectionId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🤖 BOT_CONFIGS - TELEGRAM BOT CONFIGURATIONS
    // =========================================================================
    // 📅 Added: 2026-01-17 (Permission-denied fix - MEDIUM priority)
    match /bot_configs/{configId} {
      allow read: if isAuthenticated();
      // 🚫 WRITE: Server-side only (sensitive bot tokens)
      allow write: if false;
    }

    // =========================================================================
    // 🗂️ LAYER GROUPS - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    // 🏢 ENTERPRISE: DXF layer management with tenant isolation
    match /layer_groups/{groupId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 🗺️ FLOORPLANS - ENTERPRISE TENANT ISOLATION (PR-1C)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1C)
    // 🏢 ENTERPRISE: Floor plan storage with tenant isolation
    // ADR-657 PRESENTATION tier (legacy container) — read tenant-wide; write internal-only, no ownership grant.
    match /floorplans/{floorplanId} {
      allow read:   if isAuthenticated() && canReadLegacyFloorplan();
      allow create: if isAuthenticated() && canCreateLegacyFloorplan();
      allow update: if isAuthenticated() && canWriteLegacyFloorplan();
      allow delete: if isAuthenticated() && isBimWriter(resource.data.companyId);
    }

    // =========================================================================
    // 📝 AUDIT COLLECTIONS - SECURITY & COMPLIANCE
    // =========================================================================
    // 📅 Added: 2026-01-17 (Permission-denied fix - HIGH priority)
    // 🏢 ENTERPRISE: Audit logs are READ-ONLY for clients (write via Admin SDK)
    match /relationship_audit/{auditId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only
    }

    // =========================================================================
    // 📜 ENTITY_AUDIT_TRAIL - CANONICAL ENTITY CHANGE LOG (ADR-195 Phase 10)
    // =========================================================================
    // 📅 Added: 2026-04-11 (ADR-195 Phase 10 — Client-side onSnapshot SSoT)
    // 🏢 ENTERPRISE: Canonical source of truth for every entity mutation.
    //    Client hooks subscribe DIRECTLY via Firestore onSnapshot (no HTTP
    //    polling, no manual RealtimeService event lists). Firestore rules are
    //    the sole authorization layer.
    // 🔒 READ: Tenant-scoped + admin-only (super_admin | company_admin). No
    //    downgrade to plain authenticated reads — audit data is sensitive.
    // 🚫 WRITE: Server-only via Firebase Admin SDK (EntityAuditService).
    //    Admin SDK bypasses rules, so `allow write: if false` is safe.
    // 📎 SSoT: See `.ssot-registry.json` → `entity-audit-trail` module.
    //    Canonical reader: `src/services/entity-audit-client.service.ts`.
    match /entity_audit_trail/{auditId} {
      allow read: if isAuthenticated()
                  && (
                       // Super admin sees all audit entries (bypasses tenant check)
                       isSuperAdminOnly()
                       // OR company admin of the audit entry's company
                       || (resource.data.keys().hasAny(['companyId'])
                           && isCompanyAdminOfCompany(resource.data.companyId)
                           && belongsToCompany(resource.data.companyId))
                     );
      allow write: if false; // Server-side only (Admin SDK)
    }

    // =========================================================================
    // 📒 ENTITY_AUDIT_TRAIL_PERSONAL - PERSONAL LEDGER OF THE SAME SYSTEM (ADR-864 Φ1β)
    // =========================================================================
    // 📅 Added: 2026-09-16 (ADR-864 Φ1β · ADR-195 §«Προσωπικό βιβλίο»)
    // 🏢 Το ΙΔΙΟ σύστημα ιστορικού (ίδια υπηρεσία, ίδιο σχήμα, ίδιος αναγνώστης), σε ΞΕΧΩΡΙΣΤΟ
    //    διαμέρισμα για τον άνθρωπο χωρίς (ή έξω από) εταιρεία — `src/lib/audit/audit-ledger.ts`.
    // 🔒 READ: ΜΟΝΟ ο κάτοχος του βιβλίου (`userId == auth.uid`). ΟΥΤΕ admin εταιρείας
    //    (ADR-787 Ε-3 §8) ΟΥΤΕ super admin — ίδια ορατότητα με το ίδιο το έγγραφο: ο κανόνας
    //    `owner_properties` δεν δίνει ούτε σε εκείνον. Πρότυπο GitHub (personal security log:
    //    μόνο ο κάτοχος) · Figma (ο admin δεν βλέπει Drafts). Υποστήριξη = Admin SDK.
    // 🔑 ΓΙΑΤΙ ΔΙΑΜΕΡΙΣΜΑ ΚΑΙ ΟΧΙ ΚΛΑΔΟΣ ΣΤΟΝ ΠΑΡΑΠΑΝΩ ΚΑΝΟΝΑ: οι κανόνες ΔΕΝ φιλτράρουν — ένα
    //    «όχι οι προσωπικές» για τον super admin θα απέρριπτε ΟΛΟΚΛΗΡΟ το αφιλτράριστο ερώτημά
    //    του. Έτσι ο εταιρικός κανόνας έμεινε ΑΝΕΓΓΙΧΤΟΣ.
    // 🚫 WRITE: Server-only via Firebase Admin SDK (EntityAuditService).
    match /entity_audit_trail_personal/{auditId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only (Admin SDK)
    }

    // =========================================================================
    // 📍 ADDRESS_CORRECTIONS_LOG - GEOCODING TELEMETRY (ADR-332 §3.7 Phase 9)
    // =========================================================================
    // 📅 Added: 2026-05-06 (ADR-332 Phase 9 — Telemetry + Hierarchy Validation)
    // 🏢 ENTERPRISE: Logs every meaningful correction inside the AddressEditor
    //    coordinator. Feeds analytics + AI ranking-rule learning loop.
    // 🔒 READ: Tenant-scoped (any authenticated user of the correction's
    //    company). Cross-tenant denied. Super admin bypasses tenant check.
    // 🚫 WRITE: Server-only via Firebase Admin SDK (telemetry service).
    //    Admin SDK bypasses rules, so `allow write: if false` is safe.
    // 📎 Canonical writer: src/services/geocoding/address-corrections-telemetry.service.ts
    // 📎 SSoT: ADR-294 — register `address-editor` module (already present)
    // ⚙️ Indexes: (companyId, timestamp DESC) + (companyId, contextEntityType, timestamp DESC)
    match /address_corrections_log/{aclId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );
      allow write: if false; // Server-side only (Admin SDK)
    }

    // =========================================================================
    // 🏢 ADMIN_BUILDING_TEMPLATES - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Building templates with tenant isolation
    // =========================================================================
    match /admin_building_templates/{templateId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin, companyId immutable
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only
    }

    // =========================================================================
    // 📄 FILE_AUDIT_LOG - ENTERPRISE FILE AUDIT TRAIL (ADR-191 Phase 3.1)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 📅 Updated: 2026-03-20 (ADR-255 SPEC-255A — Tenant Isolation)
    // 🏢 ENTERPRISE: Records every file operation for compliance traceability
    // 🔒 READ: Tenant-scoped (companyId match)
    // ✏️ CREATE: Tenant-scoped (companyId required)
    match /file_audit_log/{logId} {
      allow read: if isAuthenticated()
                  && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      allow update, delete: if false; // Audit logs are immutable
    }

    // =========================================================================
    // 📒 FILE_AUDIT_LOG_PERSONAL — Η ΔΡΑΣΤΗΡΙΟΤΗΤΑ ΤΩΝ ΠΡΟΣΩΠΙΚΩΝ ΑΡΧΕΙΩΝ (ADR-866 §2.6.11)
    // =========================================================================
    // 📅 Added: 2026-09-18 (ADR-866 Φ0 βήμα 2β.4)
    // 🏢 ΤΟ ΙΔΙΟ σύστημα με το `file_audit_log` (λεξιλόγιο · σχήμα · αναγνώστης · οθόνη), σε ΞΕΧΩΡΙΣΤΟ
    //    διαμέρισμα με κάτοχο `userId` (`FILE_AUDIT_COLLECTION`, `lib/files/file-custody.ts`) — το
    //    πρότυπο του `entity_audit_trail_personal`. Γιατί διαμέρισμα και όχι κλάδος: οι κανόνες δεν
    //    φιλτράρουν (ADR-195 §7.3) — ο εταιρικός κανόνας έμεινε ΑΝΕΓΓΙΧΤΟΣ.
    // 🔒 READ: ΜΟΝΟ ο κάτοχος. ΟΥΤΕ admin εταιρείας ΟΥΤΕ super admin — ο κανόνας `files_personal`
    //    δεν τους δίνει ούτε το ίδιο το αρχείο· το ίχνος του δεν γίνεται πιο ορατό από αυτό.
    // ✍️ CREATE: ΜΟΝΟ ζευγαρωμένη με την αλλαγή που περιγράφει (`personalActivityMatchesChange`),
    //    ως ο ΙΔΙΟΣ (`performedBy == uid`), με χρόνο ΔΙΑΚΟΜΙΣΤΗ, χωρίς `companyId`. Οι πράξεις του
    //    διακομιστή (εκκαθάριση · διαδοχή έκδοσης) γράφονται με Admin SDK (`recordFileAudit`).
    // 🚫 UPDATE/DELETE: ποτέ από πελάτη — αμετάβλητο (η ΓΚΠΔ διαγραφή είναι Admin SDK).
    match /file_audit_log_personal/{logId} {
      allow get, list: if isAuthenticated()
                       && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(
                         ['fileId', 'action', 'performedBy', 'userId', 'timestamp', 'metadata'])
                    && request.resource.data.keys().hasAll(
                         ['fileId', 'action', 'performedBy', 'userId', 'timestamp'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.performedBy == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.fileId is string
                    && (!request.resource.data.keys().hasAny(['metadata'])
                        || request.resource.data.metadata is map)
                    && personalActivityMatchesChange(
                         request.resource.data.fileId, logId, request.resource.data.action);
      allow update, delete: if false; // Αμετάβλητο
    }

    // =========================================================================
    // 🔗 FILE_SHARES - ENTERPRISE SHAREABLE LINKS (ADR-191 Phase 4.2)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 📅 Updated: 2026-03-20 (ADR-252 FR-C2 — tenant isolation on write)
    // 🏢 ENTERPRISE: Shareable file links with expiration and password
    // 🔒 READ: Public (for share token validation on /shared/[token] page)
    // ✏️ WRITE: Tenant-scoped (companyId required)
    match /file_shares/{shareId} {
      // 📖 READ: Public (for share token validation on /shared/[token] page)
      // 🔒 SECURITY: Share links must remain publicly readable for anonymous access
      allow read: if true;
      // ✍️ CREATE: Authenticated users with companyId enforcement
      // 🔒 SECURITY (ADR-252 FR-C2): Was `isAuthenticated()` → now enforces companyId
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId', 'createdBy'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Authenticated tenant member OR public download counter
      // SECURITY: Public can ONLY increment downloadCount and lastDownloadedAt
      allow update: if (isAuthenticated()
                        && (isSuperAdminOnly()
                            || belongsToCompany(resource.data.companyId)))
                    || (
                         // Public can only increment download counter
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['downloadCount', 'lastDownloadedAt'])
                       );
      // 🗑️ DELETE: Creator only
      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }

    // =========================================================================
    // 🔗 SHARES - UNIFIED POLYMORPHIC SHARES (ADR-315 Phase M1+)
    // =========================================================================
    // 📅 Added: 2026-04-18 (ADR-315 - Unified Sharing)
    // 🏢 ENTERPRISE: Polymorphic shares for file / contact / property_showcase
    // 🔒 READ: Public (token validation on /shared/[token] — any entityType)
    // ✏️ WRITE: Tenant-scoped (companyId + entityType + createdBy required)
    match /shares/{shareId} {
      // 📖 READ: Public — token is 190-bit entropy, acts as capability
      allow read: if true;
      // ✍️ CREATE: Authenticated users with tenant enforcement
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId', 'createdBy', 'entityType', 'entityId', 'token'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Authenticated tenant member OR public access counter increment
      // SECURITY: Public can ONLY bump accessCount + lastAccessedAt (no revoke)
      allow update: if (isAuthenticated()
                        && (isSuperAdminOnly()
                            || belongsToCompany(resource.data.companyId)))
                    || (
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['accessCount', 'lastAccessedAt'])
                       );
      // 🗑️ DELETE: Creator only — prefer revoke (isActive=false) over delete
      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }

    // =========================================================================
    // 📮 SHARE_DISPATCHES — Unified Share Dispatch Audit Log (ADR-315)
    // =========================================================================
    // 📅 Added: 2026-04-18
    // 🏢 ENTERPRISE: Append-only audit of one-shot sends (email/telegram/etc.)
    match /share_dispatches/{dispatchId} {
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || belongsToCompany(resource.data.companyId));
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId', 'createdBy', 'channel'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      allow update: if false; // Immutable audit
      allow delete: if isSuperAdminOnly();
    }

    // =========================================================================
    // 📸 PHOTO_SHARES — CRM Contact Channel Share History
    // =========================================================================
    // 📅 Added: 2026-04-09 — Photo Share History Feature
    match /photo_shares/{shareId} {
      // 📖 READ: Authenticated tenant members only
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || belongsToCompany(resource.data.companyId));
      // ✍️ CREATE: Authenticated with companyId + contactId enforcement
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId', 'createdBy', 'contactId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Immutable records — no updates
      allow update: if false;
      // 🗑️ DELETE: Super admin only
      allow delete: if isSuperAdminOnly();
    }

    // =========================================================================
    // 💬 FILE_COMMENTS - INLINE COMMENTS (ADR-191 Phase 4.3)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 📅 Updated: 2026-03-20 (ADR-255 SPEC-255A — Tenant Isolation)
    // 🏢 ENTERPRISE: Threaded comments on file documents
    // 🔒 READ/WRITE: Tenant-scoped (companyId required)
    match /file_comments/{commentId} {
      allow read: if isAuthenticated()
                  && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['companyId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      allow update: if isAuthenticated()
                    && belongsToCompany(resource.data.companyId)
                    && request.resource.data.authorId == resource.data.authorId; // Only author can edit
      allow delete: if isAuthenticated()
                    && belongsToCompany(resource.data.companyId)
                    && resource.data.authorId == request.auth.uid; // Only author can delete
    }

    // =========================================================================
    // ✅ FILE_APPROVALS - DOCUMENT APPROVAL WORKFLOWS (ADR-191 Phase 3.3)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 🏢 ENTERPRISE: Multi-step approval chains for documents
    // 🔒 READ/WRITE: Authenticated users only
    match /file_approvals/{approvalId} {
      // 📖 READ: Tenant-scoped — only users from the approval's company
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );
      // ✍️ CREATE: Authenticated users with companyId matching their company
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAny(['companyId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Authenticated users from the same company (approve/reject)
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                       );
      allow delete: if false; // Approvals are immutable records
    }

    // =========================================================================
    // 📦 DOCUMENT_TEMPLATES - REUSABLE TEMPLATES (ADR-191 Phase 4.1)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 🏢 ENTERPRISE: Document templates with variable interpolation
    // 🔒 READ/WRITE: Authenticated users only
    match /document_templates/{templateId} {
      // 📖 READ: Tenant-scoped — only users from the template's company
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );
      // ✍️ CREATE: Authenticated users with companyId matching their company
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAny(['companyId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Creator or same company member
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                       );
      // 🗑️ DELETE: Creator or same company member
      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                       );
    }

    // =========================================================================
    // 🔔 FILE_WEBHOOKS - WEBHOOK REGISTRATIONS (ADR-191 Phase 5.4)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 🏢 ENTERPRISE: Webhook subscriptions for document events
    // 🔒 Server-side only (managed via API routes)
    match /file_webhooks/{webhookId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // =========================================================================
    // 📁 FILE_FOLDERS - VIRTUAL FOLDER STRUCTURE (ADR-191 Phase 4.4)
    // =========================================================================
    // 📅 Added: 2026-03-09 (ADR-191 - Enterprise Document Management)
    // 🏢 ENTERPRISE: Virtual folders for file organization
    // 🔒 READ/WRITE: Authenticated users only
    match /file_folders/{folderId} {
      // 📖 READ: Tenant-scoped — only users from the folder's company
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );
      // ✍️ CREATE: Authenticated users with companyId matching their company
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAny(['companyId'])
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Same company member
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                       );
      // 🗑️ DELETE: Same company member
      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                       );
    }

    match /system_audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only
    }

    // =========================================================================
    // 🔒 ASSET_PACK_CONFIG — Ο ΔΙΑΚΟΠΤΗΣ ΔΙΑΝΟΜΗΣ (ADR-655)
    // =========================================================================
    // Doc: asset_pack_config/{packId} → { status: 'public'|'entitled'|'disabled' }
    //
    // Αυτό είναι το «κόψε τη βρύση» control. Ζει σε δεδομένα (όχι σε κώδικα) ώστε ο διακόπτης
    // να γυρίζει σε δευτερόλεπτα, χωρίς build/deploy.
    //
    // 🚫 ΚΑΜΙΑ πρόσβαση από client — ούτε ΑΝΑΓΝΩΣΗ: αν ο client μπορούσε να το διαβάσει, θα
    // μπορούσε να διαπιστώσει την κατάσταση κάθε πακέτου· η πύλη διαβάζει server-side με Admin
    // SDK (που παρακάμπτει τους rules). Το UI μαθαίνει τι δικαιούται ΜΟΝΟ από το /api/asset-packs.
    // =========================================================================
    match /asset_pack_config/{packId} {
      allow read: if false;  // Server-side only (Admin SDK)
      allow write: if false; // Server-side only (Admin SDK / super-admin tooling)
    }

    // =========================================================================
    // 📋 AUDIT_LOG COLLECTION - CLOUD FUNCTIONS AUDIT TRAIL
    // =========================================================================
    // 📅 Added: 2026-01-20 (ADR-032 - Enterprise Trash System)
    // 🏢 ENTERPRISE: Audit log for file purge operations (written by Cloud Functions)
    // 🔒 READ: Only super_admin can read audit logs
    // 🚫 WRITE: Server-side only (via Firebase Admin SDK)
    match /audit_log/{logId} {
      allow read: if isSuperAdminOnly();
      allow write: if false; // Server-side only (Cloud Functions use Admin SDK)
    }

    // =========================================================================
    // 👥 TEAMS - ENTERPRISE TENANT ISOLATION (PR-1D)
    // =========================================================================
    // 📅 Updated: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Team management with tenant isolation
    // =========================================================================
    match /teams/{teamId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY FALLBACK: Creator-only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId required
      allow create: if isAuthenticated()
                    && request.resource.data.companyId == getUserCompanyId();

      // 📝 UPDATE: Creator or company admin, companyId immutable
      allow update: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       )
                    && (!resource.data.keys().hasAny(['companyId'])
                        || request.resource.data.companyId == resource.data.companyId);

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 💼 POSITIONS - ROLE/POSITION MANAGEMENT
    // =========================================================================
    // 📅 Added: 2026-01-17 (Final 2 collections fix)
    // 🏢 ENTERPRISE: Position management (fallback for COLLECTIONS.ROLES)
    match /positions/{positionId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin/server only
    }

    // =========================================================================
    // ⚙️ SYSTEM - DUPLICATE REMOVED (ADR-252 FR-M1)
    // =========================================================================
    // 📅 Removed: 2026-03-20 — Merged into single system/{docId} block above
    // 🔒 SECURITY: Duplicate blocks caused most-permissive-wins in Firestore
    // =========================================================================

    // =========================================================================
    // 🔍 SEARCH_DOCUMENTS COLLECTION - GLOBAL SEARCH INDEX (ADR-029)
    // =========================================================================
    // 🏢 ENTERPRISE: Denormalized search index with tenant isolation
    // 📅 Added: 2026-01-26 (Global Search v1)
    //
    // Architecture:
    //   - Documents indexed by Cloud Functions triggers
    //   - Tenant-scoped reads via tenantId field
    //   - Write-only for server (Admin SDK)
    // =========================================================================
    match /search_documents/{searchDocId} {

      // 📖 READ: Tenant-scoped - only users from the same company
      // 🔒 SECURITY: Search results filtered by tenantId
      allow read: if isAuthenticated()
                  && (
                       // Super admin can search all
                       isSuperAdminOnly()
                       // OR user belongs to the document's tenant
                       || belongsToCompany(resource.data.tenantId)
                     );

      // 🚫 WRITE: Server-side only (Cloud Functions / Admin SDK)
      // Search index is maintained by triggers, not client writes
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 🎤 VOICE_COMMANDS COLLECTION - IN-APP AI PIPELINE (ADR-164)
    // =========================================================================
    // 🏢 ENTERPRISE: Voice commands submitted via in-app mic → AI pipeline
    // 🔒 SECURITY: User-scoped read only (userId == auth.uid)
    // 📅 Added: 2026-02-09
    //
    // Security Model:
    //   - READ: Only the user who created the command (userId match)
    //   - WRITE: Server-only via Admin SDK (API route creates/updates)
    // =========================================================================
    match /voice_commands/{commandId} {

      // 📖 READ: User can only read their own voice commands
      // 🔒 SECURITY: Prevents cross-user access to AI responses
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      // 🚫 WRITE: Server-side only (Admin SDK via /api/voice/command)
      // Voice command lifecycle managed by API route and pipeline dispatcher
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 📏 BOQ_ITEMS COLLECTION — Quantity Surveying / Επιμετρήσεις (ADR-175)
    // =========================================================================
    // Bill of Quantities items per building.
    // CRUD from client-side SDK (useBOQItems hook).
    // Governance flow: draft → submitted → approved → certified → locked.
    // Cost fields computed at runtime (NEVER stored as totals).
    // 📅 Updated: 2026-03-20 (ADR-252 FR-H1 — tenant isolation)
    // =========================================================================
    match /boq_items/{itemId} {

      // 📖 READ: Tenant-scoped
      // 🔒 SECURITY (ADR-252 FR-H1): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Authenticated user with required fields + tenant check
      // 🔒 SECURITY (ADR-252 FR-H1): companyId MUST match user's company claim
      // 📐 ADR-329 §3.3: scope must be one of 5 levels.
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'companyId', 'projectId', 'buildingId',
                         'categoryCode', 'title', 'unit', 'status', 'scope',
                         'estimatedQuantity', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.companyId is string
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId())
                    && request.resource.data.projectId is string
                    && request.resource.data.buildingId is string
                    && request.resource.data.categoryCode is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.status in [
                         'draft', 'submitted', 'approved', 'certified', 'locked'
                       ]
                    && request.resource.data.scope in [
                         'building', 'common_areas', 'floor', 'property', 'properties'
                       ]
                    && request.resource.data.estimatedQuantity is number;

      // ✏️ UPDATE: Tenant-scoped (buildingId and projectId immutable)
      // 📐 ADR-329 §3.3.1: scope-related fields immutable once status leaves draft.
      allow update: if isAuthenticated()
                    && (isSuperAdminOnly() || belongsToCompany(resource.data.companyId))
                    && request.resource.data.buildingId == resource.data.buildingId
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.status in [
                         'draft', 'submitted', 'approved', 'certified', 'locked'
                       ]
                    && (
                         resource.data.status == 'draft'
                         || (
                              request.resource.data.scope == resource.data.scope
                              && request.resource.data.get('linkedFloorId', null)
                                 == resource.data.get('linkedFloorId', null)
                              && request.resource.data.get('linkedUnitId', null)
                                 == resource.data.get('linkedUnitId', null)
                              && request.resource.data.get('linkedUnitIds', null)
                                 == resource.data.get('linkedUnitIds', null)
                              && request.resource.data.get('costAllocationMethod', 'by_area')
                                 == resource.data.get('costAllocationMethod', 'by_area')
                              && request.resource.data.get('customAllocations', null)
                                 == resource.data.get('customAllocations', null)
                            )
                       );

      // 🗑️ DELETE: Tenant-scoped (only draft/submitted items)
      allow delete: if isAuthenticated()
                    && (isSuperAdminOnly() || belongsToCompany(resource.data.companyId))
                    && resource.data.status in ['draft', 'submitted'];
    }

    // =========================================================================
    // 📏 BOQ_CATEGORIES COLLECTION — ΑΤΟΕ Custom Categories (ADR-175)
    // =========================================================================
    // Company-specific BOQ category overrides.
    // Fallback to static ATOE_MASTER_CATEGORIES when empty.
    // Client reads only; future admin UI may write.
    // =========================================================================
    match /boq_categories/{categoryId} {

      // 📖 READ: Tenant-scoped
      // 🔒 SECURITY (ADR-252 FR-H3): Was `isAuthenticated()` → now tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY: categories without companyId (system defaults) readable by all auth users
                       || !resource.data.keys().hasAny(['companyId'])
                     );

      // 🚫 WRITE: Reserved for future admin UI
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 📁 BROKERAGE_AGREEMENTS COLLECTION — Μεσιτικές Συμβάσεις (ADR-230)
    // =========================================================================
    // Tenant-scoped: companyId must match user's company claim
    // =========================================================================
    match /brokerage_agreements/{agreementId} {

      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       // LEGACY: documents without companyId — creator only
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId must match user claim
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['projectId', 'agentContactId', 'createdBy', 'companyId'])
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: Creator or company admin
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || (resource.data.keys().hasAny(['companyId'])
                             && isCompanyAdminOfCompany(resource.data.companyId))
                         || isSuperAdminOnly()
                       );

      // 🗑️ DELETE: Creator or company admin
      allow delete: if isAuthenticated()
                    && (
                         resource.data.createdBy == request.auth.uid
                         || isSuperAdminOnly()
                       );
    }

    // =========================================================================
    // 📁 COMMISSION_RECORDS COLLECTION — Εγγραφές Προμηθειών (ADR-230)
    // =========================================================================
    match /commission_records/{recordId} {

      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.createdBy == request.auth.uid)
                     );

      // ✍️ CREATE: companyId must match user claim
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['projectId', 'agentContactId', 'createdBy', 'companyId'])
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: Creator or company admin (payment status updates)
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         resource.data.createdBy == request.auth.uid
                         || (resource.data.keys().hasAny(['companyId'])
                             && isCompanyAdminOfCompany(resource.data.companyId))
                         || isSuperAdminOnly()
                       );

      // 🗑️ DELETE: Super admin only
      allow delete: if isAuthenticated() && isSuperAdminOnly();
    }

    // =========================================================================
    // 📊 OWNERSHIP_TABLES COLLECTION — ADR-235 (Πίνακας Χιλιοστών)
    // =========================================================================
    // 📅 Updated: 2026-03-20 (ADR-252 FR-H2 — tenant isolation)
    // 🔒 SECURITY: Tenant-scoped via companyId + legacy creator fallback
    // =========================================================================
    match /ownership_tables/{tableId} {
      // 📖 READ: Tenant-scoped
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                       || (!resource.data.keys().hasAny(['companyId'])
                           && resource.data.keys().hasAny(['createdBy'])
                           && resource.data.createdBy == request.auth.uid)
                     );
      // ✍️ CREATE: companyId must match user claim
      allow create: if isAuthenticated()
                    && (isSuperAdminOnly() || request.resource.data.companyId == getUserCompanyId());
      // 📝 UPDATE: Tenant-scoped
      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (resource.data.keys().hasAny(['companyId'])
                             && belongsToCompany(resource.data.companyId))
                         || (!resource.data.keys().hasAny(['companyId'])
                             && resource.data.keys().hasAny(['createdBy'])
                             && resource.data.createdBy == request.auth.uid)
                       );
      // 🗑️ DELETE: Super admin only
      allow delete: if isAuthenticated() && isSuperAdminOnly();
    }

    // Revisions subcollection — inherits parent tenant isolation
    match /ownership_tables/{tableId}/revisions/{revisionId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(
                            get(/databases/$(database)/documents/ownership_tables/$(tableId)).data.companyId
                          )
                     );
      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(
                              get(/databases/$(database)/documents/ownership_tables/$(tableId)).data.companyId
                            )
                       );
    }

    // =========================================================================
    // 📒 ACCOUNTING MODULE — 19 COLLECTIONS (Q2-Q8, AUDIT-2026-03-29)
    // =========================================================================
    // 📅 Added: 2026-03-31 (Εργασία #17 B-7)
    // 🔒 Tenant isolation via companyId field (Q3 Google pattern A)
    // 🏢 RBAC: Q4 super_admin/company_admin/internal_user/external_user
    // =========================================================================

    // ── Pattern A: Standard CRUD (13 collections) ──────────────────────────

    match /accounting_journal_entries/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_invoices/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_bank_transactions/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_bank_accounts/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_fixed_assets/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_depreciation_records/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_expense_documents/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_import_batches/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_tax_installments/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_apy_certificates/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_custom_categories/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_matching_rules/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    match /accounting_efka_payments/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccounting();
      allow update: if canUpdateAccounting(resource.data.companyId, resource.data.createdBy);
      allow delete: if canDeleteAccounting(resource.data.companyId, resource.data.createdBy);
    }

    // ── Pattern B: Audit Log — IMMUTABLE (Q7 ΚΦΔ compliance) ───────────────

    match /accounting_audit_log/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccountingSystem()
                    && request.resource.data.userId is string
                    && request.resource.data.userId == request.auth.uid;
      // Q7: Accounting audit log is 100% IMMUTABLE — zero update/delete
      allow update: if false;
      allow delete: if false;
    }

    // ── Pattern C: Fiscal Periods — Q8 SAP pattern ─────────────────────────

    match /accounting_fiscal_periods/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if isCompanyAdminOfCompany(request.resource.data.companyId)
                    && request.resource.data.companyId == getUserCompanyId();
      allow update: if isInternalUserOfCompany(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId
                    // Q8: lock/reopen → admin only; close (OPEN→CLOSED) → admin+internal
                    && (
                         // Status not changing → any internal user can update other fields
                         resource.data.status == request.resource.data.status
                         // OPEN → CLOSED: admin + internal_user
                         || (resource.data.status == 'OPEN' && request.resource.data.status == 'CLOSED')
                         // CLOSED → LOCKED or LOCKED → OPEN: admin only
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
      // Fiscal periods are never deleted
      allow delete: if false;
    }

    // ── Pattern D: Settings Singletons — admin-only write ──────────────────
    //
    // 🔒 ADR-841 §7 Α23 (Φ3.2 Γ3β, 2026-09-15) — ΛΙΣΤΑ ΕΠΙΤΡΕΠΟΜΕΝΩΝ, ΟΧΙ ΛΙΣΤΑ ΑΠΑΓΟΡΕΥΣΕΩΝ.
    // Ο browser γράφει ΜΟΝΟ τα singletons της `CLIENT_WRITABLE_ACCOUNTING_SINGLETONS`
    // (`subapps/accounting/services/repository/accounting-doc-ids.ts`), και ΜΟΝΟ της ΔΙΚΗΣ
    // του εταιρείας: το docId δένεται με το companyId. Όλα τα άλλα — πρώτα απ' όλα το
    // προφίλ `{companyId}` (νομική ταυτότητα) — γράφονται ΜΟΝΟ από τον server (Admin SDK,
    // που παρακάμπτει τους κανόνες), ώστε κάθε αλλαγή να περνά από μάσκα πεδίων + ίχνος στην
    // ίδια συναλλαγή. Πρακτική Stripe/Google: νομικά στοιχεία αλλάζουν μόνο μέσω API.
    // Κλείνει ΚΑΙ την κατάληψη: πριν, admin της Α δημιουργούσε πρώτος το `{B}__matching_config`
    // με companyId Α και κλείδωνε έξω τη Β (το create δεν κοίταζε το docId).
    // ⚠️ Νέο client-writable singleton ⇒ ΚΑΙ εδώ ΚΑΙ στη σταθερά — η σουίτα
    //    `accounting-settings.rules.test.ts` διατρέχει τη σταθερά στον εξομοιωτή.
    // Οι αναγνώσεις ΔΕΝ άλλαξαν.

    match /accounting_settings/{docId} {
      function isClientWritableAccountingSetting(companyId) {
        return docId == companyId + '__matching_config';
      }

      allow read:   if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (resource.data.keys().hasAny(['companyId'])
                            && isInternalUserOfCompany(resource.data.companyId)));
      allow create: if isCompanyAdmin()
                    && request.resource.data.companyId is string
                    && request.resource.data.companyId == getUserCompanyId()
                    && isClientWritableAccountingSetting(request.resource.data.companyId);
      allow update: if resource.data.keys().hasAny(['companyId'])
                    && canWriteAccountingSingleton(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId
                    && isClientWritableAccountingSetting(resource.data.companyId);
      allow delete: if false;
    }

    match /accounting_efka_config/{docId} {
      allow read:   if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (resource.data.keys().hasAny(['companyId'])
                            && isInternalUserOfCompany(resource.data.companyId)));
      allow create: if isCompanyAdmin()
                    && request.resource.data.companyId is string
                    && request.resource.data.companyId == getUserCompanyId();
      allow update: if resource.data.keys().hasAny(['companyId'])
                    && canWriteAccountingSingleton(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId;
      allow delete: if false;
    }

    // ── Pattern E: Server-only (Admin SDK) ─────────────────────────────────

    match /accounting_invoice_counters/{docId} {
      // Server-only via Admin SDK — no client access
      allow read, write: if false;
    }

    // ── Pattern F: Customer Balances — system-calculated ───────────────────

    match /accounting_customer_balances/{docId} {
      allow read:   if canReadAccounting(resource.data.companyId);
      allow create: if canCreateAccountingSystem();
      allow update: if canUpdateAccountingSystem(resource.data.companyId);
      // Customer balances are system-managed, admin can delete
      allow delete: if isCompanyAdminOfCompany(resource.data.companyId);
    }

    // =========================================================================
    // 📐 DXF VIEWER LEVELS — Real-time sync for floor plan levels
    // =========================================================================
    // 📖 READ: Tenant isolation via companyId field (onSnapshot in client)
    // ✍️ CREATE: Client-side bootstrap only (default levels on empty collection)
    //            API-created levels use Admin SDK (bypass rules)
    // 🔄 UPDATE/DELETE: Admin SDK only (via /api/dxf-levels gateway)
    // =========================================================================
    match /dxf_viewer_levels/{levelId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(resource.data.companyId)
                     );

      // Client-side bootstrap: create default levels when collection is empty
      // Must set companyId matching user's company + createdBy matching uid
      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              request.resource.data.companyId == getUserCompanyId()
                              && request.resource.data.createdBy == request.auth.uid
                            )
                       );

      // Updates and deletes go through Admin SDK (/api/dxf-levels)
      // No client-side update/delete needed
    }

    // =========================================================================
    // 🎨 DXF VIEWER VIEW TEMPLATES — ADR-375 Phase B.3
    // =========================================================================
    // 📅 Added: 2026-05-25
    // 🏢 ENTERPRISE: Reusable BIM render-settings presets (drawingScale + viewRange +
    //                objectStyles). Top-level collection, companyId-scoped, mirrors
    //                the floorplan_stairs rules pattern (creator OR company_admin
    //                update / delete).
    //
    // 🔒 SECURITY MODEL:
    //   - READ:   Tenant member of doc's company OR super_admin
    //   - CREATE: Tenant member + companyId matches caller + createdBy == self
    //             + required fields (companyId, name, settings, createdBy)
    //   - UPDATE: Creator OR company_admin
    //             + companyId / createdBy / createdAt immutable
    //   - DELETE: Creator OR company_admin OR super_admin
    //
    // 📘 ADR-375 §5 Phase B.3
    // =========================================================================
    match /dxf_viewer_view_templates/{templateId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(resource.data.companyId)
                     );

      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              request.resource.data.companyId == getUserCompanyId()
                              && request.resource.data.createdBy == request.auth.uid
                              && request.resource.data.keys().hasAll(
                                   ['companyId', 'name', 'settings', 'createdBy']
                                 )
                            )
                       );

      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              (resource.data.createdBy == request.auth.uid
                               || isCompanyAdminOfCompany(resource.data.companyId))
                              && request.resource.data.companyId == resource.data.companyId
                              && request.resource.data.createdBy == resource.data.createdBy
                              && request.resource.data.createdAt == resource.data.createdAt
                            )
                       );

      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // 🖊️ DXF_VIEWER_PEN_TABLES COLLECTION — ADR-375 Phase C.1
    // =========================================================================
    // 📅 Added: 2026-05-26
    // Singleton per company: docId == companyId.
    // Stores sparse pen table overrides (16 pens × 6 scales).
    match /dxf_viewer_pen_tables/{companyId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || companyId == getUserCompanyId()
                     );

      allow write: if isAuthenticated()
                   && (
                        isSuperAdminOnly()
                        || (
                             companyId == getUserCompanyId()
                             && request.resource.data.companyId == companyId
                           )
                      );
    }

    // =========================================================================
    // 📐 DXF DIMENSION STYLES — ADR-362 Phase F4
    // =========================================================================
    // 📅 Added: 2026-07-07
    // 🏢 ENTERPRISE: Per-company custom DIMSTYLE persistence + the per-company
    //                "default" dim style pointer (isDefault). Top-level collection,
    //                companyId-scoped, mirrors the dxf_viewer_view_templates rules
    //                pattern (creator OR company_admin update / delete). One doc per
    //                CUSTOM style (full `style` payload) plus at most one thin
    //                `isBuiltInRef` doc pinning a built-in template as default.
    //
    // 🔒 SECURITY MODEL:
    //   - READ:   Tenant member of doc's company OR super_admin
    //   - CREATE: Tenant member + companyId matches caller + createdBy == self
    //             + required fields (companyId, name, createdBy)
    //   - UPDATE: Creator OR company_admin
    //             + companyId / createdBy / createdAt immutable
    //   - DELETE: Creator OR company_admin OR super_admin
    //
    // 📘 ADR-362 §Group F Phase F4
    // =========================================================================
    match /dxf_dimension_styles/{styleId} {
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || belongsToCompany(resource.data.companyId)
                     );

      allow create: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              request.resource.data.companyId == getUserCompanyId()
                              && request.resource.data.createdBy == request.auth.uid
                              && request.resource.data.keys().hasAll(
                                   ['companyId', 'name', 'createdBy']
                                 )
                            )
                       );

      allow update: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (
                              (resource.data.createdBy == request.auth.uid
                               || isCompanyAdminOfCompany(resource.data.companyId))
                              && request.resource.data.companyId == resource.data.companyId
                              && request.resource.data.createdBy == resource.data.createdBy
                              && request.resource.data.createdAt == resource.data.createdAt
                            )
                       );

      allow delete: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || resource.data.createdBy == request.auth.uid
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // 🪜 FLOORPLAN_STAIRS COLLECTION — ADR-358 Phase 8 (G6 schema, G24 soft-lock)
    // =========================================================================
    // 📅 Added: 2026-05-17
    // 🏢 ENTERPRISE: Parametric stair entities. Top-level collection with
    //                companyId field-based tenant isolation (mirrors
    //                project_floorplans / building_floorplans pattern).
    //                Top-level (NOT subcollection) so the SSoT
    //                `firestoreQueryService.subscribe('FLOORPLAN_STAIRS')`
    //                applies the tenant constraint automatically and ADR-361
    //                equality guard suppresses idle re-render storms.
    //
    // 🔒 SECURITY MODEL:
    //   - READ: Tenant member of doc's company OR super_admin
    //   - CREATE: Tenant member + companyId matches caller + createdBy == self
    //             + required fields (companyId, projectId, floorplanId, kind, params)
    //   - UPDATE: Creator OR company_admin
    //             + companyId/projectId/floorplanId immutable
    //             + createdBy/createdAt immutable
    //             + editingBy.userId can only be set to caller's uid (anti-spoof, G24)
    //   - DELETE: Creator OR company_admin OR super_admin
    //
    // 📘 ADR-358 §6.1 (schema), §6.8 (soft-lock G24), §7.2 row 8
    // =========================================================================
    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    // Write is authoring: internal-user-of-company only, no ownership grant.
    match /floorplan_stairs/{stairId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // =========================================================================
    // 🏗️ BIM DRAWING MODE — ADR-363 (Phase 0 Bootstrap)
    // Pattern mirrors floorplan_stairs (ADR-358): tenant isolation via companyId claim,
    // creator + company_admin writes, immutable identity fields, soft-lock anti-spoof.
    // =========================================================================

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_walls/{wallId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_openings/{openingId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_slabs/{slabId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-417 — BIM Roof (Στέγη). Top-level `floorplan_roofs/{roofId}`,
    // companyId-scoped via field. Mirrors floorplan_slabs (same footprint+dna+
    // params doc shape: companyId/projectId/floorplanId/kind/params/createdBy).
    // FIX 2026-06-22: το collection έλειπε εντελώς → default-deny απέρριπτε ΟΛΑ
    // τα roof writes → οι στέγες χάνονταν σε reload (μόνο η στέγη, όχι slab/column).
    // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
    match /floorplan_roofs/{roofId} {
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_slab_openings/{slabOpeningId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_columns/{columnId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-657 PRESENTATION tier — read client-side on /properties (ADR-370). Phase 2 flips read → authoring.
    match /floorplan_beams/{beamId} {
      allow read:   if isAuthenticated() && canReadBimPresentation(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-436 — substructure footings (pad/strip/tie-beam, IfcFooting). Mirror of
    // floorplan_columns / floorplan_beams (company-scoped, owner/admin writes).
    match /floorplan_foundations/{foundationId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-441/189 — per-floor construction grid (axes + groups, 1 doc/floor).
    // Mirror of floorplan_foundations (company-scoped, owner/admin writes).
    match /floorplan_grid_guides/{gridId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'guides']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-650 — per-floor topographic surface DEFINITION (survey + settings, 1 doc/floor).
    // Mirror of floorplan_grid_guides (company-scoped, owner/admin writes). The survey
    // payload is either inline (`surfaces`) or offloaded to Storage (`pointsStoragePath`),
    // so create requires only the scope keys — not a specific data field.
    match /floorplan_topo_surfaces/{topoId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-406 — point-based MEP fixtures (light fixtures first). Mirror of
    // floorplan_columns / floorplan_beams (company-scoped, owner/admin writes).
    match /floorplan_mep_fixtures/{fixtureId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-407 — path-based railings (guardrails). Mirror of
    // floorplan_mep_fixtures (company-scoped, owner/admin writes).
    match /floorplan_railings/{railingId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-410 — mesh-based CC0 furniture (chair first). Mirror of
    // floorplan_mep_fixtures (company-scoped, owner/admin writes).
    match /floorplan_furniture/{furnitureId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-683 Φ3β — baked meshes imported from a collaborator's glTF. Exact mirror of
    // floorplan_furniture: same AUTHORING tier, same company scope, same create contract.
    // The mesh BYTES live in Storage (companies/{c}/projects/{p}/imported-meshes/) under
    // storage.rules; this doc only carries the pointer + measured dimensions.
    match /floorplan_imported_meshes/{importedMeshId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-684 — parametric geometric solids (box/sphere/cylinder/cone/torus/pyramid/disc/prism).
    // Exact mirror of floorplan_imported_meshes: same AUTHORING tier, same company scope, same
    // create contract. Procedural geometry (rebuilt from params) — no Storage bytes.
    // ⚠️ Χωρίς αυτόν τον κανόνα το default-deny απέρριπτε ΚΑΘΕ write → τα στερεά εξαφανίζονταν
    // στο πρώτο reload (0 docs στο floorplan_generic_solids).
    match /floorplan_generic_solids/{genericSolidId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-415 — pure-vector 2D floorplan symbols (WC/sanitary first). Mirror of
    // floorplan_furniture (company-scoped, owner/admin writes). Create requires
    // the category-driven `category` field alongside kind/params.
    match /floorplan_symbols/{symbolId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'category', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Φ3 — point-based electrical panels (circuit sources). Mirror of
    // floorplan_mep_fixtures (company-scoped, owner/admin writes).
    match /floorplan_electrical_panels/{panelId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Φ12 — point-based plumbing manifolds (συλλέκτης, pipe-network
    // sources). Mirror of floorplan_electrical_panels (company-scoped, owner/admin writes).
    match /floorplan_mep_manifolds/{manifoldId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Εύρος Β — point-based heating radiators (καλοριφέρ, hydronic
    // terminals). Mirror of floorplan_mep_manifolds (company-scoped, owner/admin writes).
    match /floorplan_mep_radiators/{radiatorId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Εύρος Β #2 — point-based heating boilers (λέβητας, hydronic
    // source). Mirror of floorplan_mep_radiators (company-scoped, owner/admin writes).
    match /floorplan_mep_boilers/{boilerId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 / water-heater — point-based domestic hot-water heaters (IfcWaterHeater,
    // DHW source). Mirror of floorplan_mep_boilers (company-scoped, owner/admin writes).
    match /floorplan_mep_water_heaters/{waterHeaterId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Εύρος Β #3 — area-based underfloor radiant heating loops (ενδοδαπέδια,
    // hydronic terminal). Mirror of floorplan_mep_boilers (company-scoped, owner/admin writes).
    match /floorplan_mep_underfloors/{underfloorId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Φ8 — linear MEP segments (duct/pipe runs). Mirror of
    // floorplan_electrical_panels (company-scoped, owner/admin writes).
    match /floorplan_mep_segments/{segmentId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 Φ11 — auto pipe fittings (junction elements). Mirror of
    // floorplan_mep_segments (company-scoped, owner/admin writes).
    match /floorplan_mep_fittings/{fittingId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'kind', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-408 — logical MEP systems (electrical circuits; geometry-less). Mirror
    // of floorplan_mep_fixtures (company-scoped, owner/admin writes). `kind` is
    // N/A for a system; the create allowlist requires params instead.
    match /floorplan_mep_systems/{systemId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    match /floorplan_floor_finishes/{floorFinishId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-511 — wall finish per room/face (IfcCovering CLADDING/INTERIOR). Mirrors
    // floor-finish rules; payload = `params` (hostWallId + faceSide + span + layers).
    match /floorplan_wall_coverings/{wallCoveringId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-507 — flat DXF hatch fills (Revit Filled-Region). Mirrors floor-finish
    // rules; validated payload is `data` (boundaryPaths + fill fields), NOT `params`.
    match /floorplan_hatches/{hatchId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'data']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-422 — analytical thermal spaces per room (IfcSpace). Mirrors floor-finish rules.
    match /floorplan_thermal_spaces/{thermalSpaceId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    // ADR-437 — space separators per floorplan (IfcVirtualElement). Mirrors thermal-space rules.
    match /floorplan_space_separators/{spaceSeparatorId} {
      // ADR-657 AUTHORING tier — editor-only (/dxf/viewer). external_user denied.
      allow read:   if isAuthenticated() && canReadBimAuthoring(resource.data.companyId);
      allow create: if isAuthenticated() && canCreateBimEntity(['companyId', 'projectId', 'floorplanId', 'params']);
      allow update: if isAuthenticated() && canUpdateBimEntity();
      allow delete: if isAuthenticated() && canDeleteBimEntity();
    }

    match /bim_presets/{presetId} {
      // System-scope presets readable by all authenticated; company-scope by tenant members
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || resource.data.scope == 'system'
                      || belongsToCompany(resource.data.companyId));
      allow create: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (request.resource.data.companyId == getUserCompanyId()
                            && request.resource.data.createdBy == request.auth.uid
                            && request.resource.data.scope != 'system'
                            && request.resource.data.keys().hasAll(['companyId', 'elementType', 'kind', 'scope'])));
      allow update: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || ((resource.data.createdBy == request.auth.uid || isCompanyAdminOfCompany(resource.data.companyId))
                            && resource.data.scope != 'system'
                            && request.resource.data.companyId == resource.data.companyId));
      allow delete: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (resource.data.scope != 'system'
                            && (resource.data.createdBy == request.auth.uid
                                || isCompanyAdminOfCompany(resource.data.companyId))));
    }

    match /bim_materials/{materialId} {
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || resource.data.scope == 'system'
                      || belongsToCompany(resource.data.companyId));
      allow create: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (request.resource.data.companyId == getUserCompanyId()
                            && request.resource.data.createdBy == request.auth.uid));
      allow update: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || ((resource.data.createdBy == request.auth.uid || isCompanyAdminOfCompany(resource.data.companyId))
                            && resource.data.scope != 'system'
                            && request.resource.data.companyId == resource.data.companyId));
      allow delete: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (resource.data.scope != 'system'
                            && (resource.data.createdBy == request.auth.uid
                                || isCompanyAdminOfCompany(resource.data.companyId))));
    }

    // =========================================================================
    // 🧱 BLOCK_LIBRARY COLLECTION - ADR-652 M2
    // =========================================================================
    // 2D DXF block content library (blklib_*). Scope: 'user' (ιδιωτική βιβλιοθήκη
    // του δημιουργού) | 'company' | 'project' | 'system' (seed-only, read-all).
    // Η γεωμετρία ζει ως blob στο Storage — εδώ μόνο metadata + provenance/license.
    // ΙΔΙΩΤΙΚΟΤΗΤΑ: user-scope doc διαβάζεται ΜΟΝΟ από τον δημιουργό του (ό,τι
    // ανεβάζει ο χρήστης από ξένο DXF δεν διαρρέει στην υπόλοιπη εταιρεία).
    // =========================================================================
    match /block_library/{blockId} {
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly()
                      || resource.data.scope == 'system'
                      || (belongsToCompany(resource.data.companyId)
                          && (resource.data.scope != 'user'
                              || resource.data.createdBy == request.auth.uid)));
      allow create: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (request.resource.data.companyId == getUserCompanyId()
                            && request.resource.data.createdBy == request.auth.uid
                            && request.resource.data.scope != 'system'));
      // ADR-652 M3 — «Δημοσίευση» (promote): user → company/project στο ΙΔΙΟ doc, επιτρεπτό.
      // ΚΡΙΣΙΜΟ: απαγορεύεται η ΑΥΤΟ-ΠΡΟΑΓΩΓΗ σε `system` — θα έκανε το block ορατό σε ΟΛΟΥΣ
      // τους πελάτες (read rule: `scope == 'system'`). System content ΜΟΝΟ από seed (Admin SDK).
      allow update: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || ((resource.data.createdBy == request.auth.uid || isCompanyAdminOfCompany(resource.data.companyId))
                            && resource.data.scope != 'system'
                            && request.resource.data.scope != 'system'
                            && request.resource.data.companyId == resource.data.companyId));
      allow delete: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (resource.data.scope != 'system'
                            && (resource.data.createdBy == request.auth.uid
                                || isCompanyAdminOfCompany(resource.data.companyId))));
    }

    match /bim_settings/{settingsId} {
      allow read: if isAuthenticated()
                  && (isSuperAdminOnly() || belongsToCompany(resource.data.companyId));
      allow create: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (request.resource.data.companyId == getUserCompanyId()
                            && request.resource.data.keys().hasAll(['companyId'])));
      allow update: if isAuthenticated()
                    && (isSuperAdminOnly()
                        || (isCompanyAdminOfCompany(resource.data.companyId)
                            && request.resource.data.companyId == resource.data.companyId));
      allow delete: if isSuperAdminOnly();
    }

    // =========================================================================
    // 🎛️ BIM_3D_PREFERENCES COLLECTION - ADR-366 Phase 4.3
    // =========================================================================
    // Per-user 3D viewport preferences (compass ring, etc.).
    // Doc ID = b3dpref_{userId} — owner-only, no tenant scope.
    match /bim_3d_preferences/{docId} {
      // READ: docId must match b3dpref_{auth.uid}
      allow read: if isAuthenticated()
                  && docId == ('b3dpref_' + request.auth.uid);

      // CREATE/UPDATE: owner writes their own prefs doc
      allow create: if isAuthenticated()
                    && docId == ('b3dpref_' + request.auth.uid)
                    && request.resource.data.keys().hasAll(['userId', 'compassRingVisible', 'updatedAt'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.compassRingVisible is bool;

      allow update: if isAuthenticated()
                    && docId == ('b3dpref_' + request.auth.uid)
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && docId == ('b3dpref_' + request.auth.uid);
    }

    // =========================================================================
    // 📏 BIM_DIMENSIONS_3D COLLECTION - ADR-366 Phase 9 / C.3
    // =========================================================================
    // Manual 3D dimensions per project. Company-scoped via companyId.
    // 4 placement modes (aligned/linear/radial/angular). Anchored to BIM
    // entities with auto-orphan-convert on entity delete.
    match /bim_dimensions_3d/{dimensionId} {

      // 📖 READ: Tenant-scoped — only users from the dimension's company
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: companyId must match user's claim, required fields present
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(
                         ['id', 'projectId', 'companyId', 'mode',
                          'anchor', 'textOffset', 'textPlane',
                          'value', 'unit', 'precision',
                          'createdBy', 'createdAt', 'updatedAt']
                       )
                    && request.resource.data.id is string
                    && request.resource.data.projectId is string
                    && request.resource.data.companyId is string
                    && request.resource.data.mode in ['aligned', 'linear', 'radial', 'angular']
                    && request.resource.data.textPlane in ['billboard', 'world']
                    && request.resource.data.unit in ['mm', 'm']
                    && request.resource.data.precision is int
                    && request.resource.data.precision >= 0
                    && request.resource.data.precision <= 6
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: companyId immutable, tenant-locked
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.id == resource.data.id;

      // 🗑️ DELETE: tenant-locked
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // 💬 BIM_COMMENTS COLLECTION - ADR-366 Phase 9 / C.2
    // =========================================================================
    // Typed comment markers per project (Issue/Question/Suggestion/Approval/Info).
    // Company-scoped via companyId + projectId. Soft-delete via archivedAt.
    // Replies live in subcollection: bim_comments/{id}/replies/{cmtr_bim_*}.
    match /bim_comments/{commentId} {

      // 📖 READ: Tenant-scoped — only users from comment's company
      // Super-admin can read all (ADR-145 diagnostics)
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: authenticated + tenant-bound + required fields
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'id', 'companyId', 'projectId', 'type', 'status',
                         'content', 'authorId', 'authorName',
                         'anchor', 'mentionedUserIds', 'attachments',
                         'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.id is string
                    && request.resource.data.companyId is string
                    && request.resource.data.projectId is string
                    && request.resource.data.type in ['issue', 'question', 'suggestion', 'approval', 'info']
                    && request.resource.data.status == 'open'
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.authorId == request.auth.uid
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: companyId + projectId immutable, tenant-locked
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.authorId == resource.data.authorId;

      // 🗑️ DELETE: forbidden — use archivedAt soft-delete instead
      allow delete: if isSuperAdminOnly();

      // 💬 REPLIES subcollection — flat 1-level thread (cmtr_bim_* IDs)
      match /replies/{replyId} {

        // 📖 READ: same tenant as parent comment
        allow read: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (get(/databases/$(database)/documents/bim_comments/$(commentId)).data.companyId
                             == getUserCompanyId())
                       );

        // ✍️ CREATE: authenticated + required fields + matches parent company
        allow create: if isAuthenticated()
                      && resource == null
                      && request.resource.data.keys().hasAll([
                           'id', 'companyId', 'commentId', 'content',
                           'authorId', 'authorName', 'mentionedUserIds',
                           'createdAt', 'updatedAt'
                         ])
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.commentId == commentId
                      && (
                           isSuperAdminOnly()
                           || request.resource.data.companyId == getUserCompanyId()
                         );

        // 📝 UPDATE: author can edit own reply
        allow update: if isAuthenticated()
                      && resource != null
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.companyId == resource.data.companyId
                      && request.resource.data.commentId == resource.data.commentId;

        // 🗑️ DELETE: author or super-admin
        allow delete: if isAuthenticated()
                      && resource != null
                      && (
                           isSuperAdminOnly()
                           || resource.data.authorId == request.auth.uid
                         );
      }
    }

    // =========================================================================
    // 🎬 BIM_ANIMATIONS COLLECTION - ADR-366 Phase 9 / C.1.a
    // =========================================================================
    // Camera animation configs per project (turntable + waypoint flythrough).
    // Company-scoped via companyId. Render jobs live in subcollection:
    // bim_animations/{id}/render_jobs/{rnj_bim_*} με 30-day TTL post-completion.
    match /bim_animations/{animationId} {

      // 📖 READ: Tenant-scoped — only users from animation's company
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: companyId must match user's claim, required fields present
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll([
                         'id', 'projectId', 'companyId', 'name',
                         'durationSec', 'fps', 'axis', 'direction',
                         'waypoints', 'codec', 'splitTracks',
                         'createdBy', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.id is string
                    && request.resource.data.projectId is string
                    && request.resource.data.companyId is string
                    && request.resource.data.name is string
                    && request.resource.data.durationSec is number
                    && request.resource.data.durationSec >= 2
                    && request.resource.data.durationSec <= 60
                    && request.resource.data.fps in [24, 30, 60]
                    && request.resource.data.axis in ['x', 'y', 'z']
                    && request.resource.data.direction in ['cw', 'ccw']
                    && request.resource.data.codec in ['h264', 'vp9']
                    && request.resource.data.splitTracks is bool
                    && request.resource.data.waypoints is list
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      // 📝 UPDATE: companyId + projectId + id + createdBy immutable, tenant-locked
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.createdBy == resource.data.createdBy;

      // 🗑️ DELETE: tenant-locked (creator or company admin)
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || belongsToCompany(resource.data.companyId)
                       );

      // 🎞️ RENDER JOBS subcollection — FIFO queue with checkpoint/resume (rnj_bim_* IDs)
      // 30-day TTL post-completion via Cloud Function (deferred C.1.c implementation)
      match /render_jobs/{jobId} {

        // 📖 READ: same tenant as parent animation
        allow read: if isAuthenticated()
                    && (
                         isSuperAdminOnly()
                         || (get(/databases/$(database)/documents/bim_animations/$(animationId)).data.companyId
                             == getUserCompanyId())
                       );

        // ✍️ CREATE: authenticated + matches parent company + required fields
        allow create: if isAuthenticated()
                      && resource == null
                      && request.resource.data.keys().hasAll([
                           'id', 'animationId', 'companyId', 'status',
                           'progress', 'createdAt', 'updatedAt'
                         ])
                      && request.resource.data.animationId == animationId
                      && request.resource.data.status in ['queued', 'rendering', 'done', 'failed', 'cancelled', 'cancelled-resumable']
                      && request.resource.data.progress is number
                      && request.resource.data.progress >= 0
                      && request.resource.data.progress <= 100
                      && (
                           isSuperAdminOnly()
                           || request.resource.data.companyId == getUserCompanyId()
                         );

        // 📝 UPDATE: status/progress/checkpoint mutable, ownership immutable
        allow update: if isAuthenticated()
                      && resource != null
                      && (
                           isSuperAdminOnly()
                           || (get(/databases/$(database)/documents/bim_animations/$(animationId)).data.companyId
                               == getUserCompanyId())
                         )
                      && request.resource.data.id == resource.data.id
                      && request.resource.data.animationId == resource.data.animationId
                      && request.resource.data.companyId == resource.data.companyId;

        // 🗑️ DELETE: tenant-scoped
        allow delete: if isAuthenticated()
                      && resource != null
                      && (
                           isSuperAdminOnly()
                           || (get(/databases/$(database)/documents/bim_animations/$(animationId)).data.companyId
                               == getUserCompanyId())
                         );
      }
    }

    // =========================================================================
    // 🪣 ISO 19650 ENRICHMENT SLOTS — ADR-373 P2.4
    // Distributed token bucket (activeSlots, updatedAt). Doc ID = companyId.
    // Managed exclusively via Admin SDK — no client reads or writes permitted.
    // =========================================================================
    match /iso19650_enrichment_slots/{companyId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 💰 ISO 19650 COST LOGS — ADR-373 P2.5
    // Per-file AI enrichment cost records for super_admin cost dashboard.
    // Written by Admin SDK only — no client reads or writes permitted.
    // =========================================================================
    match /iso19650_cost_log/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 🔒 HELPER FUNCTIONS - VALIDATION & SECURITY
    // =========================================================================

    // Project Data Validation
    function isValidProjectData(data) {
      return data.keys().hasAll(['name', 'status', 'company'])
             && data.name is string && data.name.size() > 0
             && data.status in ['planning', 'in_progress', 'completed', 'on_hold', 'cancelled']
             && data.company is string && data.company.size() > 0;
    }

    // Contact Data Validation
    // 🏢 ENTERPRISE: Updated for tenant isolation (ADR-029)
    // companyId is required for new contacts (tenant isolation)
    function isValidContactData(data) {
      return data.keys().hasAll(['companyId'])
             && data.companyId is string
             && data.companyId.size() > 0
             // Email validation (if present) - allows empty string
             && (!data.keys().hasAny(['email']) || data.email == '' || (data.email is string && data.email.matches('.*@.*\\..*')))
             // Type validation (if present)
             && (!data.keys().hasAny(['type']) || data.type in ['individual', 'company', 'service'])
             // Status validation (if present)
             && (!data.keys().hasAny(['status']) || data.status in ['active', 'inactive', 'archived']);
    }

    // ✅ Task Data Validation (ADR-026: CRM Tasks Backend Fix)
    // 🏢 ENTERPRISE: Validates CrmTask structure for Firestore operations
    function isValidTaskData(data) {
      return data.keys().hasAll(['title', 'type', 'assignedTo', 'status', 'priority'])
             // 📝 Title validation
             && data.title is string && data.title.size() > 0
             // 📋 Type validation (enum)
             && data.type in ['call', 'email', 'meeting', 'viewing', 'document', 'follow_up', 'other']
             // 👤 AssignedTo validation (User ID)
             && data.assignedTo is string && data.assignedTo.size() > 0
             // 📊 Status validation (enum)
             && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
             // ⚡ Priority validation (enum)
             && data.priority in ['low', 'medium', 'high', 'urgent']
             // 🔗 Optional leadId validation
             && (!data.keys().hasAny(['leadId']) || data.leadId is string || data.leadId == null)
             // 🔗 Optional contactId validation
             && (!data.keys().hasAny(['contactId']) || data.contactId is string || data.contactId == null)
             // 🔗 Optional projectId validation
             && (!data.keys().hasAny(['projectId']) || data.projectId is string || data.projectId == null)
             // 📝 Optional description validation
             && (!data.keys().hasAny(['description']) || data.description is string || data.description == null);
    }

    // =========================================================================
    // 💬 CONVERSATION & MESSAGE DATA VALIDATION
    // =========================================================================
    // 📋 CRM Communications - Added 2026-01-15
    // 🏢 ENTERPRISE: Validates Conversation and Message structures for Firestore operations

    // Conversation Data Validation
    function isValidConversationData(data) {
      return data.keys().hasAll(['channel', 'status'])
             // 📡 Channel validation (enum: telegram | email | whatsapp | sms)
             && data.channel in ['telegram', 'email', 'whatsapp', 'sms']
             // 📊 Status validation (enum)
             && data.status in ['active', 'archived', 'closed', 'spam']
             // 🔢 Optional messageCount validation
             && (!data.keys().hasAny(['messageCount']) || (data.messageCount is int && data.messageCount >= 0))
             // 🔔 Optional unreadCount validation
             && (!data.keys().hasAny(['unreadCount']) || (data.unreadCount is int && data.unreadCount >= 0))
             // 👤 Optional assignedTo validation
             && (!data.keys().hasAny(['assignedTo']) || (data.assignedTo == null || data.assignedTo is string));
    }

    // Message Data Validation
    function isValidMessageData(data) {
      return data.keys().hasAll(['conversationId', 'direction', 'channel', 'content'])
             // 🔗 ConversationId validation
             && data.conversationId is string && data.conversationId.size() > 0
             // ↔️ Direction validation (enum: inbound | outbound)
             && data.direction in ['inbound', 'outbound']
             // 📡 Channel validation (enum)
             && data.channel in ['telegram', 'email', 'whatsapp', 'sms']
             // 📝 Content validation (must have text field)
             && data.content is map
             && data.content.keys().hasAll(['text'])
             && data.content.text is string
             // 👤 Optional sender fields validation
             && (!data.keys().hasAny(['senderId']) || (data.senderId is string))
             && (!data.keys().hasAny(['senderName']) || (data.senderName is string))
             // 📊 Optional deliveryStatus validation
             && (!data.keys().hasAny(['deliveryStatus'])
                 || data.deliveryStatus in ['queued', 'sent', 'delivered', 'read', 'failed']);
    }

    // =========================================================================
    // 🔔 NOTIFICATION UPDATE VALIDATION
    // =========================================================================
    // 📋 ADR-027: CRM Notifications Integration - Added 2026-01-13
    // 🔒 ENTERPRISE: Only allows updating delivery state fields
    function isValidNotificationUpdate(newData, existingData) {
      // List of fields that users are allowed to modify
      let allowedFields = ['delivery', 'seenAt', 'actedAt', 'actionId', 'dismissedAt'];

      // Get the fields that changed
      let changedKeys = newData.diff(existingData).affectedKeys();

      // All changed fields must be in the allowed list
      return changedKeys.hasOnly(allowedFields)
             // Ensure delivery state is valid if being updated
             && (!changedKeys.hasAny(['delivery'])
                 || newData.delivery.state in ['queued', 'sent', 'delivered', 'seen', 'acted', 'dismissed', 'failed', 'expired'])
             // Ensure userId is never changed
             && newData.userId == existingData.userId
             // Ensure title is never changed
             && newData.title == existingData.title;
    }

    // System Fields Protection
    // 📅 Fixed 2026-04-11 (ADR-298 Phase D.2) — CEL semantics:
    // `List.hasAny(X)` requires X to also be a List, but `MapDiff.affectedKeys()`
    // returns a Set, so the previous shape `systemFields.hasAny(affectedKeys())`
    // threw `Unsupported operation error. Received: list.hasAny(set).` at runtime
    // and denied every tenant_direct update that walked this helper (latent
    // production bug surfaced by the Phase A emulator suite). The canonical
    // form is `Set.hasAny(List)` — swap receiver and argument.
    function isAttemptingToModifySystemFields(newData, existingData) {
      let systemFields = ['createdAt', 'createdBy', 'ownerId', 'id'];
      return newData.diff(existingData).affectedKeys().hasAny(systemFields);
    }

    // =========================================================================
    // 📋 QUOTES & RFQ — ADR-327 Quote Management & Comparison System
    // All writes go through Admin SDK (API routes with withAuth).
    // Vendor portal writes (P3) also use Admin SDK only.
    // =========================================================================

    match /rfqs/{rfqId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      // Vendor portal writes and internal writes via Admin SDK only
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /quote_counters/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /vendor_invites/{inviteId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /vendor_invite_tokens/{tokenId} {
      allow read: if false;
      allow write: if false;
    }

    // ADR-327 §17 Q31 — Multi-Vendor sourcing_events parent (HYBRID A-Enhanced)
    // Optional umbrella grouping N atomic single-trade RFQs into one logical
    // procurement package. Tenant-scoped reads via companyId; all writes go
    // through Admin SDK in `sourcing-event-service` (step c).
    match /sourcing_events/{eventId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ADR-327 §17 Q29 — RFQ lines sub-collection (HYBRID Γ BOQ-first + ad_hoc)
    // Snapshot semantics: lines are written once at RFQ creation time and
    // never live-updated from BOQ. companyId denormalized on every line for
    // tenant isolation + collectionGroup queries. Vendor portal projection
    // strips internal fields (unitPrice, boqItemId, source) server-side.
    match /rfqs/{rfqId}/lines/{lineId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /trades/{tradeId} {
      // Trades are company-agnostic (system trades) or company-scoped (custom).
      // All authenticated users can read. Writes via Admin SDK only.
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ADR-330 Phase 4 — Material Catalog
    // Company-wide material master with ATOE FK + preferred suppliers.
    // Tenant-scoped reads via companyId; all writes through Admin SDK in
    // `material-service` (createMaterial/updateMaterial/softDeleteMaterial).
    match /materials/{materialId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ADR-330 Phase 5 — Framework Agreements
    // Multi-project vendor contracts with volume discount rules.
    // Tenant-scoped reads via companyId; all writes through Admin SDK in
    // `framework-agreement-service` (create/update/softDelete).
    match /framework_agreements/{agreementId} {
      allow read: if isSuperAdminOnly()
                  || (isAuthenticated()
                      && resource.data.keys().hasAny(['companyId'])
                      && belongsToCompany(resource.data.companyId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Authentication helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // User ownership helper
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // 🔒 ΤΑ ΠΕΔΙΑ ΘΕΜΑΤΟΦΥΛΑΚΗΣ ΑΡΧΕΙΟΥ — ADR-862 Φ0 (Β4 · Β10 · Β11) · ADR-866 §5.2
    // =========================================================================
    // Έξοδος ΜΟΝΟ του διακομιστή (AIP-216 output-only): αλλάζουν αποκλειστικά από τον ΕΝΑ
    // γραφέα (`services/iso19650/container-transitions.ts`, Admin SDK). ΜΙΑ λίστα για ΔΥΟ
    // διαμερίσματα: `files` (εταιρεία) και `files_personal` (άνθρωπος).
    // ⚠️ Η λίστα ΔΙΑΒΑΖΕΤΑΙ από το CHECK 3.87 (Κ1) — μείνε σε literal μέσα στο `hasAny([…])`.
    function cdeCustodyKeys() {
      return [
        'cdeState', 'cdeTeamId',
        'cdeShare', 'cdeSeal', 'cdeRelease', 'cdeWithdrawal',
        'cdeSupersession', 'supersededByFileId', 'supersededAt',
        'cdeReadReach'
      ];
    }

    // Καμία γραφή πελάτη δεν αγγίζει θεματοφυλακή — προσθήκη, αλλαγή ΚΑΙ αφαίρεση
    // (`affectedKeys()`, όχι σύγκριση τιμών: δείτε το σχόλιο στο `match /files`).
    function cdeCustodyUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(cdeCustodyKeys());
    }

    // =========================================================================
    // 🔒 ΤΑ ΠΕΔΙΑ ΔΕΣΜΕΥΣΗΣ ΑΡΧΕΙΟΥ — ADR-864 §21 (σιωπηλή δέσμευση)
    // =========================================================================
    // Έξοδος ΜΟΝΟ του ΕΝΑ γραφέα (`services/file-record/file-hold.service.ts`, Admin SDK,
    // δικαίωμα `legal:holds:manage`). Ο πελάτης δεν τα γράφει, δεν τα αλλάζει, δεν τα
    // ΑΦΑΙΡΕΙ — αλλιώς ένα `hold: 'legal'` θα μηδενιζόταν με ένα update και η επόμενη
    // οριστική διαγραφή θα περνούσε.
    // ⚠️ Η λίστα είναι ΑΚΡΙΒΩΣ το `FILE_HOLD_FIELDS` (`lib/files/file-hold.ts`)· την ισότητα
    //    τη φυλά η άγκυρα Α49 (`file-hold.test.ts`) μέσω του `rulesKeyListOf` — μείνε σε literal.
    function holdCustodyKeys() {
      return [
        'hold', 'holdPlacedBy', 'holdPlacedAt', 'holdReason',
        'holdReleasedBy', 'holdReleasedAt', 'retentionUntil'
      ];
    }

    // Καμία γραφή πελάτη δεν αγγίζει δέσμευση — προσθήκη, αλλαγή ΚΑΙ αφαίρεση (`affectedKeys()`).
    // 🔑 Ο κάδος ΜΕΝΕΙ ΑΝΟΙΧΤΟΣ (Δ21.1 — Google Vault · Box «silent legal hold»): ο φρουρός
    //    ρωτά «άγγιξες τη δέσμευση;», ΠΟΤΕ «είναι δεσμευμένο;».
    function holdCustodyUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(holdCustodyKeys());
    }

    // Γέννηση ΧΩΡΙΣ δέσμευση: κανένα κλειδί της, εκτός από ρητό `hold: 'none'` (= απουσία).
    // Αρχείο «δεσμευμένο από κούνια» θα ήταν δέσμευση που δεν έκρινε κανείς.
    function holdBornAbsent() {
      return request.resource.data.get('hold', 'none') == 'none'
             && !request.resource.data.keys().hasAny(holdCustodyKeys().removeAll(['hold']));
    }

    // Οριστική διαγραφή: ΜΟΝΟ χωρίς δέσμευση και χωρίς διατήρηση. Οι κανόνες δεν συγκρίνουν
    // την ISO `retentionUntil` με το τώρα ⇒ ΚΑΘΕ δηλωμένη διατήρηση αρνείται (συντηρητικά·
    // η ληγμένη καθαρίζεται από τον διακομιστή, Admin SDK, με τον κριτή `isHoldActive`).
    // `null` ⇒ απουσία, ίδια σημασία με τον κριτή (`hasActiveHold` · `isHoldActive`).
    function holdAllowsHardDelete() {
      return resource.data.get('hold', 'none') in ['none', null]
             && resource.data.get('retentionUntil', null) == null;
    }

    // =========================================================================
    // 📒 ΖΕΥΓΑΡΩΜΕΝΗ ΔΡΑΣΤΗΡΙΟΤΗΤΑ ΠΡΟΣΩΠΙΚΟΥ ΑΡΧΕΙΟΥ (ADR-866 §2.6.11 Ε-Φ0-4)
    // =========================================================================
    // Στους μεγάλους (Drive · Dropbox · Box) τη γραμμή δραστηριότητας τη γράφει η ΥΠΗΡΕΣΙΑ: ο
    // χρήστης ούτε την πλαστογραφεί ούτε την παραλείπει. Εδώ την ίδια εγγύηση τη δίνουν ΑΥΤΟΙ οι
    // κανόνες, και ΑΤΟΜΙΚΑ — η αλλαγή του αρχείου και η γραμμή της γράφονται στην ΙΔΙΑ δέσμη:
    //   · η αλλαγή αρνείται αν δεν δείχνει (`lastActivityId`) σε ΝΕΑ γραμμή της ίδιας δέσμης·
    //   · η γραμμή αρνείται αν δεν περιγράφει την αλλαγή που συμβαίνει (`get` πριν / `getAfter` μετά).
    // Γραφέας: `services/file-record/file-activity-commit.ts`.

    // Τα κλειδιά που κάνουν μια αλλαγή «δραστηριότητα»: κάδος/επαναφορά (`lifecycleState` ΚΑΙ το
    // legacy `isDeleted` — τα ερωτήματα φιλτράρουν και με τα δύο, άρα «κάδος μόνο με `isDeleted`»
    // θα ήταν κάδος χωρίς γραμμή) · μετονομασία (`displayName`).
    // ⚠️ Κάτοπτρο του `FILE_ACTIVITY_PAIRED_ACTIONS` (`types/file-audit.ts`) — άγκυρα Α35.
    function personalActivityKeys() {
      return ['lifecycleState', 'isDeleted', 'displayName'];
    }

    function personalActivityPath(activityId) {
      return /databases/$(database)/documents/file_audit_log_personal/$(activityId);
    }

    // Η ΑΛΛΑΓΗ: αγγίζει δραστηριότητα ⇔ δείχνει σε ΝΕΑ γραμμή, γραμμένη στην ΙΔΙΑ δέσμη. Και το
    // `lastActivityId` δεν αλλάζει ποτέ μόνο του — δείκτης χωρίς πράξη θα ήταν ψέμα.
    function personalActivityPaired() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let activityId = request.resource.data.get('lastActivityId', '');
      return (!changed.hasAny(personalActivityKeys()) && !changed.hasAny(['lastActivityId']))
             || (changed.hasAny(personalActivityKeys())
                 && changed.hasAny(['lastActivityId'])
                 && activityId is string
                 && activityId.size() > 0
                 && !exists(personalActivityPath(activityId))
                 && existsAfter(personalActivityPath(activityId)));
    }

    // Η ΓΡΑΜΜΗ: περιγράφει ΑΚΡΙΒΩΣ την αλλαγή του ΔΙΚΟΥ του αρχείου, που δείχνει σε ΑΥΤΗ τη γραμμή.
    // Αρχείο που δεν υπάρχει ⇒ `get` = null ⇒ σφάλμα ⇒ άρνηση (fail closed).
    function personalActivityMatchesChange(fileId, logId, action) {
      let path = /databases/$(database)/documents/files_personal/$(fileId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let wasTrashed = before.get('lifecycleState', 'active') == 'trashed'
                       || before.get('isDeleted', false) == true;
      return before.userId == request.auth.uid
             && after.get('lastActivityId', '') == logId
             && (
                  (action == 'delete' && !wasTrashed
                      && after.get('lifecycleState', '') == 'trashed' && after.get('isDeleted', false) == true)
                  || (action == 'restore' && wasTrashed
                      && after.get('lifecycleState', '') == 'active' && after.get('isDeleted', true) == false)
                  || (action == 'rename'
                      && after.get('displayName', '') != before.get('displayName', ''))
                );
    }

    // =========================================================================
    // 🔐 RFC v6 AUTHORIZATION HELPERS (PHASE 1 PREPARATION)
    // =========================================================================
    // These helpers enable future tenant-scoped access control.
    // Path migration: /collection/{id} → /companies/{companyId}/collection/{id}
    //
    // @see docs/rfc/authorization-rbac.md

    // Get user's companyId from custom claims
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }

    // Get user's globalRole from custom claims
    function getGlobalRole() {
      return request.auth.token.globalRole;
    }

    // Check if user is super_admin (system-wide access)
    function isSuperAdminOnly() {
      return isAuthenticated() && getGlobalRole() == 'super_admin';
    }

    // Check if user is company_admin or higher
    function isCompanyAdmin() {
      return isAuthenticated() && getGlobalRole() in ['super_admin', 'company_admin'];
    }

    // Check if user is internal_user or higher
    function isInternalUser() {
      return isAuthenticated() && getGlobalRole() in ['super_admin', 'company_admin', 'internal_user'];
    }

    // Check if user belongs to a specific company (tenant isolation)
    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserCompanyId() == companyId;
    }

    // P0-B FIX: Tenant-bound company admin (prevents cross-tenant writes)
    function isCompanyAdminOfCompany(companyId) {
      return isSuperAdminOnly() ||
             (getGlobalRole() == 'company_admin' && belongsToCompany(companyId));
    }

    // P0-B FIX: Tenant-bound internal user (prevents cross-tenant reads)
    function isInternalUserOfCompany(companyId) {
      return isSuperAdminOnly() ||
             (isInternalUser() && belongsToCompany(companyId));
    }

    // =========================================================================
    // 🏛️ ADR-657 — BIM AUTHORING vs PRESENTATION RBAC (TIER SSoT HELPERS)
    // =========================================================================
    // 📅 Added: 2026-07-15 (ADR-657)
    // Tier SSoT (which collection → which tier + requiredKeys):
    //   tests/firestore-rules/_registry/bim-tiers.ts
    //
    // Root bug (pre-ADR-657): 34/36 BIM blocks gated read+create on
    // belongsToCompany() ALONE — tenant, never role. `external_user` (the DEFAULT
    // role of every self-registration, ZERO floorplan permissions in
    // src/lib/auth/roles.ts) could read + create all company BIM geometry. Writes
    // also granted on ownership (`createdBy == uid ||`), bypassing the role gate.
    //
    // Two tiers — the ONLY difference is the `allow read` line:
    //   AUTHORING     read + write require isInternalUserOfCompany(). Reachable
    //                 only inside /dxf/viewer (AdminGuard). external_user DENIED.
    //   PRESENTATION  read stays tenant-wide (any role, incl. external_user, which
    //                 reads these client-side on /properties, ADR-370); write
    //                 requires isInternalUserOfCompany(). Phase 2 flips read →
    //                 AUTHORING once those hooks move behind a server route.
    // =========================================================================

    // AUTHORING read — editor-only, external_user denied.
    function canReadBimAuthoring(cid) {
      return isInternalUserOfCompany(cid);
    }

    // PRESENTATION read — tenant-wide (UNCHANGED behaviour; Phase 2 flips this).
    function canReadBimPresentation(cid) {
      return isSuperAdminOnly() || belongsToCompany(cid);
    }

    // Greppable-intent alias: both tiers write-gate on internal-user-of-company.
    function isBimWriter(cid) {
      return isInternalUserOfCompany(cid);
    }

    // CREATE — internal-user-of-company + companyId/createdBy match caller +
    // per-collection scope keys (requiredKeys from bim-tiers.ts).
    function canCreateBimEntity(requiredKeys) {
      return isSuperAdminOnly()
             || ( isInternalUser()
                  && request.resource.data.companyId == getUserCompanyId()
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.keys().hasAll(requiredKeys) );
    }

    // Immutable identity + audit origin (UNIFORM across all 29 entity blocks).
    function bimImmutablesUnchanged() {
      return request.resource.data.companyId == resource.data.companyId
             && request.resource.data.projectId == resource.data.projectId
             && request.resource.data.floorplanId == resource.data.floorplanId
             && request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    // G24 soft-lock anti-spoof (ADR-358 §6.8): editingBy.userId may only be self.
    function bimSoftLockValid() {
      return !request.resource.data.keys().hasAny(['editingBy'])
             || request.resource.data.editingBy.userId == request.auth.uid;
    }

    // UPDATE — internal-user-of-company + immutables + soft-lock. NO ownership grant.
    function canUpdateBimEntity() {
      return isSuperAdminOnly()
             || ( isBimWriter(resource.data.companyId) && bimImmutablesUnchanged() && bimSoftLockValid() );
    }

    // DELETE — internal-user-of-company. NO ownership grant.
    function canDeleteBimEntity() {
      return isBimWriter(resource.data.companyId);
    }

    // Legacy containers (floorplans + project_/building_/floor_/unit_floorplans) —
    // NO createdBy scope-key contract (predate it). Read tolerates docs missing
    // companyId (falls back to creator-only); create/write require internal user.
    function canReadLegacyFloorplan() {
      return isSuperAdminOnly()
             || (resource.data.keys().hasAny(['companyId']) && belongsToCompany(resource.data.companyId))
             || (!resource.data.keys().hasAny(['companyId']) && resource.data.createdBy == request.auth.uid);
    }
    function canCreateLegacyFloorplan() {
      return isSuperAdminOnly()
             || (isInternalUser() && request.resource.data.companyId == getUserCompanyId());
    }
    function canWriteLegacyFloorplan() {
      return isSuperAdminOnly()
             || ( isBimWriter(resource.data.companyId)
                  && ( !resource.data.keys().hasAny(['companyId'])
                       || request.resource.data.companyId == resource.data.companyId ) );
    }

    // =========================================================================
    // 📒 ACCOUNTING MODULE — TENANT ISOLATION HELPERS (Q3/Q4/Q7)
    // =========================================================================
    // 📅 Added: 2026-03-31 (AUDIT-2026-03-29, Εργασία #17 B-7)
    // 🔒 RBAC: super_admin/company_admin: full, internal_user: R/W, external_user: zero
    // 🏢 Pattern: companyId field-based isolation (Google pattern A)

    // Accounting: tenant-scoped read (internal_user+)
    function canReadAccounting(companyId) {
      return isSuperAdminOnly() || isInternalUserOfCompany(companyId);
    }

    // Accounting: tenant-scoped create (companyId + createdBy must match claims)
    function canCreateAccounting() {
      return isInternalUser()
             && request.resource.data.companyId is string
             && request.resource.data.companyId == getUserCompanyId()
             && request.resource.data.createdBy is string
             && request.resource.data.createdBy == request.auth.uid;
    }

    // Accounting: tenant-scoped create without createdBy (system-generated docs)
    function canCreateAccountingSystem() {
      return isInternalUser()
             && request.resource.data.companyId is string
             && request.resource.data.companyId == getUserCompanyId();
    }

    // Accounting: tenant-scoped update (creator or admin, companyId immutable)
    function canUpdateAccounting(companyId, createdBy) {
      return (request.auth.uid == createdBy || isCompanyAdminOfCompany(companyId))
             && request.resource.data.companyId == companyId;
    }

    // Accounting: tenant-scoped update without createdBy check (system docs)
    function canUpdateAccountingSystem(companyId) {
      return isInternalUserOfCompany(companyId)
             && request.resource.data.companyId == companyId;
    }

    // Accounting: delete — creator deletes own, admin deletes all (Q6 Xero/QBO pattern)
    function canDeleteAccounting(companyId, createdBy) {
      return request.auth.uid == createdBy || isCompanyAdminOfCompany(companyId);
    }

    // Accounting: admin-only write for settings/config singletons
    function canWriteAccountingSingleton(companyId) {
      return isCompanyAdminOfCompany(companyId);
    }

    // =========================================================================
    // 🎯 CRM MODULE — OWNER-AWARE TENANT ISOLATION HELPERS
    // =========================================================================
    // 📅 Added: 2026-09-08 (ADR-841 §7 Α21.14.8 — η ένωση των διπλών μπλοκ)
    // 🏢 Χρήστες: leads · opportunities · activities
    //
    // 🔴 ΓΙΑΤΙ ΥΠΑΡΧΟΥΝ. Οι τρεις συλλογές είχαν η καθεμία ΔΥΟ `match` μπλοκ στην
    //    ΙΔΙΑ διαδρομή (PR-1B και PR-1D, 2026-01-29). Στο Firestore το `allow`
    //    είναι η ΕΝΩΣΗ όσων μπλοκ ταιριάζουν ⇒ το χαλαρότερο νικά σιωπηλά. Άρα η
    //    αυστηροποίηση του PR-1D γράφτηκε, πέρασε review, μπήκε στο main — και
    //    ΔΕΝ ΙΣΧΥΣΕ ΠΟΤΕ. Μετρημένο 2026-09-08 στον emulator, σε 9 σενάρια: η
    //    ένωση ήταν ΑΚΡΙΒΩΣ το PR-1B, σε ΟΛΑ. Δεν ήταν ερμηνεία — ήταν μέτρηση.
    //
    // 🏆 ΠΟΙΟΣ ΕΙΝΑΙ «ΚΑΤΟΧΟΣ» — Η ΒΙΟΜΗΧΑΝΙΑ ΕΙΝΑΙ ΟΜΟΦΩΝΗ: ο ανατεθειμένος.
    //    Salesforce: το `OwnerId` ενός Lead ΕΙΝΑΙ ο ανατεθειμένος — η ανάθεση
    //    ΓΙΝΕΤΑΙ αλλάζοντας τον owner. HubSpot: «users set as the owner have owner
    //    access to the record». Zoho: «individual contributors see their own
    //    records». ⇒ Το `assignedTo` είναι ΔΙΚΑΙΩΜΑ· το `createdBy` είναι ΙΣΤΟΡΙΚΟ.
    //
    // 📊 ΤΙ ΑΚΡΙΒΩΣ ΑΛΛΑΞΕ Η ΕΝΩΣΗ — ΜΕΤΡΗΜΕΝΟ, ΟΧΙ ΕΚΤΙΜΩΜΕΝΟ.
    //    756 μετρήσεις (3 συλλογές × 7 πρόσωπα × 10 σχήματα εγγράφου × 3 πράξεις,
    //    + create/list/ghost), καθεμία σε ΚΑΘΑΡΟ κόσμο. Διαφορές: **3**, και οι
    //    τρεις η ΙΔΙΑ — `super_admin` που διαγράφει έγγραφο που ΔΕΝ ΥΠΑΡΧΕΙ:
    //    ALLOW → DENY. Είναι ΑΚΡΙΒΩΣ η αυστηροποίηση που έγραψε το PR-1D και δεν
    //    ίσχυσε ποτέ, και χτυπά μόνο σε no-op (η διαγραφή ανύπαρκτου εγγράφου δεν
    //    αλλάζει τίποτα). Καμία διαδρομή του κώδικα δεν διαγράφει «στα τυφλά»
    //    αυτές τις συλλογές από πελάτη. Οι υπόλοιπες **753** μετρήσεις είναι
    //    ταυτόσημες πριν/μετά.
    //
    // ⚠️ ΟΙ ΦΡΟΥΡΟΙ `keys().hasAny([...])` ΔΕΝ ΑΛΛΑΖΟΥΝ ΣΥΜΠΕΡΙΦΟΡΑ (0/756) —
    //    αλλάζουν ΜΗΧΑΝΙΣΜΟ, και ΑΥΤΟ είναι το ζητούμενο. Χωρίς αυτούς, το
    //    `resource.data.x` σε πεδίο που ΛΕΙΠΕΙ παράγει *σφάλμα αποτίμησης*, και η
    //    άρνηση προκύπτει από το σφάλμα. Όμως το CEL ΑΠΟΡΡΟΦΑ σφάλματα όταν άλλο
    //    σκέλος `||` είναι αληθές — ΜΕΤΡΗΜΕΝΟ εδώ: legacy έγγραφο ΧΩΡΙΣ `createdBy`
    //    διαβάζεται σήμερα κανονικά, ακριβώς επειδή το σφάλμα απορροφήθηκε από το
    //    σκέλος του `assignedTo`. Άρα «άρνηση από σφάλμα» δεν είναι εγγύηση — είναι
    //    σύμπτωση, και ένα νέο σκέλος `||` αύριο την εξαφανίζει σιωπηλά. Ρητό
    //    κατηγόρημα δεν απορροφάται.
    //
    // 🔁 ΠΩΣ ΤΟ ΞΑΝΑΜΕΤΡΑΣ: το `emulator.ts` δέχεται `FIRESTORE_RULES_FILE=<αρχείο>`
    //    — τρέξε την ίδια σουίτα σε δύο εκδοχές των κανόνων και σύγκρινε. Αυτή η
    //    ραφή είναι ο λόγος που η παραπάνω πρόταση είναι αριθμός και όχι γνώμη.

    // CRM: το έγγραφο ανήκει σε tenant (έχει `companyId`) — και είναι ο δικός μου.
    function crmInTenant(doc) {
      return doc.keys().hasAny(['companyId']) && belongsToCompany(doc.companyId);
    }

    // CRM: έγγραφο ΠΡΙΝ τη μετανάστευση `companyId` — ο μόνος δρόμος χωρίς tenant.
    function crmIsLegacy(doc) {
      return !doc.keys().hasAny(['companyId']);
    }

    // CRM: ο καλών το δημιούργησε. ΙΣΤΟΡΙΚΟ — δεν συνεπάγεται ότι το δουλεύει.
    function crmIsCreator(doc) {
      return doc.keys().hasAny(['createdBy']) && doc.createdBy == request.auth.uid;
    }

    // CRM: ο καλών ΤΟ ΔΟΥΛΕΥΕΙ — ο «owner» της βιομηχανίας (Salesforce/HubSpot/Zoho).
    function crmIsAssignee(doc) {
      return doc.keys().hasAny(['assignedTo']) && doc.assignedTo == request.auth.uid;
    }

    // CRM: διαχειριστής της εταιρείας ΤΟΥ ΕΓΓΡΑΦΟΥ (όχι της δικής μου, αν διαφέρουν).
    function crmIsCompanyAdmin(doc) {
      return doc.keys().hasAny(['companyId']) && isCompanyAdminOfCompany(doc.companyId);
    }

    // CRM: το έγγραφο ΔΕΝ ανήκει σε ΞΕΝΟ tenant — είναι είτε δικό μας, είτε legacy
    //      (πριν τη μετανάστευση `companyId`, χωρίς εταιρεία-ιδιοκτήτη).
    //
    // 🔴 ΤΟ ΚΕΝΟ ΠΟΥ ΚΛΕΙΝΕΙ, ΜΕΤΡΗΜΕΝΟ 2026-09-08 ΠΑΝΩ ΣΤΟ ΤΟΤΕ `main`:
    //    ο έλεγχος tenant υπήρχε στο `read` και **ΕΛΕΙΠΕ** από `update`/`delete`.
    //    Τα σκέλη `createdBy` / `assignedTo` δεν ρωτούσαν σε ΠΟΙΟΝ ανήκει το
    //    έγγραφο — μόνο ποιος το έγραψε ή σε ποιον ανατέθηκε. Αποτέλεσμα:
    //
    //      χρήστης της company-A · έγγραφο της company-B που ΕΚΕΙΝΟΣ δημιούργησε
    //      → read: DENY   ·   update: **ALLOW**   ·   delete: **ALLOW**
    //
    //    Και στις **τρεις** συλλογές, όχι μόνο στα `leads`. Δηλαδή **εγγραφή σε
    //    έγγραφο που ΔΕΝ μπορείς να διαβάσεις**, πάνω από το σύνορο του tenant.
    //
    // 🔑 ΓΙΑΤΙ ΤΟ ΚΛΕΙΣΙΜΟ ΔΕΝ ΜΠΟΡΕΙ ΝΑ ΚΛΕΙΔΩΣΕΙ ΚΑΝΕΝΑΝ ΠΡΑΓΜΑΤΙΚΟ ΧΡΗΣΤΗ:
    //    στις ίδιες μετρήσεις το `read` ήταν **DENY** σε ΚΑΘΕ μία από αυτές τις
    //    περιπτώσεις. Καμία τίμια οθόνη δεν μπορεί να δείξει έγγραφο που δεν
    //    διαβάζεται, άρα καμία τίμια ροή δεν μπορεί να το ενημερώσει. Η
    //    δυνατότητα ήταν **απροσπέλαστη από νόμιμο πελάτη** — προσπελάσιμη μόνο
    //    από κάποιον που φτιάχνει το αίτημα ο ίδιος.
    //
    // ⚠️ ΡΕΑΛΙΣΤΙΚΟ ΣΕΝΑΡΙΟ, ΟΧΙ ΘΕΩΡΗΤΙΚΟ: υπάλληλος αλλάζει εταιρεία. Το `uid`
    //    του μένει το ίδιο, η αξίωση `companyId` αλλάζει. Κάθε lead / ευκαιρία /
    //    δραστηριότητα που δημιούργησε στην ΠΑΛΙΑ εταιρεία παρέμενε γι' αυτόν
    //    **εγγράψιμη και διαγράψιμη** — αόρατα, αφού δεν μπορούσε να τη διαβάσει.
    //
    // 🏆 ΕΙΝΑΙ ΤΟ ΔΟΓΜΑ ΤΟΥ ΙΔΙΟΥ ΑΡΧΕΙΟΥ: το `canWriteLegacyFloorplan()` δένει
    //    ήδη τον γραφέα στο tenant του εγγράφου (`isBimWriter(resource.data.companyId)`).
    //    Το CRM ήταν η εξαίρεση, όχι ο κανόνας.
    function crmNotForeignTenant(doc) {
      return crmIsLegacy(doc) || crmInTenant(doc);
    }

    // CRM: ποιος γράφει ΠΑΝΤΑ — δημιουργός, διαχειριστής εταιρείας, super admin.
    //      Ο δημιουργός ΔΕΜΕΝΟΣ στο tenant του εγγράφου· ο διαχειριστής είναι ήδη
    //      δεμένος (το `isCompanyAdminOfCompany` περνά από `belongsToCompany`).
    //      ⚠️ Το σκέλος του ανατεθειμένου ΔΕΝ είναι εδώ ΕΠΙΤΗΔΕΣ: μπαίνει ρητά, ανά
    //      συλλογή, ώστε η ασυμμετρία των τριών να είναι ΟΡΑΤΗ στο σημείο της
    //      απόφασης — όχι κρυμμένη μέσα σε κοινό βοηθό.
    function crmWriterIsPrivileged(doc) {
      return isSuperAdminOnly()
             || (crmIsCreator(doc) && crmNotForeignTenant(doc))
             || crmIsCompanyAdmin(doc);
    }

    // CRM: το `companyId` δεν μετακινείται ΠΟΤΕ με ενημέρωση πελάτη.
    //      (Τα legacy έγγραφα δεν έχουν το πεδίο — δεν υπάρχει τι να διατηρηθεί.)
    function crmCompanyIdUnchanged(doc) {
      return !doc.keys().hasAny(['companyId'])
             || request.resource.data.companyId == doc.companyId;
    }

    // CRM: δημιουργία — το `companyId` του φορτίου ΠΡΕΠΕΙ να είναι του καλούντος.
    //      Το `resource == null` είναι η προϋπόθεση της δημιουργίας, ρητά.
    function crmCanCreate() {
      return isAuthenticated()
             && resource == null
             && request.resource.data.companyId == getUserCompanyId();
    }

    // =========================================================================
    // 🏠 PROPERTY FIELDS SECURITY HELPERS (2026-01-24, renamed 2026-04-01)
    // =========================================================================
    // These helpers enable tenant-scoped access for properties via project→company lookup
    // Properties don't have companyId directly - must lookup via project reference

    // Get companyId from a project document (for tenant isolation)
    // Usage: getProjectCompanyId(resource.data.projectId) — `projectId` is the canonical
    // cross-reference field name on every child collection (ADR-284 §3.1). Do NOT write
    // `resource.data.project`: the key does not exist, and a missing key errors → deny.
    // =========================================================================
    // ⚠️ ΜΗΝ ΠΡΟΣΘΕΣΕΙΣ ΕΔΩ ΦΡΟΥΡΟ `exists()` — ΜΕΤΡΗΘΗΚΕ ΑΔΡΑΝΗΣ (ADR-823)
    // =========================================================================
    //
    // Το `get()` σε έγγραφο **που δεν υπάρχει** επιστρέφει `null`, και το `.data`
    // πάνω σε `null` είναι **σφάλμα αξιολόγησης**, όχι `false`. Η προφανής άμυνα
    // είναι `exists(...) ? get(...).data.companyId : null`. **Γράφτηκε, μετρήθηκε
    // ζωντανά, και ΑΦΑΙΡΕΘΗΚΕ** (2026-08-27):
    //
    //   9 σχήματα ερωτήματος × 2 εκδοχές κανόνων (ΜΕ / ΧΩΡΙΣ φρουρό)
    //   → **18/18 ΤΑΥΤΟΣΗΜΕΣ ΕΤΥΜΗΓΟΡΙΕΣ**
    //
    // Δοκιμάστηκαν: σημειακή ανάγνωση υγιούς & κρεμάμενου· `where(ξένο κλειδί)`·
    // `where(ξένο κλειδί, 'in', [υπαρκτό, φάντασμα])` — το **δυσκολότερο**, που
    // αναμειγνύει τα δύο· και γονέας που υπάρχει αλλά **δεν έχει ούτε `companyId`
    // ούτε `projectId`**. Όλα σε κόσμο **χωρίς** `companyId` στα παιδιά, δηλαδή
    // εκεί που το εφεδρικό σκέλος είναι η **ΜΟΝΗ** προσβάσιμη διαδρομή.
    //
    // 🔑 **ΓΙΑΤΙ**: σφάλμα αξιολόγησης και `false` δίνουν **και τα δύο** άρνηση, σε
    // **κάθε** κοκκομετρία που εκθέτει το Firestore. Το σφάλμα **ΔΕΝ μεταδίδεται**
    // σε αδελφά έγγραφα: το `list` κρίνεται πάνω στο **δυνητικό σύνολο** που ορίζει
    // το ερώτημα, και το εφεδρικό σκέλος γίνεται προσβάσιμο **μόνο** όταν το
    // ερώτημα **καρφώνει** το ξένο κλειδί — άρα το καρφώνει σε **μία** τιμή.
    //
    // 🔴 **ΑΡΑ ΤΟ «ΕΝΑ ΧΑΛΑΣΜΕΝΟ ΒΙΒΛΙΟ ΚΛΕΙΔΩΝΕΙ ΟΛΗ ΤΗ ΒΙΒΛΙΟΘΗΚΗ» ΕΙΝΑΙ ΨΕΥΔΕΣ.**
    // Το κρεμάμενο κλειδί αρνείται **μόνο το ερώτημα που το ζητά**. Αυτό που
    // κλείδωνε τη βιβλιοθήκη ήταν ο **ανικανοποίητος κανόνας** (έλειπε το σκέλος
    // `companyId`) — δες `match /properties`. Άγκυρες: `tenant-list-satisfiability`
    // Κ1/Κ2 (πέφτουν σε 5 μεταλλάξεις) και Κ5 (κλειδώνει το υπόλοιπο ως γεγονός).
    //
    // ⚠️ Το `resource.data.get('projectId','')` **επίσης δεν είναι λύση**: μετρήθηκε
    // ότι το `get()` με **κενό segment** γυρίζει `null` ⇒ `Null value error`.
    // Ο σωστός φρουρός για το **λείπον** κλειδί είναι `keys().hasAny([...])` στο
    // σημείο κλήσης — και υπάρχει ήδη και στις δέκα συλλογές της κλάσης.
    function getProjectCompanyId(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.companyId;
    }

    // Check if user belongs to the company that owns this project
    function belongsToProjectCompany(projectId) {
      return isSuperAdminOnly() || belongsToCompany(getProjectCompanyId(projectId));
    }

    // Check if user is company admin of the project's company
    function isCompanyAdminOfProject(projectId) {
      return isCompanyAdminOfCompany(getProjectCompanyId(projectId));
    }

    // =========================================================================
    // 🏢 BUILDING LOOKUP HELPERS (PR-1D: floors, storage_units, parking_spots)
    // =========================================================================
    // 📅 Added: 2026-01-29 (Security Gate Phase 1 - PR-1D)
    // 🏢 ENTERPRISE: Similar pattern to project lookup, with project fallback
    //
    // Get the companyId from a building document
    // Handles both direct companyId and projectId fallback
    // ⚠️ Δύο ΑΝΕΞΑΡΤΗΤΟΙ τρόποι να σκάσει εδώ: (α) το κτίριο δεν υπάρχει ⇒ `get()`
    // → `null` → `.data`· (β) το κτίριο υπάρχει αλλά δεν έχει **ούτε** `companyId`
    // **ούτε** `projectId` ⇒ σκάει το `building.projectId`. **Και οι δύο** μετρήθηκαν
    // (2026-08-27) και **παράγουν ακριβώς την ίδια ετυμηγορία** με έναν φρουρό
    // `exists()`/`hasAny` — γι' αυτό ο φρουρός **δεν** μπήκε. Πλήρες σκεπτικό και
    // αριθμοί: δες το σχόλιο πάνω από τον `getProjectCompanyId`.
    function getBuildingCompanyId(buildingId) {
      let building = get(/databases/$(database)/documents/buildings/$(buildingId)).data;
      // If building has direct companyId, use it
      // Otherwise, fall back to project lookup
      return building.keys().hasAny(['companyId'])
             ? building.companyId
             : getProjectCompanyId(building.projectId);
    }

    // Check if user belongs to the company that owns this building
    function belongsToBuildingCompany(buildingId) {
      return isSuperAdminOnly() || belongsToCompany(getBuildingCompanyId(buildingId));
    }

    // Property Fields allowlist - only these fields can be updated by non-super-admin users
    // 🏢 ENTERPRISE: Prevents modification of structural fields (project, id)
    // 📅 Updated 2026-01-24: Added 'name' to allowlist (rename is allowed for company admins)
    // 📅 Updated 2026-01-24: Added buildingId, floorId, linkedSpaces for Property Linking System
    function isAllowedPropertyFieldUpdate() {
      let allowedFields = [
        // Identity (editable by company admins)
        'name', 'description',
        // Unit Linking System (Phase 1-2) - Building/Floor/LinkedSpaces
        'buildingId', 'floorId', 'linkedSpaces',
        // Phase 1-5 Unit Fields
        'bedrooms', 'bathrooms', 'wc',
        'areas', 'orientation', 'orientations', 'condition', 'energyClass',
        'heating', 'cooling', 'flooring', 'frames', 'glazing',
        'interiorFeatures', 'securityFeatures',
        // Layout
        'layout',
        // Systems & Finishes
        'systemsOverride', 'finishes', 'energy',
        // Metadata
        'updatedAt', 'updatedBy',
        // Operational
        'operationalStatus', 'unitCoverage',
        // ADR-329 §3.9 — soft archive
        'archivedAt', 'archivedBy'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // Check that structural fields are not being modified (invariants)
    // 🏢 ENTERPRISE: Prevents "re-tenanting" properties via client update
    // 📅 Updated 2026-01-24: Removed 'name' from invariants (rename is now allowed)
    // 📅 Updated 2026-01-24: Removed buildingId/floorId from invariants (Property Linking System)
    //    - Properties CAN be moved between buildings/floors within the SAME project
    //    - Properties CANNOT be moved to a different project (tenant isolation)
    function propertyStructuralFieldsUnchanged() {
      return request.resource.data.projectId == resource.data.projectId
             && request.resource.data.id == resource.data.id;
    }

    // =========================================================================
    // 🔤 COMPANY_FONTS COLLECTION — DXF TEXT ENGINE (ADR-344 Phase 6.E)
    // =========================================================================
    // 🔒 SECURITY: Tenant-scoped via companyId. Read = any member of the
    //              company. Write = company admin / super admin only.
    // 📅 Added: 2026-05-11 (ADR-344 Phase 6.E)
    //
    // Security Model:
    //   - READ:   Any authenticated member of the font's company
    //   - CREATE: Company admin (or super admin) writing for own company
    //   - UPDATE: Company admin / super admin, companyId immutable
    //   - DELETE: Company admin / super admin
    // =========================================================================
    match /company_fonts/{fontId} {

      // 📖 READ: Tenant-scoped — every member of the company can list its fonts
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Company admin (or super admin) creating for own company
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['companyId'])
                    && request.resource.data.companyId is string
                    && (
                         isSuperAdminOnly()
                         || (request.resource.data.companyId == getUserCompanyId()
                             && isCompanyAdminOfCompany(request.resource.data.companyId))
                       );

      // 📝 UPDATE: Company admin / super admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      // 🗑️ DELETE: Company admin / super admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // ✏️ TEXT_TEMPLATES COLLECTION — DXF TEXT ENGINE (ADR-344 Phase 7.B)
    // =========================================================================
    // 🔒 SECURITY: Tenant-scoped via companyId. Read = any member of the
    //              company. Write = company admin / super admin only.
    //              Server-side authoring also goes through the Admin SDK
    //              service (text-template.service.ts) which calls
    //              EntityAuditService.recordChange on every mutation.
    // 📅 Added: 2026-05-11 (ADR-344 Phase 7.B)
    //
    // Security Model:
    //   - READ:   Any authenticated member of the template's company
    //   - CREATE: Company admin (or super admin) writing for own company
    //   - UPDATE: Company admin / super admin, companyId immutable
    //   - DELETE: Company admin / super admin
    //
    // Test coverage: pending entry in coverage-manifest.ts (Phase 7.E).
    // =========================================================================
    match /text_templates/{templateId} {

      // 📖 READ: Tenant-scoped — every member of the company can list its templates
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Company admin (or super admin) creating for own company
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['companyId'])
                    && request.resource.data.companyId is string
                    && (
                         isSuperAdminOnly()
                         || (request.resource.data.companyId == getUserCompanyId()
                             && isCompanyAdminOfCompany(request.resource.data.companyId))
                       );

      // 📝 UPDATE: Company admin / super admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      // 🗑️ DELETE: Company admin / super admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // ADR-344 Phase 8 — DXF Text Engine custom dictionary
    //
    // Per-company spell-check terms (CAD/architectural vocabulary, e.g.
    // «οπτοπλινθοδομή»). Owner: company_admin. Visible to: any tenant member
    // (drives client-side spell-check decoration). Identical rule shape to
    // `text_templates` (Phase 7.E) — tenant_admin_write.
    //
    // Permission split happens at the HTTP layer (`dxf:text:edit` for CREATE
    // via API, `dxf:dictionary:manage` for UPDATE/DELETE via API). The rule
    // here is defense-in-depth — clients are expected to write via the
    // `/api/dxf/custom-dictionary` routes (Admin SDK + audit + Zod), not
    // directly via Firestore SDK.
    //
    //   - READ:   Any tenant member (super admin or same-tenant).
    //   - CREATE: Company admin / super admin (defense-in-depth — direct
    //             client writes bypass audit).
    //   - UPDATE: Company admin / super admin (companyId immutable).
    //   - DELETE: Company admin / super admin.
    //
    // Test coverage: tests/firestore-rules/suites/text_custom_dictionary.rules.test.ts
    // =========================================================================
    match /text_custom_dictionary/{entryId} {

      // 📖 READ: Tenant-scoped — every member of the company can list its entries
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Company admin (or super admin) creating for own company
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['companyId'])
                    && request.resource.data.companyId is string
                    && (
                         isSuperAdminOnly()
                         || (request.resource.data.companyId == getUserCompanyId()
                             && isCompanyAdminOfCompany(request.resource.data.companyId))
                       );

      // 📝 UPDATE: Company admin / super admin, companyId immutable
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      // 🗑️ DELETE: Company admin / super admin
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // ADR-358 §5.9 Q12 Phase 13B — DXF Layer State Templates (cross-project)
    //
    // Company-scoped, shareable layer state templates. Used by every DXF
    // project in the same tenant to clone a saved layer-visibility/style
    // configuration. Soft delete via `deletedAt` ISO timestamp (30-day window);
    // hard delete reserved for company_admin + the background purge job.
    //
    //   - READ:   Any tenant member (super admin or same-tenant).
    //   - CREATE: Company admin / super admin only — `save-as-template` is a
    //             curated action, not freely user-driven.
    //   - UPDATE: Company admin / super admin. `companyId` immutable.
    //             Soft delete = UPDATE setting `deletedAt`.
    //   - DELETE: Company admin / super admin (hard purge).
    //
    // @see src/services/dxf-layer-state-template.service.ts (client SSoT)
    // @see src/subapps/dxf-viewer/types/layer-state-template.ts (type SSoT)
    // =========================================================================
    match /dxf_layer_state_templates/{templateId} {

      // 📖 READ: Tenant-scoped — every member of the company can browse templates
      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      // ✍️ CREATE: Company admin (or super admin) creating for own company
      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['companyId', 'name', 'snapshot'])
                    && request.resource.data.companyId is string
                    && (
                         isSuperAdminOnly()
                         || (request.resource.data.companyId == getUserCompanyId()
                             && isCompanyAdminOfCompany(request.resource.data.companyId))
                       );

      // 📝 UPDATE: Company admin / super admin, companyId immutable
      // (soft delete = UPDATE setting `deletedAt`)
      allow update: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       )
                    && request.resource.data.companyId == resource.data.companyId;

      // 🗑️ DELETE: Company admin / super admin (hard purge — bypass soft window)
      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // =========================================================================
    // ADR-358 §5.9 Q12 Phase 13B — DXF Template Category catalog (free-string)
    //
    // Per-company catalog of user-defined template categories. Auto-created
    // on the service side when a template is saved with a category not yet
    // present in the catalog — so the UI dropdown grows organically without
    // an admin-curated list.
    //
    //   - READ:   Any tenant member (drives the category dropdown).
    //   - CREATE: Any tenant member (auto-create from "Save as Template").
    //             `companyId` must match the user's tenant claim.
    //   - UPDATE: Disabled — categories are immutable labels (rename = create
    //             a new one, leave orphans alone).
    //   - DELETE: Company admin / super admin (manual cleanup only).
    // =========================================================================
    match /dxf_template_categories/{categoryId} {

      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      allow create: if isAuthenticated()
                    && resource == null
                    && request.resource.data.keys().hasAll(['companyId', 'value'])
                    && request.resource.data.companyId is string
                    && request.resource.data.value is string
                    && (
                         isSuperAdminOnly()
                         || request.resource.data.companyId == getUserCompanyId()
                       );

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource != null
                    && (
                         isSuperAdminOnly()
                         || isCompanyAdminOfCompany(resource.data.companyId)
                       );
    }

    // ─── PERFORMANCE DIAGNOSTICS (ADR-366 §B.5 + §C.7.Q2 + §C.7.Q4) ─────
    // User-submitted 3D BIM HUD snapshots. Server-only writes via
    // /api/performance-diagnostics (Admin SDK + EntityAuditService audit).
    // Read: doc owner OR super-admin. Tenant isolation via companyId.
    //   - CREATE: deny (server-only via Admin SDK)
    //   - UPDATE: super-admin only — restricted to triage fields
    //             {status, assignedSuperAdminId, internalNotes, triageHistory}.
    //             Base fields (id, companyId, userId, projectId, renderMode,
    //             metrics, screenshotUrl, comment, source, createdAt) are
    //             immutable. Server routes use Admin SDK and bypass these
    //             rules, so backfill / lazy migration is unaffected.
    //   - DELETE: super-admin only
    match /performance_diagnostics/{diagId} {

      allow read: if isAuthenticated()
                  && resource != null
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['userId'])
                           && resource.data.userId == request.auth.uid
                           && resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      allow create: if false;

      allow update: if isAuthenticated()
                    && resource != null
                    && isSuperAdminOnly()
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'assignedSuperAdminId', 'internalNotes', 'triageHistory']);

      allow delete: if isAuthenticated()
                    && resource != null
                    && isSuperAdminOnly();
    }

    // ─── BIM PERFORMANCE TELEMETRY (ADR-366 §C.7.Q3) ─────────────────────
    // GDPR-anonymized performance samples. TOP-LEVEL, no companyId (anonymity
    // preserved). All client traffic flows through the Admin-SDK ingest route
    // at /api/telemetry/bim-performance; ERASE flows through .../erase. Client
    // writes/reads are denied at the rules layer.
    //   - READ:   super-admin only (no per-tenant exposure — anonymous data)
    //   - CREATE: deny (server-only via Admin SDK)
    //   - UPDATE: deny (samples are immutable)
    //   - DELETE: deny (server-only via Admin SDK erase route)
    match /bim_performance_telemetry/{telemetryId} {

      allow read: if isAuthenticated() && isSuperAdminOnly();

      allow create, update, delete: if false;
    }

    // ─── CONSTRUCTION ALERTS (ADR-266 §5.8 Phase D.3) ────────────────────
    // Read: tenant-scoped (companyId must match). Created by Admin SDK only.
    // Update: dismiss only — status field + dismissedAt/dismissedBy.
    match /construction_alerts/{alertId} {

      allow read: if isAuthenticated()
                  && (
                       isSuperAdminOnly()
                       || (resource.data.keys().hasAny(['companyId'])
                           && belongsToCompany(resource.data.companyId))
                     );

      allow create: if false;

      allow update: if isAuthenticated()
                    && resource != null
                    && (isSuperAdminOnly() || belongsToCompany(resource.data.companyId))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'dismissedAt', 'dismissedBy'])
                    && request.resource.data.status in ['dismissed', 'resolved'];

      allow delete: if false;
    }

    // ─── OAUTH 2.1 AUTHORIZATION SERVER (ADR-738) ────────────────────────
    // ΚΑΘΟΛΙΚΟ deny — και για ανάγνωση. Οι τέσσερις συλλογές κρατούν
    // διαπιστευτήρια: SHA-256 access/refresh tokens, PKCE challenges,
    // authorization codes. Ένα `allow read` έστω και tenant-scoped θα έδινε σε
    // κάθε συνδεδεμένο browser τη δυνατότητα να απαριθμήσει hashes και χρόνους
    // λήξης — υλικό για offline επίθεση και για χρονική ανάλυση.
    //
    // Η οθόνη «συνδεδεμένοι πράκτορες» ΔΕΝ διαβάζει από εδώ: περνά από API
    // route με Admin SDK, που επιστρέφει **προβολή** (όνομα client, scopes,
    // ημερομηνία) χωρίς κανένα κρυπτογραφικό υλικό. Δηλαδή η ορατότητα
    // υπάρχει· απλώς δεν περνά από τα rules.
    match /oauth_clients/{clientDocId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    match /oauth_auth_requests/{authRequestDocId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    match /oauth_codes/{codeDocId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    match /oauth_tokens/{tokenDocId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    match /oauth_consents/{consentDocId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ── ΧΡΟΝΟΠΡΟΓΡΑΜΜΑΤΙΣΜΟΣ (ADR-739) ──────────────────────────────────────
    // Κατάσταση εκτέλεσης ανά προγραμματισμένη εργασία (lease + lastSuccessAt).
    // Γράφεται ΑΠΟΚΛΕΙΣΤΙΚΑ από τον dispatcher μέσω Admin SDK.
    //
    // ⚠️ Δεν είναι απλώς «εσωτερικά δεδομένα»: ένας client που μπορούσε να γράψει
    // εδώ θα παρέτεινε ένα lease επ' αόριστον και θα **σταματούσε τα αντίγραφα
    // ασφαλείας** χωρίς να αγγίξει καμία άλλη συλλογή — μια άρνηση υπηρεσίας που
    // δεν θα φαινόταν πουθενά αλλού. Η άρνηση είναι ρητή για τον ίδιο λόγο που
    // είναι ρητή στα oauth_*: το «καλύπτεται από το default-deny» είναι σωστό
    // σήμερα και εύθραυστο αύριο.
    match /cron_job_state/{jobSlug} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ── ΤΟ ΕΥΡΕΤΗΡΙΟ ΨΕΥΔΩΝΥΜΩΝ ΧΩΡΟΥ (ADR-787 §5.3 δ · Κ-1) ────────────────
    // «Ποιος χώρος λέγεται έτσι;» — κλειδί εγγράφου = ο σκελετός UTS #39.
    //
    // ⚠️ Η άρνηση είναι ΡΗΤΗ, και ο λόγος είναι ο ίδιος με τα oauth_* και το
    // cron_job_state από πάνω: το «καλύπτεται από το default-deny» είναι σωστό
    // ΣΗΜΕΡΑ και εύθραυστο ΑΥΡΙΟ. Μέχρι το Κ-1 (2026-08-25) η συλλογή είχε
    // ΜΗΔΕΝ έγγραφα και ΜΗΔΕΝ καλούντες· από τη στιγμή που ο κάθε χρήστης
    // μπορεί να δεσμεύσει ψευδώνυμο, η σιωπή έπαψε να είναι αθώα.
    //
    // ✍️ WRITE: ΜΟΝΟ ο διακομιστής (`lib/workspace/alias-registry.ts`, Admin SDK).
    //    ⛔ ΜΗΝ ανοίξεις γραφή στον πελάτη: η μοναδικότητα επιβάλλεται από το
    //    `create()` που αποτυγχάνει αν το έγγραφο υπάρχει — όποιος μπορεί να
    //    γράψει εδώ, μπορεί να ΚΛΕΨΕΙ ή να ΚΑΤΑΛΑΒΕΙ το όνομα ξένου γραφείου.
    //
    // 📖 READ: ΚΑΝΕΝΑΣ. Το ερώτημα «ποιος χώρος έχει αυτό το όνομα;» απαντιέται
    //    ΜΟΝΟ στον διακομιστή. Ανάγνωση από τον πελάτη — ακόμη και σημειακή —
    //    θα έκανε το ευρετήριο όργανο ΑΠΑΡΙΘΜΗΣΗΣ γραφείων, που το ADR-787
    //    Ε-5 §4 #1 απαγορεύει ρητά. Γι' αυτό δεν υπάρχει ούτε σκέλος `read`.
    match /workspace_aliases/{aliasSkeleton} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ── ΤΟ ΜΗΤΡΩΟ ΤΩΝ ΠΑΓΩΜΕΝΩΝ ΑΠΟΔΕΙΚΤΙΚΩΝ ΕΝΤΟΛΗΣ (ADR-864 §20 · §21) ─────────
    // Μία εγγραφή ανά παγωμένο αντίγραφο βεβαίωσης (`mandate-evidence/` στο bucket):
    // κατάσταση διατήρησης, `retainUntil`, νομική δέσμευση, ταφόπλακα.
    //
    // ✍️ WRITE: ΜΟΝΟ ο διακομιστής (`services/mandate/evidence-registry.ts` ·
    //    `evidence-retention.service.ts`, Admin SDK). Πελάτης που γράφει εδώ θα μπορούσε
    //    να ΜΙΚΡΥΝΕΙ τη διατήρηση ή να ΑΡΕΙ νομική δέσμευση — και ο cron θα έσβηνε
    //    αποδεικτικό συναίνεσης που ο νόμος (ΑΚ 250 · ν.4557/2018) απαιτεί να ζει.
    //
    // 📖 READ: ΚΑΝΕΝΑΣ. Η πρόσβαση στο αποδεικτικό κρίνεται στη διαδρομή του διακομιστή
    //    (`mandate-evidence-access.ts`: κριτής ΣΧΕΣΗΣ γραφείου–ακινήτου + ίχνος
    //    `document_accessed`)· ανάγνωση από τον πελάτη θα παρέκαμπτε και τα δύο.
    //
    // ⚠️ Ρητή άρνηση, όχι «καλύπτεται από το default-deny» — ίδιος λόγος με τα
    //    `cron_job_state` · `oauth_*` · `workspace_aliases` από πάνω.
    match /mandate_evidence/{evidenceId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

  }
}
