rules_version = '2';

// =============================================================================
// 🔒 ENTERPRISE FIREBASE STORAGE SECURITY RULES
// =============================================================================
//
// 🎯 ΣΤΡΑΤΗΓΙΚΗ: Least privilege - explicit allow per path pattern
// 🛡️ ΑΡΧΗ: Authentication required + path-based authorization
// 📋 ADR-031: Canonical File Storage System
//
// PATH SCHEME (IDs only, no Greek names):
// /companies/{companyId}/projects/{projectId}/entities/{entityType}/{entityId}/
//   domains/{domain}/categories/{category}/files/{fileId}.{ext}
//
// ⚠️ ΚΡΑΤΑ ΑΥΤΟ ΤΟ ΑΡΧΕΙΟ ΧΩΡΙΣ WARNINGS ΤΟΥ ΜΕΤΑΓΛΩΤΤΙΣΤΗ (π.χ. αχρησιμοποίητες
//    συναρτήσεις). Ο rules-runtime του Storage emulator επιστρέφει τα warnings ως ΕΝΑ
//    JSON μήνυμα στο stdout· το firebase-tools το κάνει `JSON.parse` **ανά chunk**
//    (`lib/emulator/storage/rules/runtime.js`). Στα Windows το pipe κόβει στα **8192
//    bytes**, οπότε απάντηση >8 KB σπάει, το handshake δεν ολοκληρώνεται ΠΟΤΕ και ο
//    emulator κρεμάει **χωρίς κανένα μήνυμα σφάλματος** — μαζί του κάθε storage-rules
//    suite (ADR-301). 25 warnings = ~25 KB. Μετρήθηκε 2026-07-26· βλ. ADR-301 §5.
//
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // 🔒 ENTERPRISE SECURITY - NO WILDCARD ALLOW-ALL
    // =========================================================================
    // All access must be granted through specific path rules below
    // Default: DENY (Firebase default behavior)

    // =========================================================================
    // 🔐 HELPER FUNCTIONS
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (by UID in path or metadata)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Get user's companyId from custom claims
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }

    // Check if user belongs to the specified company
    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserCompanyId() == companyId;
    }

    // Check if user is internal (has globalRole claim)
    function isInternalUser() {
      return isAuthenticated() &&
             request.auth.token.globalRole in ['super_admin', 'company_admin', 'internal_user'];
    }

    // Check if user is super_admin (system-wide access)
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.globalRole == 'super_admin';
    }

    // ADR-657 — authoring tier. Mirrors firestore isInternalUserOfCompany().
    // Only internal roles of the owning company (or super_admin) may touch
    // authoring geometry — external_user (the default self-registration role)
    // is fully denied, even with a valid companyId claim.
    function isInternalUserOfCompany(companyId) {
      return isSuperAdmin() || (isInternalUser() && belongsToCompany(companyId));
    }

    // Validate file size (max 50MB)
    function isValidFileSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // Validate allowed content types
    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/octet-stream' ||
             request.resource.contentType.matches('application/.*');
    }

    // =========================================================================
    // 🔐 FIRESTORE INTEGRATION HELPERS — ΑΦΑΙΡΕΘΗΚΑΝ 2026-07-26
    // =========================================================================
    // Εδώ ζούσαν 10 helpers (extractFileId, getFileRecordPath, hasPendingFileRecord,
    // fileRecordMatchesPathSimple/WithProject, storagePathEquals, hasFileRecordWithPath,
    // hasReadyFileRecord, isFileCreator) που έκαναν cross-service lookups στο Firestore.
    // Είχαν ήδη εγκαταλειφθεί ρητά για λόγους latency (βλ. τα NOTE στα blocks παρακάτω)
    // και ο μεταγλωττιστής τους ανέφερε ΟΛΟΥΣ ως «Unused function» — κανένα rule δεν τους
    // καλούσε. Τα warnings τους ήταν που κρεμούσαν τον emulator (βλ. προειδοποίηση στην
    // κορυφή του αρχείου). Ιστορικό: git + `storage.rules.enterprise`.

    // =========================================================================
    // 🏢 CANONICAL ENTERPRISE PATH (NEW UPLOADS)
    // =========================================================================
    // Path: /companies/{companyId}/projects/{projectId}/entities/{entityType}/{entityId}/
    //       domains/{domain}/categories/{category}/files/{fileId}.{ext}
    //
    // Authorization: User must belong to company OR be super_admin
    // =========================================================================

    // @pathId: canonical_with_project
    match /companies/{companyId}/projects/{projectId}/entities/{entityType}/{entityId}/domains/{domain}/categories/{category}/files/{fileName} {

      // 📖 READ: Company-scoped access with project isolation
      // 🏢 ENTERPRISE: Multi-tenant isolation by companyId + projectId
      // Security Model: Custom claims validation (companyId from auth token)
      // - Company members can read files from their company
      // - Super admins can read any file
      // NOTE: Removed Firestore lookups (isFileCreator, hasReadyFileRecord) due to
      // cross-service consistency issues causing permission failures (2026-01-20)
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());

      // ✍️ WRITE: Company-scoped + validation
      // 🏢 ENTERPRISE: Multi-tenant isolation via custom claims
      // Security Model:
      // 1. belongsToCompany() validates companyId custom claim matches path
      // 2. isSuperAdmin() allows system-wide access for admins
      // 3. File validation (size, content type)
      // NOTE: Removed Firestore lookups (hasPendingFileRecord, fileRecordMatchesPath,
      // storagePathEquals) due to unreliable cross-service consistency (2026-01-20)
      // Client-side validation in useFloorplanUpload.ts handles pre-flight checks
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && isValidFileSize()
                   && isAllowedContentType();

      // 🗑️ DELETE: Company-scoped access
      // 🏢 ENTERPRISE: Multi-tenant isolation
      // NOTE: Removed Firestore lookup (hasFileRecordWithPath) - client handles
      // FileRecord cleanup separately from Storage deletion
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🏢 SIMPLIFIED ENTERPRISE PATH (without project scope)
    // =========================================================================
    // Path: /companies/{companyId}/entities/{entityType}/{entityId}/
    //       domains/{domain}/categories/{category}/files/{fileId}.{ext}
    //
    // For files not associated with a specific project
    // =========================================================================

    // @pathId: canonical_no_project
    match /companies/{companyId}/entities/{entityType}/{entityId}/domains/{domain}/categories/{category}/files/{fileName} {

      // 📖 READ: Company-scoped access
      // 🏢 ENTERPRISE: Multi-tenant isolation by companyId
      // - Authenticated users can read files from their company
      // - Super admins can read any file
      // NOTE: Firestore-based isFileCreator() had latency issues during upload flow
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());

      // ✍️ WRITE: Company-scoped + size validation
      // 🏢 ENTERPRISE: Multi-tenant isolation
      allow write: if isAuthenticated()
                   && (belongsToCompany(companyId) || isSuperAdmin())
                   && isValidFileSize();

      // 🗑️ DELETE: Company-scoped access
      allow delete: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 📋 QUOTE ATTACHMENTS — ADR-327 §7 + §11 (vendor portal + scan uploads)
    // =========================================================================
    // Path: /companies/{companyId}/quotes/{quoteId}/{fileName}
    //
    // Writes: NONE through client SDK. All writes (vendor portal POST + AI scan
    // route) go through Admin SDK. Public read via Storage public-object ACL
    // (`fileRef.makePublic()`) so signed URLs are not required.
    // Reads: authenticated PMs in the owning company; super_admin globally.
    // =========================================================================

    // @pathId: quote_attachments
    match /companies/{companyId}/quotes/{quoteId}/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if false;
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🎬 BIM ANIMATION RENDERS — ADR-366 §C.1.c
    // =========================================================================
    // Path: /companies/{companyId}/bim_animations/{animationId}/renders/{fileName}
    //
    // Final MP4 outputs from the in-browser animation renderer. Written from
    // the client (no server route) so authenticated company members can upload
    // their own renders directly. Size capped at 500 MB to accommodate
    // 1080p H.264 animations up to ~10 minutes; tighter caps can land later
    // if storage growth becomes a concern.
    // =========================================================================

    // @pathId: bim_animation_renders
    match /companies/{companyId}/bim_animations/{animationId}/renders/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType in ['video/mp4', 'video/webm'];
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🌅 BIM CUSTOM HDRI ENVIRONMENTS — ADR-366 Group B
    // =========================================================================
    // Path: /companies/{companyId}/bim_environments/{fileName}
    //
    // User-uploaded .hdr (image/vnd.radiance) or .exr (application/octet-stream)
    // environment maps used by the 3D BIM viewer for image-based lighting.
    // Storage-only (no Firestore metadata) — single file per environment.
    // 50 MB cap covers 8K resolution HDRIs.
    // =========================================================================

    // @pathId: bim_environments
    match /companies/{companyId}/bim_environments/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType in ['image/vnd.radiance', 'application/octet-stream'];
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🎨 BIM MATERIAL APPEARANCE THUMBNAILS — ADR-413 §2D Phase 2
    // =========================================================================
    // Path: /companies/{companyId}/bim-material-thumbnails/{fileName}
    //
    // User-uploaded appearance image per material (Revit «Appearance asset →
    // image»), keyed by materialId. The download URL is persisted on the
    // bim_materials/{materialId} doc as `thumbnailUrl` and wins over the PBR
    // albedo swatch everywhere. Company-scoped (tenant isolation). 5 MB cap;
    // the client soft-caps at 2 MB.
    // =========================================================================

    // @pathId: bim_material_thumbnails
    match /companies/{companyId}/bim-material-thumbnails/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🖋️ ΣΦΡΑΓΙΔΑ / ΥΠΟΓΡΑΦΗ ΜΗΧΑΝΙΚΟΥ — ADR-651 Φάση Ε
    // =========================================================================
    // Path: /companies/{companyId}/engineer-stamps/{fileName}
    //
    // Η σφραγίδα/υπογραφή του μηχανικού (PNG/JPG/WebP), keyed by userId. Ανεβαίνει
    // ΜΙΑ φορά και μπαίνει αυτόματα στο κελί σφραγίδας κάθε πινακίδας σχεδίου
    // (οθόνη + PDF). Το download URL persist-άρεται στο `users/{userId}.stampImageUrl`.
    // Company-scoped (tenant isolation, mirror των BIM material thumbnails). 2 MB cap
    // — μια σφραγίδα είναι μικρή εικόνα· ο client εφαρμόζει το ίδιο όριο.
    // =========================================================================

    // @pathId: engineer_stamps
    match /companies/{companyId}/engineer-stamps/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 💬 ΣΥΝΗΜΜΕΝΑ ΣΧΟΛΙΩΝ BIM — ADR-366 Φ9/C.2
    // =========================================================================
    // Path: /companies/{companyId}/bim-comment-attachments/{commentId}/{fileName}
    //
    // Εικόνες (PNG/JPG) που επισυνάπτει ο μηχανικός σε σχόλιο/issue του 3D. Δύο
    // objects ανά συνημμένο: `{attachmentId}.{ext}` (πλήρες) + `{attachmentId}-thumb.jpg`
    // (μικρογραφία που δείχνει η λίστα). Τα download URLs ζουν στο πεδίο `attachments`
    // του `bim_comments/{commentId}`.
    //
    // ΓΙΑΤΙ ΤΟ `{commentId}` ΕΙΝΑΙ ΦΑΚΕΛΟΣ: ένα σχόλιο κρατά έως 5 συνημμένα, άρα ο
    // ιδιοκτήτης δεν χωράει στο basename. Αν έμπαινε εκεί, ο custody GC θα διάβαζε ως
    // κλειδί το attachmentId — ακριβώς το σφάλμα που γέννησε το ADR-694 (61 νόμιμα
    // αρχεία διαγραμμένα). Ο custody κανόνας `bim-comment-attachments` διαβάζει το
    // δεύτερο τμήμα του path.
    //
    // ΓΡΑΨΙΜΟ ΑΠΟ ΤΟΝ ΑΠΛΟ ΜΗΧΑΝΙΚΟ (όχι super-admin-only): το σχολιασμό τον κάνει
    // όποιος βλέπει το μοντέλο — ίδιο συμβόλαιο με τα imported-meshes, όχι με τους
    // curated καταλόγους. 5 MB cap, ίδιο με το όριο του client uploader.
    // =========================================================================

    // @pathId: bim_comment_attachments
    match /companies/{companyId}/bim-comment-attachments/{commentId}/{fileName} {

      // 📖 READ: μέλη της εταιρείας (η λίστα σχολίων φορτώνει τις μικρογραφίες)
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());

      // ✍️ WRITE: μέλη της εταιρείας + εικόνα ≤ 5 MB
      allow write: if isAuthenticated()
                   && (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpe?g)');

      // 🗑️ DELETE: μέλη της εταιρείας (αφαίρεση συνημμένου / διαγραφή σχολίου)
      allow delete: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🧱 BLOCK LIBRARY GEOMETRY BLOBS — ADR-652 M2
    // =========================================================================
    // Path: /companies/{companyId}/block-library/{fileName}
    //
    // Το «αρχείο» ενός αποθηκευμένου 2D block (BLOCK-LOCAL members ως JSON), keyed
    // by blockId (blklib_*). Το metadata + το geometryUrl ζουν στο Firestore doc
    // block_library/{blockId}. Company-scoped (tenant isolation, mirror των BIM
    // material thumbnails). 5 MB cap — ένα vector block είναι δεκάδες KB.
    // =========================================================================

    // @pathId: block_library
    match /companies/{companyId}/block-library/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'application/json';
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🧱📚 SYSTEM / PARTNER BLOCK LIBRARY — ADR-652 M3
    // =========================================================================
    // Path: /system/block-library/{fileName}
    //
    // Η ΕΤΟΙΜΗ βιβλιοθήκη (`scope:'system'`, `builtin:true`): ΔΕΝ ανήκει σε καμία
    // εταιρεία — τη διαβάζουν ΟΛΟΙ οι πελάτες (mirror του Firestore read rule
    // `resource.data.scope == 'system'`). Γράφεται ΜΟΝΟ από το seed (Admin SDK, που
    // παρακάμπτει τους κανόνες) — από client, ποτέ: read-only content.
    // =========================================================================

    // @pathId: system_block_library
    match /system/block-library/{fileName} {
      allow read: if isAuthenticated();
      allow write, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 🎨 BIM MATERIAL 3D PBR TEXTURES — ADR-413 §2D Phase 3
    // =========================================================================
    // Path: /companies/{companyId}/bim-material-textures/{materialId}/{fileName}
    //
    // User-uploaded PBR texture maps (albedo/normal/roughness/ao — Revit
    // «Appearance asset → Image» per-map slots), keyed by materialId + sub-keyed
    // by map. The download URLs are persisted on the bim_materials/{materialId}
    // doc as pbrTextures.<map>Url and RENDER on walls in the 3D viewport (not just
    // a 2D thumbnail). Company-scoped (tenant isolation). 10 MB cap per map; the
    // client soft-caps at 8 MB.
    // =========================================================================

    // @pathId: bim_material_textures
    match /companies/{companyId}/bim-material-textures/{materialId}/{fileName} {
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
      allow write: if (belongsToCompany(companyId) || isSuperAdmin())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // ⛰️ TOPOGRAPHIC SURVEY BLOBS — ADR-650
    // =========================================================================
    // Path: /topo-surfaces/{companyId}/{scope}/{docId}.json
    //
    // Ο ΟΡΙΣΜΟΣ μιας τοπογραφικής επιφάνειας όταν το payload (point cloud) ξεπερνά
    // το όριο του Firestore doc (1MB) → offload σε JSON blob (mirror του DXF scene
    // blob). Το metadata + το `pointsStoragePath` ζουν στο Firestore
    // floorplan_topo_surfaces doc. Company-scoped (tenant isolation). 100 MB cap —
    // ένα decimated survey/cloud είναι έως δεκάδες MB.
    //
    // 🔐 ADR-657 — AUTHORING TIER: όλα τα σκέλη (read/write/delete) απαιτούν
    // isInternalUserOfCompany(companyId). Η τοπογραφική επιφάνεια είναι authoring
    // geometry — διαβάζεται/γράφεται ΜΟΝΟ μέσα στο /dxf/viewer (AdminGuard). Ο
    // external_user (default self-registration role) απαγορεύεται πλήρως.
    // =========================================================================
    // @pathId: topo_surfaces
    match /topo-surfaces/{companyId}/{topoFile=**} {
      allow read: if isInternalUserOfCompany(companyId);
      allow write: if isInternalUserOfCompany(companyId)
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType == 'application/json';
      allow delete: if isInternalUserOfCompany(companyId);
    }

    // =========================================================================
    // 🎨 CAD FILES (DXF/Technical Drawings)
    // =========================================================================
    // Path: /cad/{userId}/{fileId}/{filename}
    // Ownership-based access for CAD files
    // =========================================================================

    // @pathId: cad
    match /cad/{userId}/{fileId}/{fileName} {

      // 📖 READ: Owner or super_admin
      allow read: if isOwner(userId) || isSuperAdmin();

      // ✍️ WRITE: Owner only
      allow write: if isOwner(userId)
                   && isValidFileSize();

      // 🗑️ DELETE: Owner or super_admin
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // =========================================================================
    // 📄 TEMPORARY UPLOADS (for processing)
    // =========================================================================
    // Path: /temp/{userId}/{filename}
    // Short-lived uploads that will be moved to canonical path
    // =========================================================================

    // @pathId: temp
    match /temp/{userId}/{fileName} {

      // Only owner can access their temp files.
      //
      // 🐛 ΔΙΟΡΘΩΣΗ 2026-07-26: ήταν `allow read, write: isOwner() && isValidFileSize()`.
      // Στο READ το `request.resource` είναι **null**, άρα το `isValidFileSize()`
      // (`request.resource.size < 50MB`) απέτυχε πάντα ⇒ **ο ιδιοκτήτης δεν μπορούσε
      // να διαβάσει τα δικά του temp αρχεία**. Το payload gate ανήκει μόνο στο write —
      // όπως ήδη γίνεται σε κάθε άλλο block αυτού του αρχείου. Βρέθηκε την πρώτη φορά
      // που έτρεξε πραγματικά το storage-rules suite (ADR-301 §4).
      allow read: if isOwner(userId);

      allow write: if isOwner(userId)
                   && isValidFileSize();

      allow delete: if isOwner(userId);
    }

    // =========================================================================
    // 🪑 FURNITURE LIBRARY (ADR-410 — CC0 mesh content library)
    // =========================================================================
    // Path: /furniture-library/{assetId}.glb
    // Shared, read-only content library (like a Revit content server): every
    // authenticated user may READ the CC0 meshes; only super_admin may curate
    // (write/delete). The meshes are CC0 (Poly Haven) enriched with our own BIM
    // metadata (ADR-409 §D.1) → safe to host + redistribute in-app.
    // =========================================================================

    // Recursive (`=**`) so it also covers `furniture-library/thumbnails/<id>.png`
    // (ADR-410 picker previews), not just the top-level `.glb` meshes.
    // LEGACY path — superseded by the unified `bim-mesh-library/` tree (ADR-411);
    // kept so any pre-migration furniture asset URL still resolves.
    // @pathId: furniture_library
    match /furniture-library/{assetFile=**} {

      // 📖 READ: any authenticated user (shared catalog)
      allow read: if isAuthenticated();

      // ✍️ WRITE / 🗑️ DELETE: super_admin only (library curation)
      allow write: if isSuperAdmin() && isValidFileSize();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 🗂️ BIM MESH LIBRARY (ADR-411 — entity-agnostic CC0 mesh content library)
    // =========================================================================
    // Path: /bim-mesh-library/<bimCategory>/{assetId}.glb (+ thumbnails/<id>.png)
    // Unified, hierarchical content library (like a Revit content server) shared
    // by every mesh-based BIM entity (furniture, light-fixture, …). The meshes are
    // CC0 (Poly Haven) enriched with our own BIM metadata (ADR-409 §D.1) → safe to
    // host + redistribute in-app. Recursive (`=**`) so it covers every category +
    // its `thumbnails/` subfolder.
    // =========================================================================
    // @pathId: bim_mesh_library
    match /bim-mesh-library/{assetFile=**} {

      // 📖 READ: any authenticated user (shared catalog)
      allow read: if isAuthenticated();

      // ✍️ WRITE / 🗑️ DELETE: super_admin only (library curation)
      allow write: if isSuperAdmin() && isValidFileSize();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 🗂️ IMPORTED MESHES (ADR-683 Φ3 — γεωμετρία που γύρισε ο συνεργάτης)
    // =========================================================================
    // Path: /companies/{companyId}/projects/{projectId}/imported-meshes/{fileName}
    //
    // ΓΙΑΤΙ ΞΕΧΩΡΙΣΤΟ ΔΕΝΤΡΟ (και όχι bim-mesh-library/): το `bim-mesh-library` είναι
    // **curated κατάλογος περιεχομένου** — κοινός σε όλη την εταιρεία, write μόνο από
    // super_admin. Τα εισαγόμενα πλέγματα είναι το ΑΝΤΙΘΕΤΟ: ανεβαίνουν από τον απλό
    // χρήστη, ανήκουν σε ΕΝΑ έργο, και δεν πρέπει να εμφανίζονται σε picker άλλου έργου.
    // Ίδια rules θα σήμαινε είτε να δώσουμε write στη βιβλιοθήκη (κακό), είτε να μην
    // μπορεί ο χρήστης να εισάγει (άχρηστο).
    //
    // Ένα αρχείο ανά εισαγωγή (Revit linked-model): πολλά `imported-mesh` entities
    // δείχνουν στο ΙΔΙΟ `.glb` μέσω `<uploadId>#<nodeName>`.
    // =========================================================================
    // @pathId: imported_meshes
    match /companies/{companyId}/projects/{projectId}/imported-meshes/{fileName} {

      // 📖 READ: μέλη της εταιρείας (το πλέγμα φορτώνεται σε κάθε άνοιγμα του έργου)
      allow read: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());

      // ✍️ WRITE: μέλη της εταιρείας + έλεγχος μεγέθους. ΟΧΙ super-admin-only —
      // η εισαγωγή είναι καθημερινή ενέργεια του μηχανικού, όχι διαχείριση καταλόγου.
      // (Ο super_admin περνά επίσης, όπως σε ΚΑΘΕ company-scoped path εδώ — το
      // «όχι super-admin-only» αφορά το να ΜΗΝ αποκλείεται ο μηχανικός, ADR-301 §3.3.)
      allow write: if isAuthenticated()
                   && (belongsToCompany(companyId) || isSuperAdmin())
                   && isValidFileSize();

      // 🗑️ DELETE: μέλη της εταιρείας (καθαρισμός εισαγωγών που δεν χρειάζονται πια)
      allow delete: if isAuthenticated() && (belongsToCompany(companyId) || isSuperAdmin());
    }

    // =========================================================================
    // 🗂️ BIM TEXTURE LIBRARY (ADR-413 — CC0 PBR texture content library)
    // =========================================================================
    // Path: /bim-texture-library/<slug>/<map>.jpg (albedo/normal/roughness/ao)
    // Shared, read-only content library (like a Revit material/appearance asset
    // library) of CC0 (Poly Haven) PBR texture sets, used by the 3D realistic
    // material catalog. Recursive (`=**`) so it covers every slug folder + maps.
    // =========================================================================
    // @pathId: bim_texture_library
    match /bim-texture-library/{assetFile=**} {

      // 📖 READ: any authenticated user (shared catalog)
      allow read: if isAuthenticated();

      // ✍️ WRITE / 🗑️ DELETE: super_admin only (library curation)
      allow write: if isSuperAdmin() && isValidFileSize();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 🔒 ASSET PACKS (ADR-655 — gated content libraries)
    // =========================================================================
    // Path: /asset-packs/<packId>/<version>/<assetId>.webp
    //
    // ⚠️ ΔΙΑΦΕΡΕΙ ΘΕΜΕΛΙΩΔΩΣ από τις παραπάνω βιβλιοθήκες: αυτές είναι CC0/δωρεάν και τις
    // διαβάζει κάθε συνδεδεμένος. Τα asset packs είναι **αδειοδοτημένο περιεχόμενο** που
    // διανέμεται υπό όρους (per-company entitlement + RBAC + kill switch).
    //
    // Γι' αυτό: ΚΑΝΕΝΑΣ client δεν διαβάζει απευθείας — ούτε με το σωστό URL, ούτε
    // συνδεδεμένος. Η ΜΟΝΗ ανάγνωση γίνεται server-side με Admin SDK (που παρακάμπτει τους
    // rules) μέσα από το /api/asset-packs proxy, ΑΦΟΥ περάσει η πύλη εξουσιοδότησης.
    // Ίδιο δοκιμασμένο μοτίβο με το `companies/{companyId}/quotes/` (allow write: if false).
    // =========================================================================
    // @pathId: asset_packs
    match /asset-packs/{assetFile=**} {

      // 📖 READ: ΚΑΝΕΙΣ. Μόνο ο authenticated proxy (Admin SDK).
      allow read: if false;

      // ✍️ WRITE / 🗑️ DELETE: super_admin only (curation via upload script)
      allow write: if isSuperAdmin() && isValidFileSize();
      allow delete: if isSuperAdmin();
    }

  }
}
